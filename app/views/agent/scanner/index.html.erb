<% content_for(:title, "QR Scanner - CleanCircle Agent") %>

<div class="mb-5">
  <h1 class="text-xl font-bold text-gray-900">QR Scanner</h1>
  <p class="text-sm text-gray-500 mt-1">Scan or enter a household QR code to verify pickup</p>
</div>

<%# Camera scanner section - primary %>
<div class="bg-white rounded-xl shadow-sm border border-gray-200 mb-5 overflow-hidden">
  <div class="px-4 py-3 border-b border-gray-200">
    <h2 class="text-base font-semibold text-gray-900 flex items-center">
      <svg class="w-5 h-5 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      Camera Scanner
    </h2>
  </div>

  <%# Camera preview area %>
  <div data-controller="qr-scanner" class="relative">
    <div id="qr-camera-preview" data-qr-scanner-target="preview"
      class="bg-gray-900 flex items-center justify-center" style="min-height: 280px;">
      <div data-qr-scanner-target="placeholder" class="text-center py-12">
        <svg class="w-16 h-16 mx-auto text-gray-500 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"/></svg>
        <p class="text-sm text-gray-400">Camera preview will appear here</p>
      </div>
      <video data-qr-scanner-target="video" class="hidden w-full h-full object-cover" autoplay playsinline></video>
    </div>

    <%# Open Camera button %>
    <div class="p-4">
      <button type="button"
        data-action="qr-scanner#startCamera"
        data-qr-scanner-target="startButton"
        class="w-full bg-blue-600 hover:bg-blue-700 text-white text-lg font-semibold py-4 rounded-xl shadow-sm transition flex items-center justify-center">
        <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        Open Camera
      </button>
      <button type="button"
        data-action="qr-scanner#stopCamera"
        data-qr-scanner-target="stopButton"
        class="hidden w-full bg-gray-600 hover:bg-gray-700 text-white text-lg font-semibold py-4 rounded-xl shadow-sm transition flex items-center justify-center">
        <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 10a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"/></svg>
        Stop Camera
      </button>
    </div>

    <%# Scan result action buttons (shown after successful scan) %>
    <div data-qr-scanner-target="scanResult" class="hidden border-t border-gray-200 p-4">
      <div class="bg-green-50 border border-green-200 rounded-xl p-4 mb-4">
        <div class="flex items-center mb-2">
          <svg class="w-5 h-5 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span class="text-sm font-semibold text-green-800">QR Code Verified</span>
        </div>
        <p data-qr-scanner-target="scanAddress" class="text-sm text-gray-700"></p>
        <p data-qr-scanner-target="scanCustomer" class="text-xs text-gray-500 mt-0.5"></p>
      </div>
      <div class="space-y-3">
        <a data-qr-scanner-target="confirmLink" href="#"
          class="w-full bg-green-600 hover:bg-green-700 text-white text-lg font-semibold py-4 rounded-xl shadow-sm transition flex items-center justify-center">
          <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          Confirm Pickup
        </a>
        <a data-qr-scanner-target="missedLink" href="#"
          class="w-full bg-red-600 hover:bg-red-700 text-white text-lg font-semibold py-4 rounded-xl shadow-sm transition flex items-center justify-center">
          <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          Mark Missed
        </a>
      </div>
    </div>
  </div>
</div>

<%# Manual QR code entry - secondary %>
<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 mb-5">
  <div class="mb-3">
    <h3 class="text-sm font-semibold text-gray-700 flex items-center">
      <svg class="w-4 h-4 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
      Manual Entry
    </h3>
    <p class="text-xs text-gray-400 mt-0.5">Enter the QR code manually if camera is unavailable</p>
  </div>
  <%= form_tag agent_scan_verify_path, method: :post, class: "space-y-3" do %>
    <div>
      <label for="qr_code" class="block text-sm font-medium text-gray-700 mb-1">QR Code</label>
      <input type="text" name="qr_code" id="qr_code" value="<%= params[:qr_code] %>"
        placeholder="Enter QR code (e.g. HH-A1B2C3D4)..."
        class="block w-full rounded-lg border border-gray-300 px-3 py-3 text-base text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
    </div>
    <button type="submit"
      class="w-full bg-blue-600 hover:bg-blue-700 text-white text-base font-medium py-3.5 rounded-xl shadow-sm transition flex items-center justify-center">
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      Verify Code
    </button>
  <% end %>
</div>

<%# Result area %>
<% if @household.present? %>
  <div class="bg-white rounded-xl shadow-sm border border-blue-200 overflow-hidden">
    <div class="bg-blue-50 px-4 py-3 border-b border-blue-200">
      <h2 class="text-sm font-semibold text-blue-800 flex items-center">
        <svg class="w-5 h-5 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Household Found
      </h2>
    </div>
    <div class="px-4 py-3 space-y-3">
      <div>
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Address</p>
        <p class="text-sm text-gray-900 mt-0.5"><%= @household.address %></p>
      </div>
      <% if @household.building_name.present? %>
        <div>
          <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Building</p>
          <p class="text-sm text-gray-900 mt-0.5"><%= @household.building_name %></p>
        </div>
      <% end %>
      <% if @household.unit_number.present? %>
        <div>
          <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Unit</p>
          <p class="text-sm text-gray-900 mt-0.5"><%= @household.unit_number %></p>
        </div>
      <% end %>

      <%# Today's pickup status with action buttons %>
      <% today_pickup = @household.pickups.find_by(created_at: Date.current.all_day) %>
      <% if today_pickup %>
        <div class="pt-2 border-t border-gray-100">
          <p class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-2">Today's Pickup</p>
          <div class="flex items-center justify-between mb-3">
            <% case today_pickup.status %>
            <% when "scheduled" %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">Scheduled</span>
            <% when "in_progress" %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">In Progress</span>
            <% when "completed" %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Completed</span>
            <% when "missed" %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Missed</span>
            <% end %>
            <%= link_to "View Pickup", agent_pickup_path(today_pickup),
              class: "text-sm text-blue-600 hover:text-blue-800 font-medium" %>
          </div>

          <%# Action buttons for pending pickups %>
          <% unless today_pickup.status.in?(["completed", "missed"]) %>
            <div class="space-y-2">
              <%= button_to confirm_agent_pickup_path(today_pickup),
                method: :patch,
                class: "w-full bg-green-600 hover:bg-green-700 text-white text-lg font-semibold py-4 rounded-xl shadow-sm transition flex items-center justify-center",
                data: { turbo_confirm: "Confirm this pickup as completed?" } do %>
                <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Confirm Pickup
              <% end %>
              <%= button_to mark_missed_agent_pickup_path(today_pickup),
                method: :patch,
                class: "w-full bg-red-600 hover:bg-red-700 text-white text-lg font-semibold py-4 rounded-xl shadow-sm transition flex items-center justify-center",
                data: { turbo_confirm: "Mark this pickup as missed?" } do %>
                <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                Mark Missed
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="pt-2 border-t border-gray-100">
          <p class="text-xs text-gray-400">No pickup scheduled for today.</p>
        </div>
      <% end %>
    </div>
  </div>
<% elsif params[:qr_code].present? %>
  <div class="bg-white rounded-xl shadow-sm border border-red-200 overflow-hidden">
    <div class="bg-red-50 px-4 py-3 border-b border-red-200">
      <h2 class="text-sm font-semibold text-red-800 flex items-center">
        <svg class="w-5 h-5 mr-2 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Not Found
      </h2>
    </div>
    <div class="px-4 py-4 text-center">
      <p class="text-sm text-gray-500">No household found for code "<%= params[:qr_code] %>".</p>
      <p class="text-xs text-gray-400 mt-1">Please check the code and try again.</p>
    </div>
  </div>
<% end %>
