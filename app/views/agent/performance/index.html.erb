<% content_for(:title, "Performance - CleanCircle Agent") %>

<div class="mb-5">
  <h1 class="text-xl font-bold text-gray-900">My Performance</h1>
  <p class="text-sm text-gray-500 mt-1"><%= Date.current.strftime("%A, %B %d, %Y") %></p>
</div>

<%# Stats Cards %>
<div class="grid grid-cols-2 gap-3 sm:grid-cols-4 mb-6">
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
    <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Today's Rate</p>
    <p class="text-2xl font-bold mt-1 <%= @today_stats[:completion_rate] == 100 ? 'text-green-600' : @today_stats[:completion_rate] >= 80 ? 'text-blue-700' : @today_stats[:completion_rate] >= 50 ? 'text-yellow-600' : 'text-red-600' %>">
      <%= @today_stats[:completion_rate] %>%
    </p>
    <p class="text-xs text-gray-400 mt-0.5"><%= @today_stats[:completed] %>/<%= @today_stats[:total] %> done</p>
  </div>
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
    <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Weekly Completed</p>
    <p class="text-2xl font-bold text-blue-700 mt-1"><%= @weekly_stats[:completed] %></p>
    <p class="text-xs text-gray-400 mt-0.5">of <%= @weekly_stats[:total] %> total</p>
  </div>
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
    <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Monthly Total</p>
    <p class="text-2xl font-bold text-blue-700 mt-1"><%= @monthly_stats[:completed] %></p>
    <p class="text-xs text-gray-400 mt-0.5"><%= @avg_pickups_per_day %>/day avg</p>
  </div>
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
    <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Current Streak</p>
    <p class="text-2xl font-bold mt-1 <%= @streak >= 3 ? 'text-green-600' : 'text-blue-700' %>"><%= @streak %></p>
    <p class="text-xs text-gray-400 mt-0.5">perfect day<%= @streak == 1 ? '' : 's' %></p>
  </div>
</div>

<%# Performance Tips %>
<% if @tips.any? %>
  <div class="space-y-2 mb-6">
    <% @tips.each do |tip| %>
      <% case tip[:type] %>
      <% when :success %>
        <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg text-sm flex items-start">
          <svg class="w-5 h-5 mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span><%= tip[:message] %></span>
        </div>
      <% when :warning %>
        <div class="bg-yellow-50 border border-yellow-200 text-yellow-700 px-4 py-3 rounded-lg text-sm flex items-start">
          <svg class="w-5 h-5 mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
          <span><%= tip[:message] %></span>
        </div>
      <% when :info %>
        <div class="bg-blue-50 border border-blue-200 text-blue-700 px-4 py-3 rounded-lg text-sm flex items-start">
          <svg class="w-5 h-5 mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span><%= tip[:message] %></span>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>

<%# 7-Day History Chart %>
<div class="bg-white rounded-xl shadow-sm border border-gray-200 mb-4">
  <div class="px-4 py-3 border-b border-gray-200">
    <h2 class="text-base font-semibold text-gray-900">7-Day Pickup History</h2>
  </div>
  <div class="p-4">
    <%= bar_chart [
      { name: "Completed", data: @chart_completed, color: "#16a34a" },
      { name: "Missed", data: @chart_missed, color: "#dc2626" }
    ], stacked: true, library: { scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } } } %>
  </div>
</div>

<%# Route Performance Table %>
<div class="bg-white rounded-xl shadow-sm border border-gray-200 mb-4">
  <div class="px-4 py-3 border-b border-gray-200">
    <h2 class="text-base font-semibold text-gray-900">Route Performance</h2>
  </div>

  <% if @route_performance.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">Route</th>
            <th class="px-4 py-2.5 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">Area</th>
            <th class="px-4 py-2.5 text-right text-xs font-medium text-gray-500 uppercase tracking-wide">Total</th>
            <th class="px-4 py-2.5 text-right text-xs font-medium text-gray-500 uppercase tracking-wide">Completed</th>
            <th class="px-4 py-2.5 text-right text-xs font-medium text-gray-500 uppercase tracking-wide">Missed</th>
            <th class="px-4 py-2.5 text-right text-xs font-medium text-gray-500 uppercase tracking-wide">Rate</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-100">
          <% @route_performance.each do |rp| %>
            <tr>
              <td class="px-4 py-2.5 text-sm font-medium text-gray-900 whitespace-nowrap"><%= rp[:name] %></td>
              <td class="px-4 py-2.5 text-sm text-gray-500 whitespace-nowrap"><%= rp[:area] %></td>
              <td class="px-4 py-2.5 text-sm text-gray-700 text-right"><%= rp[:total] %></td>
              <td class="px-4 py-2.5 text-sm text-green-600 font-medium text-right"><%= rp[:completed] %></td>
              <td class="px-4 py-2.5 text-sm text-red-600 font-medium text-right"><%= rp[:missed] %></td>
              <td class="px-4 py-2.5 text-right whitespace-nowrap">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= rp[:completion_rate] == 100 ? 'bg-green-100 text-green-800' : rp[:completion_rate] >= 80 ? 'bg-blue-100 text-blue-800' : rp[:completion_rate] >= 50 ? 'bg-yellow-100 text-yellow-800' : 'bg-red-100 text-red-800' %>">
                  <%= rp[:completion_rate] %>%
                </span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="px-4 py-8 text-center text-sm text-gray-400">
      No route performance data available.
    </div>
  <% end %>
</div>
