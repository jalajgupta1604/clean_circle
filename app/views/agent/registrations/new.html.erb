<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full">
    <div class="text-center mb-8">
      <div class="inline-flex items-center gap-2 mb-4">
        <div class="w-10 h-10 bg-blue-600 rounded-xl flex items-center justify-center">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </div>
        <span class="text-2xl font-bold text-gray-900">CleanCircle</span>
      </div>
      <h1 class="text-2xl font-bold text-gray-900">Agent Registration</h1>
      <p class="mt-2 text-gray-500">Register as a waste collection agent</p>
    </div>

    <div class="bg-white rounded-2xl border border-gray-200 shadow-lg p-8">
      <%= form_with(model: @user, url: agent_registration_path, class: "space-y-5") do |f| %>
        <% if @user.errors.any? %>
          <div class="bg-red-50 border border-red-200 rounded-xl p-4">
            <ul class="text-sm text-red-700 space-y-1">
              <% @user.errors.full_messages.each do |message| %>
                <li class="flex items-start">
                  <svg class="w-4 h-4 text-red-400 mt-0.5 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>
                  <%= message %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
          <%= f.text_field :name, autofocus: true, required: true, placeholder: "Your full name", class: "block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-gray-900 placeholder-gray-400 sm:text-sm py-3" %>
        </div>

        <div>
          <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
          <%= f.email_field :email, required: true, autocomplete: "email", placeholder: "you@example.com", class: "block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-gray-900 placeholder-gray-400 sm:text-sm py-3" %>
        </div>

        <div>
          <%= f.label :phone, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
          <%= f.telephone_field :phone, required: true, placeholder: "+91 98765 43210", class: "block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-gray-900 placeholder-gray-400 sm:text-sm py-3" %>
        </div>

        <div>
          <%= f.label :address, "Area / City", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
          <%= f.text_field :address, placeholder: "e.g. Koramangala, Bangalore", class: "block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-gray-900 placeholder-gray-400 sm:text-sm py-3" %>
        </div>

        <div>
          <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
          <%= f.password_field :password, required: true, autocomplete: "new-password", placeholder: "At least 6 characters", class: "block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-gray-900 placeholder-gray-400 sm:text-sm py-3" %>
        </div>

        <div>
          <%= f.label :password_confirmation, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
          <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Confirm your password", class: "block w-full rounded-xl border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-gray-900 placeholder-gray-400 sm:text-sm py-3" %>
        </div>

        <div>
          <%= f.submit "Register as Agent", class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-xl shadow-sm text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors cursor-pointer" %>
        </div>
      <% end %>

      <p class="mt-6 text-center text-sm text-gray-500">
        Already have an account?
        <%= link_to "Sign in", new_user_session_path, class: "font-semibold text-blue-600 hover:text-blue-700" %>
      </p>
      <p class="mt-2 text-center text-sm text-gray-500">
        Customer?
        <%= link_to "Register as customer", new_user_registration_path, class: "font-semibold text-emerald-600 hover:text-emerald-700" %>
      </p>
    </div>
  </div>
</div>
