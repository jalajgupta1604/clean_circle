<% content_for(:title, "My Routes - CleanCircle Agent") %>

<div class="mb-5">
  <h1 class="text-xl font-bold text-gray-900">My Routes</h1>
  <p class="text-sm text-gray-500 mt-1"><%= @routes.size %> route<%= @routes.size == 1 ? '' : 's' %> assigned</p>
</div>

<% if @routes.any? %>
  <div class="space-y-3">
    <% @routes.each do |route| %>
      <%= link_to agent_route_path(route), class: "block bg-white rounded-xl shadow-sm border border-gray-200 p-4 hover:border-blue-300 hover:shadow transition" do %>
        <div class="flex items-start justify-between">
          <div class="min-w-0 flex-1">
            <h2 class="text-base font-semibold text-gray-900 truncate"><%= route.name %></h2>
            <p class="text-sm text-gray-500 mt-0.5"><%= route.area %></p>
          </div>
          <span class="ml-3 inline-flex items-center bg-blue-50 text-blue-700 text-xs font-medium px-2.5 py-1 rounded-full">
            <%= route.households.count %> households
          </span>
        </div>

        <div class="mt-3 flex items-center text-xs text-gray-400 space-x-4">
          <span class="flex items-center">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <%= route.area %>
          </span>
          <span class="flex items-center">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0h4"/></svg>
            <%= route.households.count %> households
          </span>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 px-4 py-12 text-center">
    <svg class="mx-auto w-12 h-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>
    <p class="mt-3 text-sm text-gray-500">No routes assigned to you yet.</p>
  </div>
<% end %>
