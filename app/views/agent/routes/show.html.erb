<% content_for(:title, "#{@route.name} - CleanCircle Agent") %>

<% content_for :head do %>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <style>.custom-marker { background: transparent !important; border: none !important; }</style>
<% end %>

<div class="mb-5">
  <div class="flex items-center text-sm text-gray-500 mb-2">
    <%= link_to "My Routes", agent_routes_path, class: "text-blue-600 hover:text-blue-800" %>
    <svg class="w-4 h-4 mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    <span class="text-gray-700"><%= @route.name %></span>
  </div>
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-xl font-bold text-gray-900"><%= @route.name %></h1>
      <p class="text-sm text-gray-500 mt-0.5"><%= @route.area %></p>
    </div>
    <%= link_to "Start Pickups", agent_route_pickups_path(@route),
      class: "inline-flex items-center bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2.5 rounded-lg shadow-sm transition" %>
  </div>
</div>

<%# Route Map %>
<div class="bg-white rounded-xl shadow-sm border border-gray-200 mb-4">
  <div class="px-4 py-3 border-b border-gray-200 flex items-center justify-between">
    <h2 class="text-base font-semibold text-gray-900">Route Map</h2>
    <div class="flex items-center space-x-3 text-xs">
      <span class="flex items-center"><span class="inline-block w-3 h-3 rounded-full bg-green-600 mr-1"></span>Completed</span>
      <span class="flex items-center"><span class="inline-block w-3 h-3 rounded-full bg-blue-600 mr-1"></span>Scheduled</span>
      <span class="flex items-center"><span class="inline-block w-3 h-3 rounded-full bg-red-600 mr-1"></span>Missed</span>
      <span class="flex items-center"><span class="inline-block w-3 h-3 rounded-full bg-gray-400 mr-1"></span>No Pickup</span>
    </div>
  </div>
  <div
    data-controller="route-map"
    data-route-map-households-value="<%= @household_map_data.to_json %>"
    style="height: 350px; z-index: 0;"
    class="rounded-b-xl"
  ></div>
</div>

<%# Households list %>
<div class="bg-white rounded-xl shadow-sm border border-gray-200">
  <div class="px-4 py-3 border-b border-gray-200">
    <h2 class="text-base font-semibold text-gray-900">Households (<%= @households.size %>)</h2>
  </div>

  <% if @households.any? %>
    <ul class="divide-y divide-gray-100">
      <% @households.each do |household| %>
        <li class="px-4 py-3">
          <div class="flex items-center justify-between">
            <div class="min-w-0 flex-1">
              <p class="text-sm font-medium text-gray-900 truncate"><%= household.address %></p>
              <p class="text-xs text-gray-500 mt-0.5">
                <% if household.building_name.present? %>
                  <%= household.building_name %>
                <% end %>
                <% if household.unit_number.present? %>
                  <span class="<%= household.building_name.present? ? '' : '' %>">Unit <%= household.unit_number %></span>
                <% end %>
              </p>
            </div>
            <div class="ml-3 flex-shrink-0">
              <% today_pickup = household.pickups.find_by(created_at: Date.current.all_day) %>
              <% if today_pickup %>
                <% case today_pickup.status %>
                <% when "scheduled" %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">Scheduled</span>
                <% when "in_progress" %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">In Progress</span>
                <% when "completed" %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Completed</span>
                <% when "missed" %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Missed</span>
                <% end %>
              <% else %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-500">No Pickup</span>
              <% end %>
            </div>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="px-4 py-8 text-center text-sm text-gray-400">
      No households on this route.
    </div>
  <% end %>
</div>
