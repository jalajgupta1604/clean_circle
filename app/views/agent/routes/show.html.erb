<% content_for(:title, "#{@route.name} - CleanCircle Agent") %>

<% content_for :head do %>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  <style>
    .custom-marker { background: transparent !important; border: none !important; }
    .marker-fill { font-variation-settings: 'FILL' 1; }
  </style>
<% end %>

<% all_today = @households.map { |h| h.pickups.find_by(created_at: Date.current.all_day) }.compact %>
<% completed_count = all_today.count { |p| p.status == "completed" } %>
<% remaining_count = all_today.count { |p| p.status.in?(%w[scheduled in_progress]) } %>
<% total_count = all_today.size %>
<% next_household = @households.detect { |h| p = h.pickups.find_by(created_at: Date.current.all_day); p && p.status.in?(%w[scheduled in_progress]) } %>
<% next_pickup = next_household ? next_household.pickups.find_by(created_at: Date.current.all_day) : nil %>

<%# Header - overlaid style matching Stitch design %>
<header class="flex items-center justify-between bg-white/80 backdrop-blur-md p-4 border-b border-slate-200 z-10">
  <div class="flex items-center gap-3">
    <%= link_to agent_routes_path, class: "text-slate-900 flex size-10 items-center justify-center rounded-full hover:bg-slate-100 cursor-pointer" do %>
      <span class="material-symbols-outlined">arrow_back</span>
    <% end %>
    <div>
      <h1 class="text-lg font-bold leading-tight">Today's Route</h1>
      <p class="text-xs text-slate-500"><%= total_count %> stops &bull; <%= @route.area %></p>
    </div>
  </div>
  <div class="flex gap-2">
    <button class="flex size-10 items-center justify-center rounded-full bg-slate-100 text-slate-700">
      <span class="material-symbols-outlined">search</span>
    </button>
    <button class="flex size-10 items-center justify-center rounded-full bg-slate-100 text-slate-700">
      <span class="material-symbols-outlined">more_vert</span>
    </button>
  </div>
</header>

<%# Main Map Area %>
<main class="relative flex-1 bg-slate-200 overflow-hidden" style="min-height: 60vh;">
  <%# Map container %>
  <div
    data-controller="route-map"
    data-route-map-households-value="<%= @household_map_data.to_json %>"
    class="absolute inset-0"
    style="z-index: 0;"
  ></div>

  <%# Floating Controls Top Right %>
  <div class="absolute top-4 right-4 flex flex-col gap-2" style="z-index: 5;">
    <button class="size-12 flex items-center justify-center rounded-xl bg-white shadow-xl text-slate-700">
      <span class="material-symbols-outlined">layers</span>
    </button>
    <div class="flex flex-col rounded-xl bg-white shadow-xl overflow-hidden">
      <button class="size-12 flex items-center justify-center border-b border-slate-100 text-slate-700">
        <span class="material-symbols-outlined">add</span>
      </button>
      <button class="size-12 flex items-center justify-center text-slate-700">
        <span class="material-symbols-outlined">remove</span>
      </button>
    </div>
    <button class="size-12 flex items-center justify-center rounded-xl bg-[#ec5b13] shadow-xl text-white">
      <span class="material-symbols-outlined marker-fill">my_location</span>
    </button>
  </div>

  <%# Category Pills - Top Left %>
  <div class="absolute top-4 left-4 flex gap-2 overflow-x-auto max-w-[calc(100%-80px)]" style="z-index: 5; -ms-overflow-style: none; scrollbar-width: none;">
    <div class="flex h-10 shrink-0 items-center justify-center gap-x-2 rounded-full bg-[#ec5b13] px-4 shadow-lg text-white">
      <span class="material-symbols-outlined text-xl">priority_high</span>
      <p class="text-sm font-semibold">Next Pickup</p>
    </div>
    <div class="flex h-10 shrink-0 items-center justify-center gap-x-2 rounded-full bg-white px-4 shadow-lg text-slate-700">
      <span class="material-symbols-outlined text-xl">update</span>
      <p class="text-sm font-medium">Upcoming</p>
    </div>
    <div class="flex h-10 shrink-0 items-center justify-center gap-x-2 rounded-full bg-white px-4 shadow-lg text-slate-400">
      <span class="material-symbols-outlined text-xl">check_circle</span>
      <p class="text-sm font-medium">Completed</p>
    </div>
  </div>

  <%# List View Floating Button %>
  <div class="absolute bottom-32 left-1/2 -translate-x-1/2" style="z-index: 10;">
    <%= link_to agent_route_pickups_path(@route), class: "flex items-center justify-center gap-3 rounded-full h-14 px-8 bg-slate-900 text-white shadow-2xl hover:scale-105 transition-transform" do %>
      <span class="material-symbols-outlined">format_list_bulleted</span>
      <span class="font-bold tracking-wide">LIST VIEW</span>
    <% end %>
  </div>

  <%# Bottom Information Card %>
  <% if next_household %>
    <div class="absolute bottom-4 left-4 right-4 bg-white rounded-xl p-4 shadow-2xl border border-slate-200" style="z-index: 5;">
      <div class="flex justify-between items-start mb-2">
        <div class="flex flex-col">
          <span class="text-[10px] font-bold text-[#ec5b13] uppercase tracking-widest">Next Stop</span>
          <h3 class="text-lg font-bold"><%= next_household.address %></h3>
        </div>
        <div class="bg-[#ec5b13]/10 text-[#ec5b13] px-3 py-1 rounded-full text-xs font-bold">
          <% if next_pickup&.scheduled_time.present? %>
            ETA <%= next_pickup.scheduled_time.strftime("%-I:%M %p") %>
          <% else %>
            Next
          <% end %>
        </div>
      </div>
      <div class="flex items-center gap-4 text-sm text-slate-500">
        <div class="flex items-center gap-1">
          <span class="material-symbols-outlined text-sm">distance</span>
          <%= @route.area %>
        </div>
        <div class="flex items-center gap-1">
          <span class="material-symbols-outlined text-sm">recycling</span>
          <% if next_pickup %>
            <%= next_pickup.waste_type&.titleize || "Mixed Waste" %>
          <% else %>
            Mixed Waste
          <% end %>
        </div>
      </div>
    </div>
  <% else %>
    <div class="absolute bottom-4 left-4 right-4 bg-white rounded-xl p-4 shadow-2xl border border-slate-200" style="z-index: 5;">
      <div class="flex justify-between items-start mb-2">
        <div class="flex flex-col">
          <span class="text-[10px] font-bold text-[#ec5b13] uppercase tracking-widest">Route Info</span>
          <h3 class="text-lg font-bold"><%= @route.name %></h3>
        </div>
        <div class="bg-[#ec5b13]/10 text-[#ec5b13] px-3 py-1 rounded-full text-xs font-bold">
          <%= completed_count %>/<%= total_count %>
        </div>
      </div>
      <div class="flex items-center gap-4 text-sm text-slate-500">
        <div class="flex items-center gap-1">
          <span class="material-symbols-outlined text-sm">check_circle</span>
          <%= completed_count %> completed
        </div>
        <div class="flex items-center gap-1">
          <span class="material-symbols-outlined text-sm">pending_actions</span>
          <%= remaining_count %> remaining
        </div>
      </div>
    </div>
  <% end %>

  <%# Progress bar overlay at top of map %>
  <% if total_count > 0 %>
    <div class="absolute top-16 left-4 right-20" style="z-index: 5;">
      <div class="w-full bg-white/60 backdrop-blur rounded-full h-1.5 shadow-sm">
        <div class="h-1.5 rounded-full bg-[#ec5b13]" style="width: <%= ((completed_count.to_f / total_count) * 100).round %>%"></div>
      </div>
    </div>
  <% end %>
</main>
