<% content_for(:title, "Home - CleanCircle Collector") %>

<%# Profile Greeting %>
<section class="p-6">
  <h1 class="text-3xl font-bold tracking-tight">Hello, <%= current_user.name.split(' ').first %>!</h1>
  <p class="text-slate-600 mt-1"><%= @pending_today %> service points remaining for today.</p>
</section>

<%# Completed / Remaining stat cards %>
<section class="grid grid-cols-2 gap-4 px-4">
  <div class="flex flex-col gap-2 rounded-xl p-5 bg-white border border-[#ec5b13]/10 shadow-sm">
    <div class="flex items-center gap-2 text-[#ec5b13]">
      <span class="material-symbols-outlined text-sm">check_circle</span>
      <p class="text-slate-500 text-xs font-semibold uppercase">Completed</p>
    </div>
    <p class="text-3xl font-bold leading-tight"><%= @completed_today %></p>
  </div>
  <div class="flex flex-col gap-2 rounded-xl p-5 bg-white border border-[#ec5b13]/10 shadow-sm">
    <div class="flex items-center gap-2 text-[#ec5b13]">
      <span class="material-symbols-outlined text-sm">pending_actions</span>
      <p class="text-slate-500 text-xs font-semibold uppercase">Remaining</p>
    </div>
    <p class="text-3xl font-bold leading-tight"><%= @pending_today %></p>
  </div>
</section>

<%# Route Summary Hero Card %>
<% if @routes.any? %>
  <section class="mt-6 px-4">
    <div class="relative overflow-hidden rounded-2xl bg-[#ec5b13] p-6 text-white shadow-lg shadow-[#ec5b13]/20">
      <div class="relative z-10">
        <h3 class="text-xl font-bold">Today's Route Summary</h3>
        <p class="mt-1 text-white/80 text-sm">
          <%= @routes.first.name %> &middot; <%= @routes.first.area %>
        </p>
        <%= link_to agent_route_path(@routes.first), class: "mt-6 flex w-full items-center justify-center gap-2 rounded-xl bg-white px-4 py-4 text-base font-bold text-[#ec5b13] transition-transform active:scale-95" do %>
          <span class="material-symbols-outlined">navigation</span>
          Start Today's Route
        <% end %>
      </div>
      <div class="absolute -right-12 -top-12 size-48 rounded-full bg-white/10"></div>
      <div class="absolute -bottom-8 -left-8 size-32 rounded-full bg-black/5"></div>
    </div>
  </section>
<% end %>

<%# Upcoming Stops %>
<section class="mt-8 px-4">
  <div class="flex items-center justify-between mb-4">
    <h3 class="text-lg font-bold">Upcoming Stops</h3>
    <% if @routes.any? %>
      <%= link_to "View All", agent_route_path(@routes.first), class: "text-[#ec5b13] text-sm font-semibold" %>
    <% end %>
  </div>

  <% if @routes.any? %>
    <div class="space-y-3">
      <% @routes.each do |route| %>
        <% route.pickups.where(status: [:pending, :scheduled]).where(created_at: Date.current.all_day).limit(3).each_with_index do |pickup, idx| %>
          <div class="flex items-center gap-4 rounded-xl bg-white p-4 border border-slate-100 shadow-sm">
            <div class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-[#ec5b13]/10 text-[#ec5b13]">
              <span class="material-symbols-outlined">home</span>
            </div>
            <div class="flex-1">
              <h4 class="font-bold text-sm"><%= pickup.household&.building_name || pickup.household&.address || "Pickup ##{pickup.id}" %></h4>
              <p class="text-xs text-slate-500"><%= pickup.waste_type&.titleize || "Mixed Waste" %></p>
            </div>
            <div class="text-right">
              <span class="text-xs font-bold <%= idx == 0 ? 'text-[#ec5b13] bg-[#ec5b13]/10' : 'text-slate-400 bg-slate-100' %> px-2 py-1 rounded-full uppercase">
                <%= "#{(idx + 1) * 0.4} km" %>
              </span>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-xl bg-white p-8 text-center text-sm text-slate-400 border border-slate-100">
      No routes assigned for today.
    </div>
  <% end %>
</section>
