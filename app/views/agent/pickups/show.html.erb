<% content_for(:title, "Pickup ##{@pickup.id} - CleanCircle Agent") %>

<div class="mb-5">
  <div class="flex items-center text-sm text-gray-500 mb-2">
    <%= link_to "My Routes", agent_routes_path, class: "text-blue-600 hover:text-blue-800" %>
    <svg class="w-4 h-4 mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    <span class="text-gray-700">Pickup #<%= @pickup.id %></span>
  </div>
  <h1 class="text-xl font-bold text-gray-900">Pickup Details</h1>
</div>

<%# Household name prominent header %>
<div class="bg-white rounded-xl shadow-sm border border-gray-200 mb-4 px-4 py-4">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-lg font-bold text-gray-900">
        <%= @pickup.household.building_name.presence || @pickup.household.address %>
        <% if @pickup.household.unit_number.present? %>
          <span class="text-gray-500 font-normal">- Unit <%= @pickup.household.unit_number %></span>
        <% end %>
      </h2>
      <% if @pickup.household.user.present? %>
        <p class="text-sm text-gray-600 mt-1">
          <svg class="w-4 h-4 inline-block mr-1 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          <%= @pickup.household.user.name %>
        </p>
      <% end %>
    </div>
    <% if @pickup.household.qr_code_token.present? %>
      <div class="text-right flex-shrink-0 ml-4">
        <div class="bg-gray-100 rounded-lg px-3 py-2 text-center">
          <p class="text-xs text-gray-500 font-medium">QR Token</p>
          <p class="text-sm font-mono font-bold text-gray-800"><%= @pickup.household.qr_code_token %></p>
        </div>
        <%= link_to agent_scan_path(qr_code: @pickup.household.qr_code_token),
          class: "inline-flex items-center text-xs text-blue-600 hover:text-blue-800 font-medium mt-1" do %>
          <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"/></svg>
          Scan QR
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<%# Status banner %>
<div class="mb-4">
  <% case @pickup.status %>
  <% when "scheduled" %>
    <div class="bg-blue-50 border border-blue-200 rounded-xl px-4 py-3 flex items-center">
      <div class="w-3 h-3 rounded-full bg-blue-500 mr-3 flex-shrink-0"></div>
      <span class="text-sm font-medium text-blue-800">Scheduled</span>
    </div>
  <% when "in_progress" %>
    <div class="bg-yellow-50 border border-yellow-200 rounded-xl px-4 py-3 flex items-center">
      <div class="w-3 h-3 rounded-full bg-yellow-500 mr-3 flex-shrink-0 animate-pulse"></div>
      <span class="text-sm font-medium text-yellow-800">In Progress</span>
    </div>
  <% when "completed" %>
    <div class="bg-green-50 border border-green-200 rounded-xl px-4 py-3 flex items-center">
      <div class="w-3 h-3 rounded-full bg-green-500 mr-3 flex-shrink-0"></div>
      <span class="text-sm font-medium text-green-800">Completed</span>
    </div>
  <% when "missed" %>
    <div class="bg-red-50 border border-red-200 rounded-xl px-4 py-3 flex items-center">
      <div class="w-3 h-3 rounded-full bg-red-500 mr-3 flex-shrink-0"></div>
      <span class="text-sm font-medium text-red-800">Missed</span>
    </div>
  <% end %>
</div>

<%# Household info %>
<div class="bg-white rounded-xl shadow-sm border border-gray-200 mb-4">
  <div class="px-4 py-3 border-b border-gray-200">
    <h2 class="text-base font-semibold text-gray-900">Household Information</h2>
  </div>
  <div class="px-4 py-3 space-y-3">
    <div>
      <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Address</p>
      <p class="text-sm text-gray-900 mt-0.5"><%= @pickup.household.address %></p>
    </div>
    <% if @pickup.household.building_name.present? %>
      <div>
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Building</p>
        <p class="text-sm text-gray-900 mt-0.5"><%= @pickup.household.building_name %></p>
      </div>
    <% end %>
    <% if @pickup.household.unit_number.present? %>
      <div>
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Unit</p>
        <p class="text-sm text-gray-900 mt-0.5"><%= @pickup.household.unit_number %></p>
      </div>
    <% end %>
    <div>
      <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Scheduled Date</p>
      <p class="text-sm text-gray-900 mt-0.5"><%= @pickup.created_at.strftime("%B %d, %Y") %></p>
    </div>
    <% if @pickup.confirmed_at.present? %>
      <div>
        <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Completed At</p>
        <p class="text-sm text-gray-900 mt-0.5"><%= @pickup.confirmed_at.strftime("%B %d, %Y at %-I:%M %p") %></p>
      </div>
    <% end %>
  </div>
</div>

<%# Action buttons - large touch-friendly %>
<% unless @pickup.status.in?(["completed", "missed"]) %>
  <div class="space-y-3">
    <%= button_to confirm_agent_pickup_path(@pickup),
      method: :patch,
      class: "w-full bg-green-600 hover:bg-green-700 text-white text-lg font-semibold py-4 rounded-xl shadow-sm transition flex items-center justify-center",
      data: { turbo_confirm: "Confirm this pickup as completed?" } do %>
      <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
      Confirm Pickup
    <% end %>

    <%# Missed pickup form with notes %>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
      <p class="text-sm font-medium text-gray-700 mb-2">Mark as Missed</p>
      <%= form_with url: mark_missed_agent_pickup_path(@pickup), method: :patch, local: true do |f| %>
        <div class="mb-3">
          <label for="notes" class="block text-sm text-gray-600 mb-1">Reason / Notes</label>
          <textarea name="notes" id="notes" rows="3"
            placeholder="e.g. No bins outside, gate locked, etc."
            class="block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500"></textarea>
        </div>
        <button type="submit"
          data-turbo-confirm="Mark this pickup as missed?"
          class="w-full bg-red-600 hover:bg-red-700 text-white text-lg font-semibold py-4 rounded-xl shadow-sm transition flex items-center justify-center">
          <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          Mark Missed
        </button>
      <% end %>
    </div>
  </div>
<% end %>
