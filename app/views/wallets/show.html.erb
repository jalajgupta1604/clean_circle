<%# Wallet %>
<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6">
    <%= link_to root_path, class: "inline-flex items-center text-sm text-gray-500 hover:text-emerald-600 transition-colors" do %>
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      Back to Dashboard
    <% end %>
  </div>

  <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-8">My Wallet</h1>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <%# Left Column: Balance & Recharge %>
    <div class="lg:col-span-1 space-y-6">
      <%# Balance Card %>
      <div class="bg-gradient-to-br from-emerald-600 to-emerald-700 rounded-2xl p-6 text-white shadow-lg">
        <p class="text-sm font-medium text-emerald-200 mb-1">Current Balance</p>
        <p class="text-4xl font-extrabold">&#8377;<%= @wallet.balance %></p>
        <div class="mt-4 pt-4 border-t border-emerald-500/30">
          <p class="text-xs text-emerald-200">Wallet ID: <%= @wallet.id %></p>
        </div>
      </div>

      <%# Recharge Form %>
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-4">Recharge Wallet</h2>

        <%= form_with url: recharge_wallet_path, method: :post, class: "space-y-4" do |f| %>
          <%# Preset Amounts %>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-3">Quick Amount</label>
            <div class="grid grid-cols-3 gap-2">
              <% [200, 500, 1000].each do |amount| %>
                <button type="button"
                        onclick="document.getElementById('recharge_amount').value = <%= amount %>"
                        class="px-3 py-2.5 text-sm font-semibold border-2 border-gray-200 rounded-xl text-gray-700 hover:border-emerald-500 hover:text-emerald-600 hover:bg-emerald-50 focus:border-emerald-500 focus:outline-none transition-all">
                  &#8377;<%= amount %>
                </button>
              <% end %>
            </div>
          </div>

          <%# Custom Amount %>
          <div>
            <label for="recharge_amount" class="block text-sm font-medium text-gray-700 mb-2">Amount</label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 font-medium">&#8377;</span>
              <input type="number" name="amount" id="recharge_amount" min="50" step="1" required
                     placeholder="Enter amount"
                     class="block w-full pl-10 pr-4 py-3 rounded-xl border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 text-gray-900 placeholder-gray-400 sm:text-sm">
            </div>
            <p class="mt-1.5 text-xs text-gray-500">Minimum recharge: &#8377;50</p>
          </div>

          <%= f.submit "Recharge Now", class: "w-full py-3 px-4 bg-emerald-600 text-white rounded-xl font-semibold hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors cursor-pointer" %>
        <% end %>
      </div>
    </div>

    <%# Right Column: Transaction History %>
    <div class="lg:col-span-2">
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm">
        <div class="p-6 border-b border-gray-100">
          <h2 class="text-lg font-bold text-gray-900">Transaction History</h2>
        </div>

        <% if @transactions.present? %>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Date</th>
                  <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Description</th>
                  <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Type</th>
                  <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Amount</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <% @transactions.each do |txn| %>
                  <tr class="hover:bg-gray-50 transition-colors">
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                      <%= txn.created_at.strftime("%b %d, %Y") %>
                    </td>
                    <td class="px-6 py-4 text-sm text-gray-900 font-medium">
                      <%= txn.description %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold
                        <%= txn.transaction_type == 'credit' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
                        <%= txn.transaction_type.capitalize %>
                      </span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-right
                      <%= txn.transaction_type == 'credit' ? 'text-green-600' : 'text-red-600' %>">
                      <%= txn.transaction_type == 'credit' ? '+' : '-' %>&#8377;<%= txn.amount %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <%# Pagination %>
          <% if defined?(pagy) && @pagy %>
            <div class="p-4 border-t border-gray-100">
              <%== pagy_nav(@pagy) %>
            </div>
          <% end %>
        <% else %>
          <div class="p-12 text-center">
            <svg class="w-12 h-12 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
            <p class="text-gray-500">No transactions yet. Recharge your wallet to get started.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
