<%# Wallet Dashboard %>
<% content_for(:page_title) { "My Wallet" } %>

<div class="space-y-6">
  <%# Top Row: Balance Card + Auto-Recharge %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <%# Balance Card %>
    <div class="flex flex-col justify-between rounded-3xl p-8 bg-[#ec5b13] text-white shadow-xl shadow-[#ec5b13]/20 relative overflow-hidden">
      <div class="relative z-10">
        <p class="text-white/80 text-sm font-medium">Total Balance</p>
        <h3 class="text-4xl font-bold mt-2">&#8377;<%= @wallet.balance %></h3>
      </div>
      <div class="mt-8 flex gap-3 relative z-10">
        <button type="button" onclick="document.getElementById('recharge_amount').focus()"
                class="flex items-center justify-center gap-2 rounded-xl bg-white px-6 py-3 text-sm font-bold text-[#ec5b13] hover:bg-slate-50 transition-colors shadow-lg">
          <span class="material-symbols-outlined text-lg">add</span>
          Recharge
        </button>
        <% if current_user.household %>
          <%= link_to qr_code_path, class: "flex items-center justify-center gap-2 rounded-xl bg-black/10 px-6 py-3 text-sm font-bold text-white hover:bg-black/20 transition-colors" do %>
            <span class="material-symbols-outlined text-lg">qr_code_2</span>
            QR Code
          <% end %>
        <% end %>
      </div>
      <div class="mt-4 pt-4 border-t border-white/20 relative z-10">
        <p class="text-xs text-white/60">Wallet ID: <%= @wallet.id %></p>
      </div>
      <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/10 blur-3xl"></div>
      <div class="absolute -left-10 -bottom-10 h-32 w-32 rounded-full bg-black/10 blur-2xl"></div>
    </div>

    <%# Auto-Recharge + Recharge Form %>
    <div class="flex flex-col gap-6">
      <%# Recharge Form %>
      <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6">
        <h2 class="text-lg font-bold text-slate-900 mb-4">Recharge Wallet</h2>
        <%= form_with url: recharge_wallet_path, method: :post, class: "space-y-4" do |f| %>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-3">Quick Amount</label>
            <div class="grid grid-cols-3 gap-2">
              <% [200, 500, 1000].each do |amount| %>
                <button type="button"
                        onclick="document.getElementById('recharge_amount').value = <%= amount %>"
                        class="px-3 py-2.5 text-sm font-semibold border-2 border-slate-200 rounded-xl text-slate-700 hover:border-[#ec5b13] hover:text-[#ec5b13] hover:bg-orange-50 focus:border-[#ec5b13] focus:outline-none transition-all">
                  &#8377;<%= amount %>
                </button>
              <% end %>
            </div>
          </div>
          <div>
            <label for="recharge_amount" class="block text-sm font-medium text-slate-700 mb-2">Amount</label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 font-medium">&#8377;</span>
              <input type="number" name="amount" id="recharge_amount" min="50" step="1" required
                     placeholder="Enter amount"
                     class="block w-full pl-10 pr-4 py-3 rounded-xl border-slate-300 shadow-sm focus:border-[#ec5b13] focus:ring-[#ec5b13] text-slate-900 placeholder-slate-400 sm:text-sm">
            </div>
            <p class="mt-1.5 text-xs text-slate-500">Minimum recharge: &#8377;50</p>
          </div>
          <%= f.submit "Recharge Now", class: "w-full py-3 px-4 bg-[#ec5b13] text-white rounded-xl font-bold hover:brightness-110 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#ec5b13] transition-all cursor-pointer shadow-lg shadow-[#ec5b13]/20" %>
        <% end %>
      </div>

      <%# Auto Recharge Card %>
      <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6">
        <div class="flex items-center justify-between mb-3">
          <div>
            <p class="text-base font-bold text-slate-900">Auto-Recharge</p>
            <p class="text-slate-500 text-sm">Top up when balance is low</p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="auto_recharge_toggle" class="sr-only peer">
            <div class="w-12 h-7 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[4px] after:left-[4px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#ec5b13]"></div>
          </label>
        </div>
      </div>
    </div>
  </div>

  <%# Transaction History %>
  <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="flex items-center justify-between px-6 sm:px-8 py-6 border-b border-slate-100">
      <h4 class="text-lg font-bold text-slate-900">Recent Transactions</h4>
      <div class="flex items-center gap-2">
        <%= link_to "All", wallet_path, class: "px-4 py-1.5 rounded-full text-sm font-semibold transition-colors #{params[:type].blank? ? 'bg-[#ec5b13] text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'}" %>
        <%= link_to "Credits", wallet_path(type: "credit"), class: "px-4 py-1.5 rounded-full text-sm font-semibold transition-colors #{params[:type] == 'credit' ? 'bg-green-600 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'}" %>
        <%= link_to "Debits", wallet_path(type: "debit"), class: "px-4 py-1.5 rounded-full text-sm font-semibold transition-colors #{params[:type] == 'debit' ? 'bg-red-600 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'}" %>
      </div>
    </div>

    <% if @transactions.present? %>
      <div class="divide-y divide-slate-100">
        <% @transactions.each do |txn| %>
          <div class="flex items-center justify-between px-6 sm:px-8 py-5 hover:bg-slate-50 transition-colors">
            <div class="flex items-center gap-4">
              <div class="flex h-12 w-12 items-center justify-center rounded-2xl
                <%= txn.transaction_type == 'credit' ? 'bg-green-100 text-green-600' : 'bg-red-100 text-red-600' %>">
                <span class="material-symbols-outlined"><%= txn.transaction_type == 'credit' ? 'account_balance_wallet' : 'payments' %></span>
              </div>
              <div>
                <p class="font-bold text-slate-900 text-sm"><%= txn.description %></p>
                <p class="text-sm text-slate-500"><%= txn.created_at.strftime("%b %d, %Y") %></p>
              </div>
            </div>
            <p class="font-bold text-sm <%= txn.transaction_type == 'credit' ? 'text-green-600' : 'text-slate-900' %>">
              <%= txn.transaction_type == 'credit' ? '+' : '-' %>&#8377;<%= txn.amount %>
            </p>
          </div>
        <% end %>
      </div>

      <% if defined?(pagy) && @pagy %>
        <div class="p-4 border-t border-slate-100">
          <%== pagy_nav(@pagy) %>
        </div>
      <% end %>
    <% else %>
      <div class="p-12 text-center">
        <span class="material-symbols-outlined text-4xl text-slate-300 mb-4">account_balance_wallet</span>
        <p class="text-slate-500">No transactions yet. Recharge your wallet to get started.</p>
      </div>
    <% end %>
  </div>
</div>
