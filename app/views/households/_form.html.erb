<%# Household Form Partial %>
<%= form_with(model: household, url: household_path, class: "space-y-6") do |f| %>
  <% if household.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-xl p-4">
      <div class="flex items-start">
        <svg class="w-5 h-5 text-red-400 mt-0.5 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>
        <div>
          <h3 class="text-sm font-semibold text-red-800">Please fix the following errors:</h3>
          <ul class="mt-2 text-sm text-red-700 list-disc list-inside space-y-1">
            <% household.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div>
    <%= f.label :address, class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= f.text_area :address, rows: 3, required: true, placeholder: "Enter your full address", class: "block w-full rounded-xl border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 text-gray-900 placeholder-gray-400 sm:text-sm" %>
    <p class="mt-1.5 text-sm text-gray-500">Include street, area, city, and PIN code</p>
  </div>

  <div>
    <%= f.label :building_name, class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= f.text_field :building_name, placeholder: "e.g. Sunrise Apartments", class: "block w-full rounded-xl border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 text-gray-900 placeholder-gray-400 sm:text-sm" %>
  </div>

  <div>
    <%= f.label :unit_number, class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= f.text_field :unit_number, placeholder: "e.g. A-204", class: "block w-full rounded-xl border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 text-gray-900 placeholder-gray-400 sm:text-sm" %>
  </div>

  <div class="flex items-center justify-end gap-3 pt-4">
    <%= link_to "Cancel", (household.persisted? ? household_path(household) : root_path), class: "px-6 py-2.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-xl hover:bg-gray-50 transition-colors" %>
    <%= f.submit (household.persisted? ? "Update Household" : "Register Household"), class: "px-6 py-2.5 text-sm font-medium text-white bg-emerald-600 rounded-xl hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors cursor-pointer" %>
  </div>
<% end %>
