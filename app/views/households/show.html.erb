<%# Household Details %>
<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6">
    <%= link_to root_path, class: "inline-flex items-center text-sm text-gray-500 hover:text-emerald-600 transition-colors" do %>
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      Back to Dashboard
    <% end %>
  </div>

  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">Household Details</h1>
      <p class="mt-1 text-gray-500">Your registered household information and QR code</p>
    </div>
    <div class="flex gap-3">
      <%= link_to edit_household_path, class: "inline-flex items-center px-4 py-2 bg-white border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors" do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
        Edit
      <% end %>
      <%= link_to qr_code_path, class: "inline-flex items-center px-4 py-2 bg-emerald-600 text-white rounded-lg text-sm font-medium hover:bg-emerald-700 transition-colors" do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"/></svg>
        View QR Code
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <%# Household Info %>
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm">
      <div class="p-6 border-b border-gray-100">
        <h2 class="text-lg font-bold text-gray-900">Address Information</h2>
      </div>
      <div class="p-6 space-y-5">
        <div>
          <label class="block text-sm font-medium text-gray-500 mb-1">Address</label>
          <p class="text-gray-900 font-medium"><%= @household.address %></p>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-500 mb-1">Building Name</label>
          <p class="text-gray-900 font-medium"><%= @household.building_name.presence || "N/A" %></p>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-500 mb-1">Unit Number</label>
          <p class="text-gray-900 font-medium"><%= @household.unit_number.presence || "N/A" %></p>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-500 mb-1">Registered On</label>
          <p class="text-gray-900 font-medium"><%= @household.created_at.strftime("%B %d, %Y") %></p>
        </div>
      </div>
    </div>

    <%# QR Code %>
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm">
      <div class="p-6 border-b border-gray-100">
        <h2 class="text-lg font-bold text-gray-900">Your QR Code</h2>
      </div>
      <div class="p-6 flex flex-col items-center">
        <div class="w-56 h-56 flex items-center justify-center bg-white border-2 border-gray-100 rounded-xl p-4 mb-4">
          <%= raw @household.qr_code_svg %>
        </div>
        <p class="text-sm text-gray-500 text-center max-w-xs">
          Print and stick this QR code near your door. Our agents will scan it during each pickup.
        </p>
        <%= link_to qr_code_path, class: "mt-4 inline-flex items-center text-sm font-medium text-emerald-600 hover:text-emerald-700" do %>
          View full-size QR code
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        <% end %>
      </div>
    </div>
  </div>
</div>
