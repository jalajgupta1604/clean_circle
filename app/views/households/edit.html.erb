<%# Edit Household %>
<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6">
    <%= link_to household_path(@household), class: "inline-flex items-center text-sm text-gray-500 hover:text-emerald-600 transition-colors" do %>
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      Back to Household
    <% end %>
  </div>

  <div class="mb-8">
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">Edit Household</h1>
    <p class="mt-2 text-gray-500">Update your household address and details below.</p>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 sm:p-8">
    <%= render "form", household: @household %>
  </div>
</div>
