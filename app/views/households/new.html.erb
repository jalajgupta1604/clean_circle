<%# New Household %>
<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6">
    <%= link_to root_path, class: "inline-flex items-center text-sm text-gray-500 hover:text-emerald-600 transition-colors" do %>
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      Back to Dashboard
    <% end %>
  </div>

  <div class="mb-8">
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">Register Your Household</h1>
    <p class="mt-2 text-gray-500">Add your household details to start receiving waste collection services. A unique QR code will be generated for your door.</p>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 sm:p-8">
    <%= render "form", household: @household %>
  </div>
</div>
