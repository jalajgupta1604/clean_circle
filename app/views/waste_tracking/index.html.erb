<%# Waste Tracking Dashboard %>
<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6">
    <%= link_to root_path, class: "inline-flex items-center text-sm text-gray-500 hover:text-emerald-600 transition-colors" do %>
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      Back to Dashboard
    <% end %>
  </div>

  <div class="mb-8">
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">Waste Tracking</h1>
    <p class="mt-1 text-gray-500">Monitor your waste generation and environmental impact over time</p>
  </div>

  <%# Stats Summary Cards %>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
    <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
      <div class="flex items-center gap-3 mb-3">
        <div class="w-10 h-10 flex items-center justify-center rounded-lg bg-emerald-100 text-emerald-600">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/></svg>
        </div>
        <span class="text-sm font-medium text-gray-500">Total Waste</span>
      </div>
      <p class="text-3xl font-bold text-gray-900"><%= @total_waste %> <span class="text-lg font-normal text-gray-500">L</span></p>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
      <div class="flex items-center gap-3 mb-3">
        <div class="w-10 h-10 flex items-center justify-center rounded-lg bg-blue-100 text-blue-600">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
        </div>
        <span class="text-sm font-medium text-gray-500">Total Pickups</span>
      </div>
      <p class="text-3xl font-bold text-gray-900"><%= @total_pickups %></p>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
      <div class="flex items-center gap-3 mb-3">
        <div class="w-10 h-10 flex items-center justify-center rounded-lg bg-purple-100 text-purple-600">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
        </div>
        <span class="text-sm font-medium text-gray-500">Avg. per Pickup</span>
      </div>
      <p class="text-3xl font-bold text-gray-900"><%= @avg_per_pickup %> <span class="text-lg font-normal text-gray-500">L</span></p>
    </div>
  </div>

  <%# Monthly Waste Chart %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 sm:p-8 mb-8">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
      <div>
        <h2 class="text-lg font-bold text-gray-900">Monthly Waste Volume</h2>
        <p class="text-sm text-gray-500 mt-1">Your waste generation trend over the past months</p>
      </div>
    </div>
    <div class="h-80">
      <%= line_chart @monthly_data, library: {colors: ["#059669"]} %>
    </div>
  </div>

  <%# Tips Section %>
  <div class="bg-emerald-50 rounded-xl border border-emerald-200 p-6 sm:p-8">
    <h2 class="text-lg font-bold text-emerald-900 mb-4 flex items-center">
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
      Tips to Reduce Waste
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="flex items-start gap-3">
        <span class="flex-shrink-0 w-6 h-6 flex items-center justify-center rounded-full bg-emerald-200 text-emerald-700 text-xs font-bold">1</span>
        <p class="text-sm text-emerald-800">Compost kitchen waste at home to reduce organic waste by up to 40%.</p>
      </div>
      <div class="flex items-start gap-3">
        <span class="flex-shrink-0 w-6 h-6 flex items-center justify-center rounded-full bg-emerald-200 text-emerald-700 text-xs font-bold">2</span>
        <p class="text-sm text-emerald-800">Use cloth bags and avoid single-use plastics when shopping.</p>
      </div>
      <div class="flex items-start gap-3">
        <span class="flex-shrink-0 w-6 h-6 flex items-center justify-center rounded-full bg-emerald-200 text-emerald-700 text-xs font-bold">3</span>
        <p class="text-sm text-emerald-800">Segregate dry and wet waste properly for better recycling outcomes.</p>
      </div>
      <div class="flex items-start gap-3">
        <span class="flex-shrink-0 w-6 h-6 flex items-center justify-center rounded-full bg-emerald-200 text-emerald-700 text-xs font-bold">4</span>
        <p class="text-sm text-emerald-800">Buy in bulk to reduce packaging waste and save money too.</p>
      </div>
    </div>
  </div>
</div>
