<%# Choose a Subscription Plan %>
<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6">
    <%= link_to subscriptions_path, class: "inline-flex items-center text-sm text-gray-500 hover:text-emerald-600 transition-colors" do %>
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      Back to Subscription
    <% end %>
  </div>

  <div class="text-center mb-10">
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">Choose Your Plan</h1>
    <p class="mt-2 text-gray-500 max-w-lg mx-auto">Select a waste collection plan that fits your household. You can change your plan anytime.</p>
  </div>

  <%= form_with url: subscriptions_path, method: :post, class: "space-y-8" do |f| %>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <% @plans.each_with_index do |plan, index| %>
        <label class="relative cursor-pointer group">
          <input type="radio" name="subscription_plan_id" value="<%= plan.id %>"
                 class="peer sr-only" <%= "checked" if index == 1 %> required>

          <div class="bg-white rounded-xl border-2 border-gray-200 p-6 sm:p-8 transition-all duration-200
                      peer-checked:border-emerald-500 peer-checked:shadow-lg peer-checked:shadow-emerald-100
                      hover:border-gray-300 group-hover:shadow-md">

            <%# Checkmark indicator %>
            <div class="absolute top-4 right-4 w-6 h-6 rounded-full border-2 border-gray-300 flex items-center justify-center
                        peer-checked:border-emerald-500 peer-checked:bg-emerald-500 transition-colors">
              <svg class="w-4 h-4 text-white opacity-0 peer-checked:opacity-100 transition-opacity" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
            </div>

            <div class="mb-4">
              <h3 class="text-xl font-bold text-gray-900"><%= plan.name %></h3>
              <p class="text-sm text-gray-500 mt-1"><%= plan.bucket_size %> L waste bucket</p>
            </div>

            <div class="mb-6">
              <span class="text-3xl font-extrabold text-gray-900">&#8377;<%= plan.price.to_i %></span>
              <span class="text-gray-500">/month</span>
            </div>

            <ul class="space-y-3 text-sm text-gray-600">
              <li class="flex items-center">
                <svg class="w-4 h-4 text-emerald-500 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                Daily doorstep pickup
              </li>
              <li class="flex items-center">
                <svg class="w-4 h-4 text-emerald-500 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                QR-based tracking
              </li>
              <li class="flex items-center">
                <svg class="w-4 h-4 text-emerald-500 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                Waste analytics
              </li>
            </ul>
          </div>
        </label>
      <% end %>
    </div>

    <div class="text-center">
      <%= f.submit "Subscribe Now", class: "inline-flex items-center px-8 py-3.5 bg-emerald-600 text-white rounded-xl font-semibold text-lg hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 shadow-lg shadow-emerald-200 transition-all duration-200 cursor-pointer" %>
      <p class="mt-3 text-sm text-gray-500">Amount will be deducted from your wallet balance</p>
    </div>
  <% end %>
</div>
