<%# Sign In %>
<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full">
    <%# Logo & Header %>
    <div class="text-center mb-8">
      <div class="inline-flex items-center gap-2 mb-4">
        <div class="w-10 h-10 bg-emerald-600 rounded-xl flex items-center justify-center">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
        </div>
        <span class="text-2xl font-bold text-gray-900">CleanCircle</span>
      </div>
      <h1 class="text-2xl font-bold text-gray-900">Welcome back</h1>
      <p class="mt-2 text-gray-500">Sign in to manage your waste collection</p>
    </div>

    <div class="bg-white rounded-2xl border border-gray-200 shadow-lg p-8">
      <%# Google Sign In %>
      <%= button_to user_google_oauth2_omniauth_authorize_path, method: :post, data: { turbo: false }, class: "flex items-center justify-center gap-3 w-full px-4 py-3 border-2 border-gray-200 rounded-xl text-sm font-medium text-gray-700 hover:bg-gray-50 hover:border-gray-300 transition-all" do %>
        <svg class="w-5 h-5" viewBox="0 0 24 24">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        Sign in with Google
      <% end %>

      <%# Divider %>
      <div class="relative my-6">
        <div class="absolute inset-0 flex items-center">
          <div class="w-full border-t border-gray-200"></div>
        </div>
        <div class="relative flex justify-center text-sm">
          <span class="px-4 bg-white text-gray-500">or sign in with email</span>
        </div>
      </div>

      <%# Sign In Form %>
      <%= form_for(resource, as: resource_name, url: user_session_path, html: { class: "space-y-5" }) do |f| %>
        <% if flash[:alert] %>
          <div class="bg-red-50 border border-red-200 rounded-xl p-4">
            <p class="text-sm text-red-700 flex items-center">
              <svg class="w-4 h-4 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>
              <%= flash[:alert] %>
            </p>
          </div>
        <% end %>

        <div>
          <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
          <%= f.email_field :email, autofocus: true, required: true, autocomplete: "email", placeholder: "you@example.com", class: "block w-full rounded-xl border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 text-gray-900 placeholder-gray-400 sm:text-sm py-3" %>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <%= f.label :password, class: "block text-sm font-medium text-gray-700" %>
            <%= link_to "Forgot password?", new_user_password_path, class: "text-sm font-medium text-emerald-600 hover:text-emerald-700" %>
          </div>
          <%= f.password_field :password, required: true, autocomplete: "current-password", placeholder: "Enter your password", class: "block w-full rounded-xl border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 text-gray-900 placeholder-gray-400 sm:text-sm py-3" %>
        </div>

        <div class="flex items-center">
          <%= f.check_box :remember_me, class: "w-4 h-4 text-emerald-600 border-gray-300 rounded focus:ring-emerald-500" %>
          <%= f.label :remember_me, class: "ml-2 text-sm text-gray-600" %>
        </div>

        <div>
          <%= f.submit "Sign In", class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-xl shadow-sm text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors cursor-pointer" %>
        </div>
      <% end %>

      <%# Sign up link %>
      <p class="mt-6 text-center text-sm text-gray-500">
        Don't have an account?
        <%= link_to "Sign up for free", new_user_registration_path, class: "font-semibold text-emerald-600 hover:text-emerald-700" %>
      </p>
    </div>
  </div>
</div>
