<%# Rewards & Eco Score %>
<% content_for(:page_title) { "Rewards History" } %>

<div class="space-y-6">
  <%# Summary Card %>
  <div class="relative overflow-hidden flex flex-col items-stretch rounded-xl shadow-lg bg-[#ec5b13] text-white p-6 sm:p-8">
    <div class="absolute -right-8 -top-8 w-32 h-32 bg-white/10 rounded-full blur-2xl"></div>
    <div class="absolute -left-4 -bottom-4 w-24 h-24 bg-black/5 rounded-full blur-xl"></div>
    <div class="relative z-10">
      <p class="text-white/80 text-sm font-medium uppercase tracking-wider">Total Eco Points</p>
      <p class="text-4xl font-extrabold mt-1"><%= @reward_points %></p>
      <div class="mt-6 flex items-center gap-3">
        <div class="bg-white/20 p-2 rounded-lg">
          <span class="material-symbols-outlined text-white">shield_person</span>
        </div>
        <div>
          <p class="text-white/70 text-xs font-normal">Current Level</p>
          <p class="text-white text-base font-bold"><%= @eco_badge %></p>
        </div>
      </div>
    </div>
  </div>

  <%# Recent Badges - Scrollable %>
  <div>
    <div class="flex items-center justify-between mb-3">
      <h3 class="text-lg font-bold leading-tight tracking-tight text-slate-900">Recent Badges</h3>
      <span class="text-[#ec5b13] text-sm font-semibold">View All</span>
    </div>
    <div class="flex w-full overflow-x-auto gap-4 pb-2" style="-ms-overflow-style: none; scrollbar-width: none;">
      <% total_pickups = current_user.household&.pickups&.completed&.count || 0 %>
      <% badge_items = [
        { name: "Zero Waste Week", icon: "eco", earned: @eco_score >= 50 },
        { name: "Recycling Pro", icon: "recycling", earned: total_pickups >= 10 },
        { name: "Compost Master", icon: "compost", earned: total_pickups >= 25 },
        { name: "Water Saver", icon: "water_drop", earned: @eco_score >= 75 }
      ] %>
      <% badge_items.each do |badge| %>
        <div class="flex flex-col items-center gap-2 min-w-[80px]">
          <div class="w-16 h-16 flex items-center justify-center rounded-full border-2 shadow-sm overflow-hidden
            <%= badge[:earned] ? 'bg-[#ec5b13]/10 border-[#ec5b13]/20' : 'bg-slate-100 border-slate-200' %>">
            <span class="material-symbols-outlined text-3xl <%= badge[:earned] ? 'text-[#ec5b13]' : 'text-slate-400' %>"><%= badge[:icon] %></span>
          </div>
          <p class="text-[11px] font-bold text-center leading-tight text-slate-900"><%= badge[:name] %></p>
        </div>
      <% end %>
    </div>
  </div>

  <%# Top Row: Eco Score + Badge + Redeem %>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <%# Eco Score Gauge %>
    <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm text-center">
      <h2 class="text-sm font-medium text-slate-500 mb-4">Eco Score</h2>
      <div class="relative inline-flex items-center justify-center w-36 h-36 mb-4">
        <svg class="w-36 h-36 transform -rotate-90" viewBox="0 0 128 128">
          <circle cx="64" cy="64" r="52" stroke="#e2e8f0" stroke-width="10" fill="none"/>
          <circle cx="64" cy="64" r="52" stroke="#ec5b13"
                  stroke-width="10" fill="none"
                  stroke-dasharray="<%= (2 * Math::PI * 52).round(1) %>"
                  stroke-dashoffset="<%= ((1 - @eco_score / 100.0) * 2 * Math::PI * 52).round(1) %>"
                  stroke-linecap="round"/>
        </svg>
        <div class="absolute inset-0 flex items-center justify-center">
          <span class="text-3xl font-bold text-slate-900"><%= @eco_score %></span>
        </div>
      </div>
      <p class="text-xs text-slate-400">out of 100</p>
    </div>

    <%# Current Badge %>
    <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm text-center">
      <h2 class="text-sm font-medium text-slate-500 mb-4">Current Badge</h2>
      <div class="mb-4">
        <% badge_colors = { "Beginner" => "bg-slate-100 text-slate-600", "Eco Warrior" => "bg-green-100 text-green-600", "Green Champion" => "bg-green-100 text-green-600", "Planet Saver" => "bg-teal-100 text-teal-700" } %>
        <% badge_icons = { "Beginner" => "menu_book", "Eco Warrior" => "bolt", "Green Champion" => "auto_awesome", "Planet Saver" => "public" } %>
        <div class="w-20 h-20 mx-auto flex items-center justify-center rounded-full <%= badge_colors[@eco_badge] || 'bg-slate-100 text-slate-600' %>">
          <span class="material-symbols-outlined text-4xl"><%= badge_icons[@eco_badge] || 'eco' %></span>
        </div>
      </div>
      <p class="text-xl font-bold text-slate-900"><%= @eco_badge %></p>
      <p class="text-xs text-slate-400 mt-1">
        <% case @eco_badge
           when "Beginner" %>Keep completing pickups to level up!
        <% when "Eco Warrior" %>Great progress! You're making a difference.
        <% when "Green Champion" %>Amazing! You're leading the way.
        <% when "Planet Saver" %>Outstanding! You're a true eco hero!
        <% end %>
      </p>
    </div>

    <%# Reward Points & Redeem %>
    <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm text-center">
      <h2 class="text-sm font-medium text-slate-500 mb-4">Reward Points</h2>
      <div class="mb-4">
        <div class="w-20 h-20 mx-auto flex items-center justify-center rounded-full bg-[#ec5b13]/10 text-[#ec5b13]">
          <span class="material-symbols-outlined text-4xl">military_tech</span>
        </div>
      </div>
      <p class="text-3xl font-bold text-slate-900"><%= @reward_points %></p>
      <p class="text-xs text-slate-400 mb-4">points available</p>

      <% if @reward_points >= 100 %>
        <%= form_with url: redeem_rewards_path, method: :post, class: "space-y-3" do |f| %>
          <div class="flex items-center gap-2">
            <select name="amount" class="flex-1 rounded-xl border-slate-300 text-sm focus:ring-[#ec5b13] focus:border-[#ec5b13]">
              <% [100, 200, 500, 1000].each do |pts| %>
                <% next if pts > @reward_points %>
                <option value="<%= pts %>"><%= pts %> pts = &#8377;<%= (pts / 100.0 * 10).round(0) %></option>
              <% end %>
            </select>
            <%= f.submit "Redeem", class: "px-4 py-2 bg-[#ec5b13] text-white rounded-xl text-sm font-bold hover:brightness-110 transition-all cursor-pointer" %>
          </div>
        <% end %>
      <% else %>
        <p class="text-xs text-slate-400">Earn <%= 100 - @reward_points %> more points to redeem.</p>
      <% end %>
    </div>
  </div>

  <%# Earnings History %>
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm">
    <div class="p-6 border-b border-slate-100">
      <h2 class="text-lg font-bold text-slate-900 leading-tight tracking-tight">Earnings History</h2>
    </div>
    <% if @reward_notifications.present? %>
      <div class="divide-y divide-slate-100 max-h-96 overflow-y-auto">
        <% @reward_notifications.each do |notification| %>
          <div class="flex items-center justify-between p-4 hover:bg-slate-50 transition-colors">
            <div class="flex items-center gap-4">
              <div class="flex items-center justify-center w-10 h-10 rounded-full bg-[#ec5b13]/10 text-[#ec5b13]">
                <span class="material-symbols-outlined">military_tech</span>
              </div>
              <div>
                <p class="font-bold text-sm text-slate-900"><%= notification.title %></p>
                <p class="text-xs text-slate-500"><%= notification.created_at.strftime("%b %d, %Y") %></p>
              </div>
            </div>
            <div class="text-right">
              <p class="text-[#ec5b13] font-bold text-sm"><%= notification.body %></p>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="p-12 text-center">
        <span class="material-symbols-outlined text-4xl text-slate-300 mb-4">military_tech</span>
        <p class="text-slate-500">No points earned yet. Complete pickups to start earning!</p>
      </div>
    <% end %>
  </div>

  <%# Badge Progression %>
  <div>
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg font-bold text-slate-900">Badge Progression</h3>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <% badges = [
        { name: "Beginner", range: "0-25", icon: "menu_book", color_active: "bg-slate-600 text-white", color_inactive: "bg-slate-100 text-slate-400" },
        { name: "Eco Warrior", range: "26-50", icon: "bolt", color_active: "bg-green-600 text-white", color_inactive: "bg-green-50 text-green-300" },
        { name: "Green Champion", range: "51-75", icon: "auto_awesome", color_active: "bg-green-600 text-white", color_inactive: "bg-green-50 text-green-300" },
        { name: "Planet Saver", range: "76-100", icon: "public", color_active: "bg-teal-600 text-white", color_inactive: "bg-teal-50 text-teal-300" }
      ] %>
      <% badges.each do |badge| %>
        <% is_current = @eco_badge == badge[:name] %>
        <div class="text-center p-4 rounded-xl border-2 <%= is_current ? 'border-[#ec5b13] bg-[#ec5b13]/5' : 'border-slate-100 bg-white' %> shadow-sm">
          <div class="w-14 h-14 mx-auto flex items-center justify-center rounded-full mb-3 <%= is_current ? badge[:color_active] : badge[:color_inactive] %>">
            <span class="material-symbols-outlined text-2xl"><%= badge[:icon] %></span>
          </div>
          <p class="font-semibold text-sm <%= is_current ? 'text-[#ec5b13]' : 'text-slate-500' %>"><%= badge[:name] %></p>
          <p class="text-xs text-slate-400">Score: <%= badge[:range] %></p>
          <% if is_current %>
            <span class="inline-block mt-2 px-2 py-0.5 rounded-full text-xs font-semibold bg-[#ec5b13] text-white">Current</span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <%# Cashback History %>
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm">
    <div class="p-6 border-b border-slate-100">
      <h2 class="text-lg font-bold text-slate-900">Cashback History</h2>
    </div>
    <% cashback_transactions = current_user.wallet&.wallet_transactions&.where("description LIKE ?", "%Reward%")&.order(created_at: :desc)&.limit(10) || [] %>
    <% if cashback_transactions.present? %>
      <div class="divide-y divide-slate-100 max-h-80 overflow-y-auto">
        <% cashback_transactions.each do |txn| %>
          <div class="flex items-center justify-between p-4 hover:bg-slate-50 transition-colors">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 flex items-center justify-center rounded-full bg-green-100 text-green-600 flex-shrink-0">
                <span class="material-symbols-outlined">account_balance_wallet</span>
              </div>
              <div>
                <p class="text-sm font-medium text-slate-900"><%= txn.description %></p>
                <p class="text-xs text-slate-400"><%= txn.created_at.strftime("%b %d, %Y") %></p>
              </div>
            </div>
            <span class="text-sm font-bold text-green-600">+&#8377;<%= txn.amount %></span>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="p-12 text-center">
        <span class="material-symbols-outlined text-4xl text-slate-300 mb-4">account_balance_wallet</span>
        <p class="text-slate-500">No cashback redemptions yet. Redeem your points above!</p>
      </div>
    <% end %>
  </div>

  <%# Tips to Earn More %>
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm">
    <div class="p-6 border-b border-slate-100">
      <h2 class="text-lg font-bold text-slate-900">Tips to Earn More</h2>
    </div>
    <div class="p-6 space-y-4">
      <% tips = [
        { icon: "check_circle", title: "Never miss a pickup", desc: "Consistent pickups boost your eco score and earn 10 points each." },
        { icon: "trending_down", title: "Reduce your waste", desc: "Lowering waste volume month-over-month increases your eco score." },
        { icon: "calendar_today", title: "Stay on schedule", desc: "Regular scheduled pickups earn 10 points vs 5 for on-demand." },
        { icon: "account_balance_wallet", title: "Redeem for credit", desc: "Every 100 points = Rs.10 wallet credit. Keep earning!" },
        { icon: "trending_up", title: "Level up your badge", desc: "Aim for Planet Saver (76+) -- the highest eco badge!" }
      ] %>
      <% tips.each do |tip| %>
        <div class="flex items-start gap-3">
          <div class="w-8 h-8 flex items-center justify-center rounded-lg bg-[#ec5b13]/10 text-[#ec5b13] shrink-0 mt-0.5">
            <span class="material-symbols-outlined text-lg"><%= tip[:icon] %></span>
          </div>
          <div>
            <p class="font-medium text-slate-900 text-sm"><%= tip[:title] %></p>
            <p class="text-xs text-slate-500"><%= tip[:desc] %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
