<%# Edit Profile %>
<% content_for(:page_title) { "Edit Profile" } %>

<div class="max-w-2xl mx-auto space-y-6">
  <%# Back Link %>
  <div>
    <%= link_to profile_path, class: "inline-flex items-center gap-1 text-sm text-slate-500 hover:text-[#ec5b13] transition-colors" do %>
      <span class="material-symbols-outlined text-lg">arrow_back</span>
      Back to Profile
    <% end %>
  </div>

  <div>
    <h1 class="text-2xl font-bold text-slate-900">Edit Profile</h1>
    <p class="mt-2 text-slate-500 text-sm">Update your personal information below.</p>
  </div>

  <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 sm:p-8">
    <%= form_with(model: @user, url: profile_path, method: :patch, class: "space-y-6") do |f| %>
      <% if @user.errors.any? %>
        <div class="bg-red-50 border border-red-200 rounded-xl p-4">
          <div class="flex items-start gap-2">
            <span class="material-symbols-outlined text-red-500 mt-0.5">error</span>
            <div>
              <h3 class="text-sm font-semibold text-red-800">Please fix the following errors:</h3>
              <ul class="mt-2 text-sm text-red-700 list-disc list-inside space-y-1">
                <% @user.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      <% end %>

      <div>
        <%= f.label :name, class: "block text-sm font-medium text-slate-700 mb-2" %>
        <%= f.text_field :name, required: true, placeholder: "Your full name", class: "block w-full rounded-xl border-slate-300 shadow-sm focus:border-[#ec5b13] focus:ring-[#ec5b13] text-slate-900 placeholder-slate-400 sm:text-sm" %>
      </div>

      <div>
        <%= f.label :phone, class: "block text-sm font-medium text-slate-700 mb-2" %>
        <%= f.telephone_field :phone, placeholder: "+91 98765 43210", class: "block w-full rounded-xl border-slate-300 shadow-sm focus:border-[#ec5b13] focus:ring-[#ec5b13] text-slate-900 placeholder-slate-400 sm:text-sm" %>
      </div>

      <div>
        <%= f.label :address, class: "block text-sm font-medium text-slate-700 mb-2" %>
        <%= f.text_area :address, rows: 3, placeholder: "Enter your full address", class: "block w-full rounded-xl border-slate-300 shadow-sm focus:border-[#ec5b13] focus:ring-[#ec5b13] text-slate-900 placeholder-slate-400 sm:text-sm" %>
      </div>

      <div>
        <%= f.label :family_size, class: "block text-sm font-medium text-slate-700 mb-2" %>
        <%= f.number_field :family_size, min: 1, max: 20, placeholder: "Number of family members", class: "block w-full rounded-xl border-slate-300 shadow-sm focus:border-[#ec5b13] focus:ring-[#ec5b13] text-slate-900 placeholder-slate-400 sm:text-sm" %>
        <p class="mt-1.5 text-sm text-slate-500">This helps us recommend the right waste plan for you</p>
      </div>

      <div class="flex items-center justify-end gap-3 pt-4">
        <%= link_to "Cancel", profile_path, class: "px-6 py-2.5 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-xl hover:bg-slate-50 transition-colors" %>
        <%= f.submit "Save Changes", class: "px-6 py-2.5 text-sm font-medium text-white bg-[#ec5b13] rounded-xl hover:brightness-110 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#ec5b13] transition-all cursor-pointer shadow-lg shadow-[#ec5b13]/20" %>
      </div>
    <% end %>
  </div>
</div>
