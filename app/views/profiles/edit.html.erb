<%# Edit Profile %>
<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6">
    <%= link_to profile_path, class: "inline-flex items-center text-sm text-gray-500 hover:text-emerald-600 transition-colors" do %>
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      Back to Profile
    <% end %>
  </div>

  <div class="mb-8">
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">Edit Profile</h1>
    <p class="mt-2 text-gray-500">Update your personal information below.</p>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 sm:p-8">
    <%= form_with(model: @user, url: profile_path, method: :patch, class: "space-y-6") do |f| %>
      <% if @user.errors.any? %>
        <div class="bg-red-50 border border-red-200 rounded-xl p-4">
          <div class="flex items-start">
            <svg class="w-5 h-5 text-red-400 mt-0.5 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>
            <div>
              <h3 class="text-sm font-semibold text-red-800">Please fix the following errors:</h3>
              <ul class="mt-2 text-sm text-red-700 list-disc list-inside space-y-1">
                <% @user.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      <% end %>

      <div>
        <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_field :name, required: true, placeholder: "Your full name", class: "block w-full rounded-xl border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 text-gray-900 placeholder-gray-400 sm:text-sm" %>
      </div>

      <div>
        <%= f.label :phone, class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.telephone_field :phone, placeholder: "+91 98765 43210", class: "block w-full rounded-xl border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 text-gray-900 placeholder-gray-400 sm:text-sm" %>
      </div>

      <div>
        <%= f.label :address, class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_area :address, rows: 3, placeholder: "Enter your full address", class: "block w-full rounded-xl border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 text-gray-900 placeholder-gray-400 sm:text-sm" %>
      </div>

      <div>
        <%= f.label :family_size, class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.number_field :family_size, min: 1, max: 20, placeholder: "Number of family members", class: "block w-full rounded-xl border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 text-gray-900 placeholder-gray-400 sm:text-sm" %>
        <p class="mt-1.5 text-sm text-gray-500">This helps us recommend the right waste plan for you</p>
      </div>

      <div class="flex items-center justify-end gap-3 pt-4">
        <%= link_to "Cancel", profile_path, class: "px-6 py-2.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-xl hover:bg-gray-50 transition-colors" %>
        <%= f.submit "Save Changes", class: "px-6 py-2.5 text-sm font-medium text-white bg-emerald-600 rounded-xl hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
