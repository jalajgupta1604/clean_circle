<%# User Profile %>
<% content_for(:page_title) { "Household Settings" } %>

<div class="max-w-2xl mx-auto space-y-6">
  <%# Profile Hero Section %>
  <div class="flex flex-col items-center bg-gradient-to-b from-[#ec5b13]/5 to-transparent p-6 rounded-xl">
    <div class="relative">
      <div class="w-28 h-28 rounded-full bg-[#ec5b13] text-white flex items-center justify-center text-4xl font-bold ring-4 ring-white shadow-lg">
        <%= current_user.name&.first&.upcase %>
      </div>
      <%= link_to edit_profile_path, class: "absolute bottom-0 right-0 bg-[#ec5b13] text-white p-1.5 rounded-full border-2 border-white flex items-center justify-center" do %>
        <span class="material-symbols-outlined text-xs">edit</span>
      <% end %>
    </div>
    <div class="mt-4 text-center">
      <h2 class="text-2xl font-bold text-slate-900"><%= current_user.name %></h2>
      <div class="mt-2 inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#ec5b13]/10 text-[#ec5b13] border border-[#ec5b13]/20">
        <span class="material-symbols-outlined text-sm">eco</span>
        <span class="text-xs font-bold uppercase tracking-wider">Eco Status: <%= current_user.eco_badge %></span>
      </div>
    </div>
  </div>

  <%# Personal Information %>
  <section>
    <h3 class="text-slate-500 text-xs font-bold uppercase tracking-widest px-2 mb-3">Personal Information</h3>
    <div class="bg-white rounded-xl border border-slate-200 divide-y divide-slate-100 overflow-hidden shadow-sm">
      <div class="flex items-center gap-4 p-4 hover:bg-slate-50 transition-colors">
        <div class="flex items-center justify-center rounded-lg bg-[#ec5b13]/10 text-[#ec5b13] w-10 h-10">
          <span class="material-symbols-outlined">person</span>
        </div>
        <div class="flex-1">
          <p class="text-xs text-slate-500">Full Name</p>
          <p class="text-sm font-medium text-slate-900"><%= current_user.name %></p>
        </div>
        <span class="material-symbols-outlined text-slate-300">chevron_right</span>
      </div>
      <div class="flex items-center gap-4 p-4 hover:bg-slate-50 transition-colors">
        <div class="flex items-center justify-center rounded-lg bg-[#ec5b13]/10 text-[#ec5b13] w-10 h-10">
          <span class="material-symbols-outlined">mail</span>
        </div>
        <div class="flex-1">
          <p class="text-xs text-slate-500">Email Address</p>
          <p class="text-sm font-medium text-slate-900"><%= current_user.email %></p>
        </div>
        <span class="material-symbols-outlined text-slate-300">chevron_right</span>
      </div>
      <div class="flex items-center gap-4 p-4 hover:bg-slate-50 transition-colors">
        <div class="flex items-center justify-center rounded-lg bg-[#ec5b13]/10 text-[#ec5b13] w-10 h-10">
          <span class="material-symbols-outlined">phone</span>
        </div>
        <div class="flex-1">
          <p class="text-xs text-slate-500">Phone Number</p>
          <p class="text-sm font-medium text-slate-900"><%= current_user.phone.presence || "Not provided" %></p>
        </div>
        <span class="material-symbols-outlined text-slate-300">chevron_right</span>
      </div>
    </div>
  </section>

  <%# Household Details %>
  <section>
    <h3 class="text-slate-500 text-xs font-bold uppercase tracking-widest px-2 mb-3">Household Details</h3>
    <div class="grid grid-cols-2 gap-3">
      <div class="bg-white p-4 rounded-xl border border-slate-200 flex flex-col gap-2 shadow-sm">
        <div class="text-[#ec5b13]"><span class="material-symbols-outlined">group</span></div>
        <div>
          <p class="text-sm font-bold text-slate-900"><%= current_user.family_size.presence || "N/A" %> Members</p>
          <p class="text-xs text-slate-500">Family Size</p>
        </div>
      </div>
      <div class="bg-white p-4 rounded-xl border border-slate-200 flex flex-col gap-2 shadow-sm">
        <div class="text-[#ec5b13]"><span class="material-symbols-outlined">delete_outline</span></div>
        <div>
          <% bucket_count = current_user.household&.pickups&.count || 0 %>
          <p class="text-sm font-bold text-slate-900"><%= [bucket_count, 1].max %> Buckets</p>
          <p class="text-xs text-slate-500">Active Units</p>
        </div>
      </div>
    </div>
  </section>

  <%# Collection Address %>
  <section>
    <h3 class="text-slate-500 text-xs font-bold uppercase tracking-widest px-2 mb-3">Collection Address</h3>
    <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm">
      <div class="h-32 w-full bg-slate-100 relative flex items-center justify-center">
        <span class="material-symbols-outlined text-4xl text-[#ec5b13] opacity-30">map</span>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
          <span class="material-symbols-outlined text-[#ec5b13] text-3xl">location_on</span>
        </div>
      </div>
      <div class="p-4 flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-slate-900"><%= current_user.address.presence || "No address provided" %></p>
        </div>
        <%= link_to edit_profile_path, class: "text-[#ec5b13] font-bold text-xs uppercase" do %>Change<% end %>
      </div>
    </div>
  </section>

  <%# Notification Preferences %>
  <section>
    <h3 class="text-slate-500 text-xs font-bold uppercase tracking-widest px-2 mb-3">Notification Preferences</h3>
    <div class="bg-white rounded-xl border border-slate-200 divide-y divide-slate-100 shadow-sm">
      <div class="flex items-center justify-between p-4">
        <div class="flex items-center gap-3">
          <span class="material-symbols-outlined text-slate-400">notifications_active</span>
          <p class="text-sm font-medium text-slate-900">Pickup Reminders</p>
        </div>
        <label class="relative inline-flex items-center cursor-pointer">
          <input checked type="checkbox" class="sr-only peer">
          <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#ec5b13]"></div>
        </label>
      </div>
      <div class="flex items-center justify-between p-4">
        <div class="flex items-center gap-3">
          <span class="material-symbols-outlined text-slate-400">account_balance_wallet</span>
          <p class="text-sm font-medium text-slate-900">Wallet Alerts</p>
        </div>
        <label class="relative inline-flex items-center cursor-pointer">
          <input checked type="checkbox" class="sr-only peer">
          <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#ec5b13]"></div>
        </label>
      </div>
      <div class="flex items-center justify-between p-4">
        <div class="flex items-center gap-3">
          <span class="material-symbols-outlined text-slate-400">bar_chart</span>
          <p class="text-sm font-medium text-slate-900">Weekly Eco Reports</p>
        </div>
        <label class="relative inline-flex items-center cursor-pointer">
          <input type="checkbox" class="sr-only peer">
          <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#ec5b13]"></div>
        </label>
      </div>
    </div>
  </section>

  <%# Security %>
  <section>
    <h3 class="text-slate-500 text-xs font-bold uppercase tracking-widest px-2 mb-3">Security</h3>
    <div class="bg-white rounded-xl border border-slate-200 divide-y divide-slate-100 shadow-sm">
      <%= link_to edit_profile_path, class: "flex items-center gap-4 p-4 hover:bg-slate-50 transition-colors" do %>
        <span class="material-symbols-outlined text-slate-400">lock</span>
        <p class="text-sm font-medium flex-1 text-slate-900">Change Password</p>
        <span class="material-symbols-outlined text-slate-300">chevron_right</span>
      <% end %>
    </div>
  </section>

  <%# Actions %>
  <div class="space-y-3">
    <%= link_to edit_profile_path, class: "w-full flex items-center justify-center gap-2 py-3 bg-[#ec5b13] text-white rounded-xl font-bold hover:brightness-110 transition-all shadow-lg shadow-[#ec5b13]/20" do %>
      <span class="material-symbols-outlined">edit</span>
      Edit Profile
    <% end %>
    <%= button_to destroy_user_session_path, method: :delete, class: "w-full flex items-center justify-center gap-2 h-12 rounded-xl bg-slate-100 text-red-600 font-bold text-sm hover:bg-red-50 transition-colors" do %>
      <span class="material-symbols-outlined text-xl">logout</span>
      Log Out
    <% end %>
    <p class="text-center text-[10px] text-slate-400 mt-4 uppercase tracking-widest">CleanCircle v2.4.0</p>
  </div>
</div>
