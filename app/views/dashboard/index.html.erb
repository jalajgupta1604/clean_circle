<%# Customer Dashboard %>
<% content_for(:page_title) { "Household Dashboard" } %>

<div class="space-y-6">
  <%# Welcome & Eco Score Row %>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    <%# Eco Score Gauge %>
    <div class="col-span-1 md:col-span-2 lg:col-span-1 bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex flex-col items-center justify-center text-center">
      <h3 class="text-slate-500 font-semibold mb-4">Eco Score</h3>
      <div class="relative flex items-center justify-center w-32 h-32">
        <svg class="w-full h-full transform -rotate-90" viewBox="0 0 128 128">
          <circle cx="64" cy="64" r="52" stroke="#e2e8f0" stroke-width="10" fill="none"/>
          <circle cx="64" cy="64" r="52" stroke="#ec5b13" stroke-width="10" fill="none"
                  stroke-dasharray="<%= (2 * Math::PI * 52).round(1) %>"
                  stroke-dashoffset="<%= ((1 - @eco_score / 100.0) * 2 * Math::PI * 52).round(1) %>"
                  stroke-linecap="round"/>
        </svg>
        <div class="absolute inset-0 flex flex-col items-center justify-center">
          <span class="text-3xl font-black text-slate-900"><%= @eco_score %></span>
          <span class="text-[10px] uppercase font-bold text-slate-400"><%= @eco_badge %></span>
        </div>
      </div>
      <p class="mt-4 text-xs font-medium text-emerald-500 flex items-center gap-1">
        <span class="material-symbols-outlined text-sm">trending_up</span> +5.2% from last month
      </p>
    </div>

    <%# Total Waste Volume Card %>
    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
      <div class="flex justify-between items-start mb-4">
        <div class="p-2 bg-blue-100 text-blue-600 rounded-lg">
          <span class="material-symbols-outlined">restore_from_trash</span>
        </div>
        <span class="text-xs font-bold text-slate-400 px-2 py-1 bg-slate-100 rounded">THIS MONTH</span>
      </div>
      <h3 class="text-slate-500 text-sm font-medium">Total Waste Volume</h3>
      <p class="text-3xl font-bold mt-1 text-slate-900"><%= @monthly_waste %> <span class="text-sm font-normal text-slate-400">L</span></p>
      <div class="mt-4 h-1.5 w-full bg-slate-100 rounded-full overflow-hidden">
        <div class="h-full bg-blue-500" style="width: 65%;"></div>
      </div>
      <p class="text-[10px] mt-2 text-slate-400 uppercase font-bold tracking-tighter">65% OF MONTHLY TARGET</p>
    </div>

    <%# Landfill Diversion Card %>
    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
      <div class="flex justify-between items-start mb-4">
        <div class="p-2 bg-emerald-100 text-emerald-600 rounded-lg">
          <span class="material-symbols-outlined">eco</span>
        </div>
        <span class="text-xs font-bold text-slate-400 px-2 py-1 bg-slate-100 rounded">REDUCTION</span>
      </div>
      <h3 class="text-slate-500 text-sm font-medium">Landfill Diversion</h3>
      <p class="text-3xl font-bold mt-1 text-slate-900"><%= [@eco_score + 10, 100].min %> <span class="text-sm font-normal text-slate-400">%</span></p>
      <div class="flex gap-1 mt-4 h-8 items-end">
        <div class="flex-1 bg-emerald-200 h-[40%] rounded-t-sm"></div>
        <div class="flex-1 bg-emerald-200 h-[60%] rounded-t-sm"></div>
        <div class="flex-1 bg-emerald-200 h-[55%] rounded-t-sm"></div>
        <div class="flex-1 bg-emerald-200 h-[75%] rounded-t-sm"></div>
        <div class="flex-1 bg-[#ec5b13] h-[90%] rounded-t-sm"></div>
      </div>
    </div>

    <%# Sustainability Badges Card %>
    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
      <h3 class="text-slate-500 text-sm font-medium mb-4">Sustainability Badges</h3>
      <div class="grid grid-cols-3 gap-2">
        <div class="aspect-square bg-amber-100 text-amber-600 rounded-lg flex items-center justify-center" title="Compost Champion">
          <span class="material-symbols-outlined">potted_plant</span>
        </div>
        <div class="aspect-square bg-purple-100 text-purple-600 rounded-lg flex items-center justify-center" title="Zero Waste Week">
          <span class="material-symbols-outlined">verified</span>
        </div>
        <div class="aspect-square bg-[#ec5b13]/10 text-[#ec5b13] rounded-lg flex items-center justify-center" title="Plastics Reducer">
          <span class="material-symbols-outlined">water_bottle</span>
        </div>
        <div class="aspect-square border-2 border-dashed border-slate-200 rounded-lg flex items-center justify-center text-slate-300">
          <span class="material-symbols-outlined">lock</span>
        </div>
        <div class="aspect-square border-2 border-dashed border-slate-200 rounded-lg flex items-center justify-center text-slate-300">
          <span class="material-symbols-outlined">lock</span>
        </div>
        <div class="aspect-square border-2 border-dashed border-slate-200 rounded-lg flex items-center justify-center text-slate-300">
          <span class="material-symbols-outlined">lock</span>
        </div>
      </div>
      <%= link_to rewards_path, class: "block w-full mt-4 text-xs font-bold text-[#ec5b13] hover:underline text-center" do %>VIEW ALL ACHIEVEMENTS<% end %>
    </div>
  </div>

  <%# Quick Stats Row %>
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
    <div class="bg-white rounded-xl border border-[#ec5b13]/5 p-4 shadow-sm">
      <div class="flex items-center gap-2 mb-1">
        <span class="material-symbols-outlined text-[#ec5b13] text-xl">account_balance_wallet</span>
        <p class="text-slate-500 text-xs font-semibold uppercase tracking-wider">Balance</p>
      </div>
      <p class="text-2xl font-bold text-slate-900">&#8377;<%= @wallet_balance %></p>
    </div>
    <div class="bg-white rounded-xl border border-[#ec5b13]/5 p-4 shadow-sm">
      <div class="flex items-center gap-2 mb-1">
        <span class="material-symbols-outlined text-blue-600 text-xl">card_membership</span>
        <p class="text-slate-500 text-xs font-semibold uppercase tracking-wider">Plan</p>
      </div>
      <p class="text-2xl font-bold text-slate-900"><%= @subscription&.subscription_plan&.name || "None" %></p>
    </div>
    <div class="bg-white rounded-xl border border-[#ec5b13]/5 p-4 shadow-sm">
      <div class="flex items-center gap-2 mb-1">
        <span class="material-symbols-outlined text-green-600 text-xl">local_shipping</span>
        <p class="text-slate-500 text-xs font-semibold uppercase tracking-wider">Pickups</p>
      </div>
      <p class="text-2xl font-bold text-slate-900"><%= @total_pickups %></p>
    </div>
    <div class="bg-white rounded-xl border border-[#ec5b13]/5 p-4 shadow-sm">
      <div class="flex items-center gap-2 mb-1">
        <span class="material-symbols-outlined text-purple-600 text-xl">delete_sweep</span>
        <p class="text-slate-500 text-xs font-semibold uppercase tracking-wider">Waste</p>
      </div>
      <p class="text-2xl font-bold text-slate-900"><%= @monthly_waste %> <span class="text-sm font-normal text-slate-400">L</span></p>
    </div>
  </div>

  <%# Main Content: Trends + Recent Pickups %>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <%# Waste Volume Trends %>
    <div class="lg:col-span-2 bg-white p-8 rounded-xl border border-slate-200 shadow-sm">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h3 class="text-xl font-bold text-slate-900">Waste Volume Trends</h3>
          <p class="text-slate-400 text-sm">Comparison between Recycling, Compost, and Landfill</p>
        </div>
        <%= link_to waste_tracking_path, class: "text-sm text-[#ec5b13] font-bold hover:underline" do %>View Details<% end %>
      </div>
      <div class="h-64 flex items-end gap-4 px-2">
        <% months = %w[Jan Feb Mar Apr May Jun] %>
        <% heights = [40, 60, 55, 75, 65, 50] %>
        <% months.each_with_index do |month, i| %>
          <div class="flex-1 flex flex-col items-center gap-2">
            <div class="w-full flex flex-col justify-end h-full gap-0.5">
              <div class="w-full bg-blue-400 rounded-t-sm" style="height: <%= heights[i] - 10 %>%"></div>
              <div class="w-full bg-green-400" style="height: <%= heights[i] / 3 %>%"></div>
              <div class="w-full bg-slate-300" style="height: <%= 100 - heights[i] - heights[i]/3 %>%"></div>
            </div>
            <span class="text-xs font-medium text-slate-400"><%= month %></span>
          </div>
        <% end %>
      </div>
      <div class="mt-8 flex flex-wrap gap-6 border-t border-slate-100 pt-6">
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 bg-blue-400 rounded-full"></div>
          <span class="text-sm font-medium text-slate-600">Recycling</span>
        </div>
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 bg-green-400 rounded-full"></div>
          <span class="text-sm font-medium text-slate-600">Compost</span>
        </div>
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 bg-slate-300 rounded-full"></div>
          <span class="text-sm font-medium text-slate-600">Landfill</span>
        </div>
      </div>
    </div>

    <%# Local Ranking %>
    <div class="bg-white p-8 rounded-xl border border-slate-200 shadow-sm flex flex-col">
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-xl font-bold text-slate-900">Local Ranking</h3>
        <span class="text-xs font-bold text-[#ec5b13]">YOUR AREA</span>
      </div>
      <div class="space-y-4 flex-1">
        <%# Rank entries %>
        <div class="flex items-center gap-4 p-3 rounded-lg bg-slate-50">
          <span class="text-amber-500 font-black italic">#1</span>
          <div class="w-8 h-8 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center text-xs font-bold">M</div>
          <div class="flex-1">
            <p class="text-sm font-bold text-slate-900">Top Household</p>
            <p class="text-[10px] text-slate-400">98 Score</p>
          </div>
          <div class="text-emerald-500"><span class="material-symbols-outlined text-sm">expand_less</span></div>
        </div>
        <div class="flex items-center gap-4 p-3 rounded-lg">
          <span class="text-slate-400 font-black italic">#2</span>
          <div class="w-8 h-8 rounded-full bg-slate-100 text-slate-600 flex items-center justify-center text-xs font-bold">J</div>
          <div class="flex-1">
            <p class="text-sm font-bold text-slate-900">Runner Up</p>
            <p class="text-[10px] text-slate-400">92 Score</p>
          </div>
          <div class="text-slate-400"><span class="material-symbols-outlined text-sm">remove</span></div>
        </div>
        <div class="flex items-center gap-4 p-3 rounded-lg ring-2 ring-[#ec5b13] bg-[#ec5b13]/5">
          <span class="text-[#ec5b13] font-black italic">#3</span>
          <div class="w-8 h-8 rounded-full bg-[#ec5b13] text-white flex items-center justify-center text-xs font-bold"><%= current_user.name&.first&.upcase %></div>
          <div class="flex-1">
            <p class="text-sm font-bold text-slate-900">You (<%= current_user.name&.split(' ')&.first %>)</p>
            <p class="text-[10px] text-[#ec5b13]"><%= @eco_score %> Score</p>
          </div>
          <div class="text-emerald-500"><span class="material-symbols-outlined text-sm">expand_less</span></div>
        </div>
      </div>
      <%= link_to leaderboard_path, class: "w-full mt-6 py-2 border border-slate-200 text-sm font-bold rounded-lg hover:bg-slate-50 transition-colors text-center block" do %>FULL LEADERBOARD<% end %>
    </div>
  </div>

  <%# Recent Pickups Table %>
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="px-8 py-6 border-b border-slate-200 flex justify-between items-center">
      <h3 class="text-xl font-bold text-slate-900">Recent Pickup History</h3>
      <%= link_to "Download Report", pickups_path, class: "text-sm text-[#ec5b13] font-bold hover:underline" %>
    </div>

    <% if @recent_pickups.present? %>
      <div class="overflow-x-auto">
        <table class="w-full text-left">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-8 py-4 text-xs font-bold text-slate-400 uppercase">Date</th>
              <th class="px-8 py-4 text-xs font-bold text-slate-400 uppercase">Service</th>
              <th class="px-8 py-4 text-xs font-bold text-slate-400 uppercase">Volume</th>
              <th class="px-8 py-4 text-xs font-bold text-slate-400 uppercase">Eco Status</th>
              <th class="px-8 py-4 text-xs font-bold text-slate-400 uppercase">Points</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @recent_pickups.each do |pickup| %>
              <tr class="hover:bg-slate-50 transition-colors cursor-pointer" onclick="window.location='<%= pickup_path(pickup) %>'">
                <td class="px-8 py-4 text-sm font-medium text-slate-900"><%= pickup.created_at.strftime("%b %d, %Y") %></td>
                <td class="px-8 py-4">
                  <span class="flex items-center gap-2 text-sm text-slate-700">
                    <span class="w-2 h-2 rounded-full
                      <%= case pickup.status
                          when 'completed' then 'bg-green-500'
                          when 'scheduled' then 'bg-blue-500'
                          when 'missed' then 'bg-red-500'
                          else 'bg-slate-400'
                          end %>"></span>
                    Pickup
                  </span>
                </td>
                <td class="px-8 py-4 text-sm text-slate-700"><%= pickup.estimated_volume %> L</td>
                <td class="px-8 py-4">
                  <span class="px-2 py-1 text-[10px] font-bold rounded uppercase
                    <%= case pickup.status
                        when 'completed' then 'bg-emerald-100 text-emerald-600'
                        when 'scheduled' then 'bg-blue-100 text-blue-600'
                        when 'missed' then 'bg-amber-100 text-amber-600'
                        else 'bg-slate-100 text-slate-600'
                        end %>">
                    <%= pickup.status.titleize %>
                  </span>
                </td>
                <td class="px-8 py-4 font-bold text-[#ec5b13]"><%= pickup.completed? ? "+#{(pickup.estimated_volume.to_f * 10).round(0)}" : "--" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="p-12 text-center">
        <span class="material-symbols-outlined text-4xl text-slate-300 mb-4">local_shipping</span>
        <p class="text-slate-500">No pickups yet. Your first pickup will appear here.</p>
      </div>
    <% end %>
  </div>
</div>
