<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6">
    <%= link_to pickups_path, class: "inline-flex items-center text-sm text-gray-500 hover:text-emerald-600 transition-colors" do %>
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      Back to Pickups
    <% end %>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
    <div class="px-6 py-5 border-b border-gray-200 bg-gradient-to-r from-emerald-50 to-teal-50">
      <h1 class="text-xl font-bold text-gray-900">Request On-Demand Pickup</h1>
      <p class="mt-1 text-sm text-gray-600">Request an extra waste collection outside your regular schedule</p>
    </div>

    <div class="p-6">
      <!-- Subscription Info -->
      <div class="mb-6 p-4 rounded-lg bg-emerald-50 border border-emerald-200">
        <div class="flex items-center gap-3">
          <svg class="w-5 h-5 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <div>
            <p class="font-medium text-emerald-800">Active Plan: <%= @subscription.subscription_plan.name %></p>
            <p class="text-sm text-emerald-600">Bucket size: <%= @subscription.subscription_plan.bucket_size %>L &middot; <%= @subscription.days_remaining %> days remaining</p>
          </div>
        </div>
      </div>

      <!-- Household Info -->
      <div class="mb-6 p-4 rounded-lg bg-gray-50 border border-gray-200">
        <p class="text-sm font-medium text-gray-700">Pickup Address</p>
        <p class="text-gray-900"><%= @household.address %></p>
        <% if @household.building_name.present? %>
          <p class="text-sm text-gray-500"><%= @household.building_name %><%= ", Unit #{@household.unit_number}" if @household.unit_number.present? %></p>
        <% end %>
      </div>

      <%= form_with url: pickups_path, method: :post, class: "space-y-5" do |f| %>
        <div>
          <%= f.label :notes, "Notes (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_area :notes, rows: 3, placeholder: "Any special instructions for the collection agent...", class: "block w-full rounded-lg border-gray-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500 text-sm" %>
        </div>

        <div class="p-4 rounded-lg bg-amber-50 border border-amber-200">
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-amber-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
            <div>
              <p class="text-sm font-medium text-amber-800">Pickup cost will be deducted from your wallet</p>
              <p class="text-xs text-amber-600">Based on your plan rate: ~<%= number_to_currency(@subscription.subscription_plan.price / 30.0, unit: "\u20B9", precision: 2) %> per pickup</p>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-3 pt-2">
          <%= f.submit "Request Pickup", class: "rounded-lg bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-emerald-500 cursor-pointer transition-colors" %>
          <%= link_to "Cancel", pickups_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
