<%# Pickup Details %>
<% content_for(:page_title) { "Pickup Details" } %>

<div class="max-w-3xl mx-auto space-y-6">
  <%# Back Link %>
  <div>
    <%= link_to pickups_path, class: "inline-flex items-center gap-1 text-sm text-slate-500 hover:text-[#ec5b13] transition-colors" do %>
      <span class="material-symbols-outlined text-lg">arrow_back</span>
      Back to Pickups
    <% end %>
  </div>

  <%# Status Hero Section %>
  <section class="p-6 text-center rounded-2xl
    <%= case @pickup.status
        when 'completed' then 'bg-gradient-to-b from-green-50 to-white'
        when 'scheduled' then 'bg-gradient-to-b from-blue-50 to-white'
        when 'missed' then 'bg-gradient-to-b from-red-50 to-white'
        else 'bg-gradient-to-b from-slate-50 to-white'
        end %>">
    <div class="inline-flex items-center px-4 py-2 rounded-full font-bold text-sm uppercase tracking-wider mb-4
      <%= case @pickup.status
          when 'completed' then 'bg-green-100 text-green-700'
          when 'scheduled' then 'bg-blue-100 text-blue-700'
          when 'in_progress' then 'bg-yellow-100 text-yellow-700'
          when 'missed' then 'bg-red-100 text-red-700'
          when 'cancelled' then 'bg-slate-100 text-slate-600'
          end %>">
      <span class="material-symbols-outlined text-lg mr-2"><%= @pickup.completed? ? 'check_circle' : 'schedule' %></span>
      <%= @pickup.status.titleize %>
    </div>
    <h2 class="text-2xl font-bold text-slate-800"><%= @pickup.created_at.strftime("%A, %b %d") %></h2>
    <p class="text-slate-500 font-medium"><%= @pickup.created_at.strftime("%I:%M %p") %></p>
  </section>

  <%# Key Metrics Grid %>
  <section class="grid grid-cols-2 gap-4">
    <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100">
      <p class="text-xs font-semibold text-slate-400 uppercase mb-1">Waste Volume</p>
      <p class="text-xl font-bold text-slate-800"><%= @pickup.estimated_volume %> <span class="text-sm font-medium text-slate-500">L</span></p>
    </div>
    <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100">
      <p class="text-xs font-semibold text-slate-400 uppercase mb-1">Status</p>
      <p class="text-xl font-bold text-slate-800"><%= @pickup.status.titleize %></p>
    </div>
    <% plan = @pickup.household&.user&.active_subscription&.subscription_plan %>
    <% if plan %>
      <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100">
        <p class="text-xs font-semibold text-slate-400 uppercase mb-1">Bucket Size</p>
        <p class="text-lg font-bold text-slate-800"><%= plan.bucket_size %>L <span class="text-sm font-medium text-slate-500"><%= plan.name %></span></p>
      </div>
    <% end %>
    <% if @pickup.completed? %>
      <div class="bg-green-600 p-4 rounded-2xl border border-green-700 shadow-md">
        <p class="text-xs font-semibold text-green-100 uppercase mb-1">CO2 Saved</p>
        <p class="text-xl font-bold text-white"><%= (@pickup.estimated_volume.to_f * 0.2).round(1) %> <span class="text-sm font-medium text-green-200">kg</span></p>
      </div>
    <% end %>
  </section>

  <%# Collector Info %>
  <section>
    <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wide mb-3">Your Collector</h3>
    <div class="flex items-center p-4 bg-white border border-slate-100 rounded-2xl shadow-sm">
      <div class="w-12 h-12 rounded-full bg-[#ec5b13] text-white flex items-center justify-center font-bold text-lg border-2 border-[#ec5b13]/20">
        <%= @pickup.agent&.name&.first&.upcase || "?" %>
      </div>
      <div class="ml-4">
        <p class="font-bold text-slate-800"><%= @pickup.agent&.name || "Not assigned" %></p>
        <p class="text-xs text-slate-500">Collection Agent</p>
      </div>
    </div>
  </section>

  <%# Details %>
  <section class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden divide-y divide-slate-100">
    <div class="flex items-center justify-between p-5">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 flex items-center justify-center rounded-lg bg-purple-100 text-purple-600">
          <span class="material-symbols-outlined">schedule</span>
        </div>
        <span class="text-sm font-medium text-slate-500">Scheduled Date</span>
      </div>
      <span class="font-semibold text-slate-900"><%= @pickup.created_at.strftime("%b %d, %Y") %></span>
    </div>

    <% if @pickup.confirmed_at.present? %>
      <div class="flex items-center justify-between p-5">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 flex items-center justify-center rounded-lg bg-green-100 text-green-600">
            <span class="material-symbols-outlined">check_circle</span>
          </div>
          <span class="text-sm font-medium text-slate-500">Collected At</span>
        </div>
        <span class="font-semibold text-slate-900"><%= @pickup.confirmed_at.strftime("%b %d, %Y at %I:%M %p") %></span>
      </div>
    <% end %>

    <% if @pickup.latitude.present? && @pickup.longitude.present? %>
      <div class="flex items-center justify-between p-5">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 flex items-center justify-center rounded-lg bg-red-100 text-red-600">
            <span class="material-symbols-outlined">location_on</span>
          </div>
          <div>
            <span class="text-sm font-medium text-slate-500">GPS Location</span>
            <span class="inline-flex items-center ml-2 px-2 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-700">
              <span class="material-symbols-outlined text-xs mr-1">verified</span>
              GPS Verified
            </span>
          </div>
        </div>
        <span class="font-semibold text-slate-900 text-sm"><%= @pickup.latitude %>, <%= @pickup.longitude %></span>
      </div>
    <% end %>

    <% if @pickup.notes.present? %>
      <div class="p-5">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-10 h-10 flex items-center justify-center rounded-lg bg-slate-100 text-slate-600">
            <span class="material-symbols-outlined">notes</span>
          </div>
          <span class="text-sm font-medium text-slate-500">Notes</span>
        </div>
        <div class="ml-13 bg-slate-50 rounded-xl p-4">
          <p class="text-slate-700 text-sm"><%= @pickup.notes %></p>
        </div>
      </div>
    <% end %>
  </section>

  <%# Environmental Impact %>
  <% if @pickup.completed? %>
    <div class="bg-emerald-50 border border-emerald-100 rounded-2xl p-5 flex items-start">
      <div class="bg-emerald-100 p-2 rounded-xl mr-4">
        <span class="material-symbols-outlined text-emerald-600">eco</span>
      </div>
      <div>
        <h4 class="font-bold text-emerald-900 mb-1">Impact for this pickup</h4>
        <p class="text-sm text-emerald-800 leading-relaxed">By diverting <%= @pickup.estimated_volume %>L from landfills, you saved approximately <%= (@pickup.estimated_volume.to_f * 0.2).round(1) %>kg of CO2 -- equivalent to driving a car <%= (@pickup.estimated_volume.to_f * 0.2 * 4.1).round(1) %> km.</p>
      </div>
    </div>
  <% end %>

  <%# Action Buttons %>
  <div class="flex flex-col gap-3">
    <%= link_to new_support_ticket_path, class: "w-full py-4 px-6 border border-slate-200 rounded-2xl text-slate-500 font-semibold hover:bg-slate-50 transition-colors flex items-center justify-center" do %>
      <span class="material-symbols-outlined mr-2">warning</span>
      Report an Issue
    <% end %>
  </div>
</div>
