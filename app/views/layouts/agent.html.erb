<!DOCTYPE html>
<html class="light" lang="en">
  <head>
    <title><%= content_for(:title) || "CleanCircle Collector Portal" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <style>
      body { font-family: 'Public Sans', sans-serif; }
      .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; vertical-align: middle; }
      .nav-active .material-symbols-outlined { font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
    </style>
  </head>

  <body class="bg-[#f8f6f6] text-slate-900 antialiased" style="font-family: 'Public Sans', sans-serif;">
    <div class="relative flex min-h-screen flex-col overflow-x-hidden">
      <%# Header %>
      <header class="flex items-center bg-[#f8f6f6] p-4 justify-between border-b border-[#ec5b13]/10">
        <div class="flex size-10 shrink-0 items-center overflow-hidden rounded-full">
          <% if current_user.respond_to?(:avatar_url) && current_user.avatar_url.present? %>
            <img class="h-full w-full object-cover" src="<%= current_user.avatar_url %>" alt="Profile photo">
          <% else %>
            <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-[#ec5b13]/10">
              <span class="material-symbols-outlined text-[#ec5b13]">person</span>
            </div>
          <% end %>
        </div>
        <div class="flex-1 px-3">
          <h2 class="text-[#ec5b13] text-lg font-bold leading-tight tracking-tight">CleanCircle</h2>
          <p class="text-slate-500 text-xs font-medium uppercase tracking-wider">Collector Portal</p>
        </div>
        <div class="flex items-center gap-2">
          <button class="flex size-10 items-center justify-center rounded-xl bg-[#ec5b13]/10 text-[#ec5b13]">
            <span class="material-symbols-outlined">notifications</span>
          </button>
          <%= button_to destroy_user_session_path, method: :delete, class: "flex size-10 items-center justify-center rounded-xl bg-slate-100 text-slate-500 hover:text-slate-700" do %>
            <span class="material-symbols-outlined">logout</span>
          <% end %>
        </div>
      </header>

      <% if notice.present? %>
        <div class="px-4 mt-3" data-controller="flash">
          <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl text-sm flex justify-between items-center" role="alert">
            <span><%= notice %></span>
            <button data-action="click->flash#dismiss" class="text-green-500 hover:text-green-700">&times;</button>
          </div>
        </div>
      <% end %>
      <% if alert.present? %>
        <div class="px-4 mt-3" data-controller="flash">
          <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl text-sm flex justify-between items-center" role="alert">
            <span><%= alert %></span>
            <button data-action="click->flash#dismiss" class="text-red-500 hover:text-red-700">&times;</button>
          </div>
        </div>
      <% end %>

      <main class="flex-1 overflow-y-auto pb-24">
        <%= yield %>
      </main>

      <%# Bottom Navigation %>
      <nav class="fixed bottom-0 left-0 right-0 z-50 flex items-center justify-around border-t border-slate-200 bg-white/80 backdrop-blur-lg px-4 pb-6 pt-3">
        <%= link_to agent_root_path, class: "flex flex-col items-center gap-1 #{request.path == agent_root_path ? 'text-[#ec5b13] nav-active' : 'text-slate-400'}" do %>
          <span class="material-symbols-outlined">home</span>
          <span class="text-[10px] font-bold uppercase tracking-widest">Home</span>
        <% end %>
        <%= link_to agent_routes_path, class: "flex flex-col items-center gap-1 #{request.path.start_with?(agent_routes_path) ? 'text-[#ec5b13] nav-active' : 'text-slate-400'}" do %>
          <span class="material-symbols-outlined">route</span>
          <span class="text-[10px] font-bold uppercase tracking-widest">Route</span>
        <% end %>
        <%= link_to agent_performance_path, class: "flex flex-col items-center gap-1 #{request.path == agent_performance_path ? 'text-[#ec5b13] nav-active' : 'text-slate-400'}" do %>
          <span class="material-symbols-outlined">analytics</span>
          <span class="text-[10px] font-bold uppercase tracking-widest">Stats</span>
        <% end %>
        <%= link_to edit_profile_path, class: "flex flex-col items-center gap-1 #{request.path == edit_profile_path ? 'text-[#ec5b13] nav-active' : 'text-slate-400'}" do %>
          <span class="material-symbols-outlined">person</span>
          <span class="text-[10px] font-bold uppercase tracking-widest">Profile</span>
        <% end %>
      </nav>
    </div>
  </body>
</html>
