<!DOCTYPE html>
<html class="h-full bg-gray-100">
  <head>
    <title><%= content_for(:title) || "CleanCircle Agent" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full">
    <nav class="bg-blue-700 shadow-lg">
      <div class="max-w-7xl mx-auto px-4">
        <div class="flex justify-between h-14">
          <div class="flex items-center space-x-1">
            <a href="<%= agent_root_path %>" class="text-white text-lg font-bold tracking-tight">
              CleanCircle Agent
            </a>
            <div class="hidden sm:flex ml-6 space-x-2">
              <%= link_to "Dashboard", agent_root_path,
                class: "text-blue-100 hover:bg-blue-600 hover:text-white px-3 py-2 rounded-md text-sm font-medium #{request.path == agent_root_path ? 'bg-blue-800 text-white' : ''}" %>
              <%= link_to "My Routes", agent_routes_path,
                class: "text-blue-100 hover:bg-blue-600 hover:text-white px-3 py-2 rounded-md text-sm font-medium #{request.path.start_with?(agent_routes_path) ? 'bg-blue-800 text-white' : ''}" %>
              <%= link_to "QR Scanner", agent_scan_path,
                class: "text-blue-100 hover:bg-blue-600 hover:text-white px-3 py-2 rounded-md text-sm font-medium #{request.path == agent_scan_path ? 'bg-blue-800 text-white' : ''}" %>
            </div>
          </div>
          <div class="flex items-center space-x-3">
            <span class="text-blue-100 text-sm hidden sm:inline"><%= current_user.name %></span>
            <%= button_to "Sign Out", destroy_user_session_path, method: :delete,
              class: "text-blue-100 hover:text-white text-sm bg-blue-800 hover:bg-blue-900 px-3 py-1.5 rounded-md" %>
          </div>
        </div>
      </div>

      <%# Mobile bottom nav %>
      <div class="sm:hidden fixed bottom-0 inset-x-0 bg-blue-700 border-t border-blue-600 z-50">
        <div class="flex justify-around py-2">
          <%= link_to agent_root_path, class: "flex flex-col items-center text-xs #{request.path == agent_root_path ? 'text-white' : 'text-blue-200'}" do %>
            <svg class="w-6 h-6 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0h4"/></svg>
            Dashboard
          <% end %>
          <%= link_to agent_routes_path, class: "flex flex-col items-center text-xs #{request.path.start_with?(agent_routes_path) ? 'text-white' : 'text-blue-200'}" do %>
            <svg class="w-6 h-6 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>
            Routes
          <% end %>
          <%= link_to agent_scan_path, class: "flex flex-col items-center text-xs #{request.path == agent_scan_path ? 'text-white' : 'text-blue-200'}" do %>
            <svg class="w-6 h-6 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"/></svg>
            Scanner
          <% end %>
        </div>
      </div>
    </nav>

    <% if notice.present? %>
      <div class="max-w-7xl mx-auto px-4 mt-3" data-controller="flash">
        <div class="bg-blue-50 border border-blue-200 text-blue-700 px-4 py-3 rounded-lg text-sm flex justify-between items-center" role="alert">
          <span><%= notice %></span>
          <button data-action="click->flash#dismiss" class="text-blue-500 hover:text-blue-700">&times;</button>
        </div>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="max-w-7xl mx-auto px-4 mt-3" data-controller="flash">
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm flex justify-between items-center" role="alert">
          <span><%= alert %></span>
          <button data-action="click->flash#dismiss" class="text-red-500 hover:text-red-700">&times;</button>
        </div>
      </div>
    <% end %>

    <main class="max-w-7xl mx-auto px-4 py-4 pb-20 sm:pb-6">
      <%= yield %>
    </main>
  </body>
</html>
