<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <title>CleanCircle Admin</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <%= stylesheet_link_tag :app %>
  <%= javascript_importmap_tags %>
  <style>
    body { font-family: 'Public Sans', sans-serif; }
    .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
  </style>
</head>
<body class="h-full" style="background-color: #f8f9f8; font-family: 'Public Sans', sans-serif;">
  <div class="min-h-full flex" data-controller="mobile-menu">
    <!-- Mobile sidebar overlay -->
    <div data-mobile-menu-target="overlay" class="fixed inset-0 z-40 hidden lg:hidden">
      <div class="fixed inset-0 bg-gray-600 bg-opacity-75" data-action="click->mobile-menu#close"></div>
      <div data-mobile-menu-target="sidebar" class="relative flex w-64 flex-col bg-white h-full transform -translate-x-full transition-transform duration-300 ease-in-out border-r border-slate-200">
        <div class="p-6 flex items-center gap-3">
          <div class="w-8 h-8 bg-[#2e7d32] rounded-lg flex items-center justify-center text-white">
            <span class="material-symbols-outlined text-xl">recycling</span>
          </div>
          <h1 class="text-xl font-bold tracking-tight text-slate-900">CleanCircle</h1>
          <button data-action="click->mobile-menu#close" class="ml-auto text-slate-400 hover:text-slate-600">
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>
        <nav class="flex-1 overflow-y-auto px-4 space-y-1">
        </nav>
      </div>
    </div>

    <!-- Desktop sidebar -->
    <aside class="hidden lg:flex lg:w-64 lg:flex-col lg:fixed lg:inset-y-0 bg-white border-r border-slate-200 z-50">
      <div class="p-6 flex items-center gap-3">
        <div class="w-8 h-8 bg-[#2e7d32] rounded-lg flex items-center justify-center text-white">
          <span class="material-symbols-outlined text-xl">recycling</span>
        </div>
        <h1 class="text-xl font-bold tracking-tight text-slate-900">CleanCircle</h1>
      </div>
      <nav class="flex-1 overflow-y-auto px-4 space-y-1">
        <% sidebar_links = [
          { name: "Dashboard", path: admin_path, icon: "dashboard" },
          { name: "Household Management", path: admin_households_path, icon: "home_work", match_paths: [admin_households_path] },
          { name: "Agent Management", path: admin_agents_path, icon: "badge", match_paths: [admin_agents_path] },
          { name: "Waste Analytics", path: admin_waste_analytics_path, icon: "analytics" },
          { name: "Reports", path: admin_performance_path, icon: "description" },
          { name: "Live Map", path: admin_live_map_path, icon: "location_on" },
          { name: "Report Automation", path: admin_report_automations_path, icon: "schedule_send" },
        ] %>
        <% sidebar_links.each do |link| %>
          <% active = (link[:name] == "Dashboard" && request.path == admin_path) ||
                      (link[:name] != "Dashboard" && request.path.start_with?(link[:path])) %>
          <%= link_to link[:path], class: "flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors duration-150 #{active ? 'bg-[#2e7d32]/10 text-[#2e7d32]' : 'text-slate-600 hover:bg-slate-100'}" do %>
            <span class="material-symbols-outlined"><%= link[:icon] %></span>
            <%= link[:name] %>
          <% end %>
        <% end %>

        <div class="pt-4 mt-4 border-t border-slate-100">
          <% extra_links = [
            { name: "Users", path: admin_users_path, icon: "group" },
            { name: "Routes", path: admin_routes_path, icon: "route" },
            { name: "Pickups", path: admin_pickups_path, icon: "local_shipping" },
            { name: "Plans", path: admin_subscription_plans_path, icon: "assignment" },
            { name: "Subscriptions", path: admin_subscriptions_path, icon: "card_membership" },
            { name: "Revenue", path: admin_revenue_path, icon: "payments" },
            { name: "Settings", path: admin_path, icon: "settings" },
          ] %>
          <% extra_links.each do |link| %>
            <% active = request.path.start_with?(link[:path]) && link[:path] != admin_path %>
            <%= link_to link[:path], class: "flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors duration-150 #{active ? 'bg-[#2e7d32]/10 text-[#2e7d32]' : 'text-slate-600 hover:bg-slate-100'}" do %>
              <span class="material-symbols-outlined"><%= link[:icon] %></span>
              <%= link[:name] %>
            <% end %>
          <% end %>
        </div>
      </nav>
      <div class="p-4 border-t border-slate-100">
        <div class="flex items-center gap-3 p-2 rounded-xl hover:bg-slate-50 transition-colors">
          <div class="w-10 h-10 rounded-full bg-[#2e7d32] flex items-center justify-center">
            <span class="text-sm font-semibold text-white"><%= current_user&.name&.first&.upcase || "A" %></span>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold text-slate-900 truncate"><%= current_user&.name || "Admin" %></p>
            <p class="text-xs text-slate-500 truncate">System Administrator</p>
          </div>
          <span class="material-symbols-outlined text-slate-400 text-sm">unfold_more</span>
        </div>
      </div>
    </aside>

    <!-- Main content -->
    <div class="flex-1 lg:ml-64 flex flex-col min-h-screen">
      <!-- Top bar -->
      <header class="sticky top-0 z-30 flex h-16 shrink-0 items-center justify-between border-b border-slate-200 bg-white/80 backdrop-blur-md px-4 lg:px-8">
        <div class="flex items-center gap-4">
          <button data-action="click->mobile-menu#toggle" class="text-slate-500 hover:text-slate-700 lg:hidden">
            <span class="material-symbols-outlined">menu</span>
          </button>
          <div class="relative hidden sm:block">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-lg">search</span>
            <input type="text" placeholder="Search data..." class="pl-10 pr-4 py-2 bg-white border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-[#2e7d32] focus:border-transparent outline-none w-64">
          </div>
        </div>
        <div class="flex items-center gap-4">
          <button class="p-2 rounded-xl bg-white border border-slate-200 text-slate-500 hover:bg-slate-50 relative transition-colors">
            <span class="material-symbols-outlined">notifications</span>
            <span class="absolute top-2 right-2 w-2 h-2 bg-red-500 rounded-full border-2 border-white"></span>
          </button>
          <%= link_to new_admin_pickup_path, class: "bg-[#2e7d32] hover:bg-[#2e7d32]/90 text-white px-4 py-2 rounded-xl text-sm font-semibold flex items-center gap-2" do %>
            <span class="material-symbols-outlined text-sm">add</span>
            New Pickup
          <% end %>
          <div class="h-8 w-px bg-slate-200 mx-1 hidden sm:block"></div>
          <div class="flex items-center gap-3">
            <div class="text-right hidden sm:block">
              <p class="text-xs font-bold leading-none text-slate-900"><%= current_user&.name || "Admin" %></p>
              <p class="text-[10px] text-slate-500 font-medium mt-1">Administrator</p>
            </div>
            <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "text-sm font-medium text-[#2e7d32] hover:text-[#1b5e20] transition-colors" do %>
              <span class="material-symbols-outlined text-lg">logout</span>
            <% end %>
          </div>
        </div>
      </header>

      <!-- Flash messages -->
      <% if notice.present? %>
        <div class="mx-4 mt-4 lg:mx-8" data-controller="flash">
          <div class="rounded-xl bg-green-50 border border-green-200 p-4">
            <div class="flex justify-between items-center">
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-green-600">check_circle</span>
                <p class="text-sm font-medium text-green-800"><%= notice %></p>
              </div>
              <button data-action="click->flash#dismiss" class="text-green-500 hover:text-green-700">
                <span class="material-symbols-outlined text-lg">close</span>
              </button>
            </div>
          </div>
        </div>
      <% end %>

      <% if alert.present? %>
        <div class="mx-4 mt-4 lg:mx-8" data-controller="flash">
          <div class="rounded-xl bg-red-50 border border-red-200 p-4">
            <div class="flex justify-between items-center">
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-red-600">error</span>
                <p class="text-sm font-medium text-red-800"><%= alert %></p>
              </div>
              <button data-action="click->flash#dismiss" class="text-red-500 hover:text-red-700">
                <span class="material-symbols-outlined text-lg">close</span>
              </button>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Page content -->
      <main class="flex-1 px-4 py-6 lg:px-8" style="background-color: #f8f9f8;">
        <%= yield %>
      </main>
    </div>
  </div>

</body>
</html>
