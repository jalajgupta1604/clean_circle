<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-100">
<head>
  <title>CleanCircle Admin</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag :app %>
  <%= javascript_importmap_tags %>
</head>
<body class="h-full">
  <div class="min-h-full">
    <!-- Mobile sidebar overlay -->
    <div id="mobile-sidebar-overlay" class="fixed inset-0 z-40 hidden">
      <div class="fixed inset-0 bg-gray-600 bg-opacity-75" data-action="click->admin-sidebar#close"></div>
      <div id="mobile-sidebar" class="relative flex w-64 flex-col bg-indigo-900 h-full transform -translate-x-full transition-transform duration-300 ease-in-out">
        <div class="flex items-center justify-between h-16 px-4 bg-indigo-950">
          <span class="text-xl font-bold text-white tracking-tight">CleanCircle</span>
          <button onclick="closeMobileSidebar()" class="text-indigo-300 hover:text-white">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>
        <nav class="flex-1 overflow-y-auto px-3 py-4 space-y-1">
        </nav>
      </div>
    </div>

    <!-- Desktop sidebar -->
    <div class="hidden lg:fixed lg:inset-y-0 lg:flex lg:w-64 lg:flex-col">
      <div class="flex min-h-0 flex-1 flex-col bg-indigo-900">
        <div class="flex items-center h-16 px-4 bg-indigo-950">
          <svg class="h-8 w-8 text-indigo-300 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
          </svg>
          <span class="text-xl font-bold text-white tracking-tight">CleanCircle</span>
        </div>
        <nav class="flex-1 overflow-y-auto px-3 py-4 space-y-1">
          <% sidebar_links = [
            { name: "Dashboard", path: admin_path, icon: "M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1" },
            { name: "Users", path: admin_users_path, icon: "M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" },
            { name: "Agents", path: admin_agents_path, icon: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" },
            { name: "Routes", path: admin_routes_path, icon: "M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" },
            { name: "Households", path: admin_households_path, icon: "M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0h6" },
            { name: "Pickups", path: admin_pickups_path, icon: "M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" },
            { name: "Plans", path: admin_subscription_plans_path, icon: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" },
            { name: "Subscriptions", path: admin_subscriptions_path, icon: "M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" },
            { name: "Revenue", path: admin_revenue_path, icon: "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" }
          ] %>
          <% sidebar_links.each do |link| %>
            <% active = request.path.start_with?(link[:path]) || (link[:name] == "Dashboard" && request.path == admin_path) %>
            <%= link_to link[:path], class: "group flex items-center px-3 py-2.5 text-sm font-medium rounded-lg transition-colors duration-150 #{active ? 'bg-indigo-800 text-white' : 'text-indigo-200 hover:bg-indigo-800 hover:text-white'}" do %>
              <svg class="mr-3 h-5 w-5 flex-shrink-0 <%= active ? 'text-white' : 'text-indigo-400 group-hover:text-white' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="<%= link[:icon] %>"/>
              </svg>
              <%= link[:name] %>
            <% end %>
          <% end %>
        </nav>
        <div class="flex-shrink-0 border-t border-indigo-800 p-4">
          <div class="flex items-center">
            <div class="h-9 w-9 rounded-full bg-indigo-700 flex items-center justify-center">
              <span class="text-sm font-medium text-white"><%= current_user&.name&.first&.upcase || "A" %></span>
            </div>
            <div class="ml-3">
              <p class="text-sm font-medium text-white"><%= current_user&.name || "Admin" %></p>
              <p class="text-xs text-indigo-300">Administrator</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Main content -->
    <div class="lg:pl-64">
      <!-- Top bar -->
      <div class="sticky top-0 z-30 flex h-16 shrink-0 items-center border-b border-gray-200 bg-white shadow-sm">
        <button onclick="openMobileSidebar()" class="px-4 text-gray-500 hover:text-gray-700 lg:hidden">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
        <div class="flex flex-1 items-center justify-between px-4 lg:px-8">
          <h1 class="text-lg font-semibold text-gray-900">CleanCircle Admin</h1>
          <div class="flex items-center space-x-4">
            <span class="text-sm text-gray-600"><%= current_user&.name || "Admin" %></span>
            <%= link_to "Sign Out", destroy_user_session_path, data: { turbo_method: :delete }, class: "text-sm font-medium text-indigo-600 hover:text-indigo-800 transition-colors" %>
          </div>
        </div>
      </div>

      <!-- Flash messages -->
      <% if notice.present? %>
        <div class="mx-4 mt-4 lg:mx-8">
          <div class="rounded-lg bg-green-50 border border-green-200 p-4">
            <div class="flex">
              <svg class="h-5 w-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <p class="ml-3 text-sm font-medium text-green-800"><%= notice %></p>
            </div>
          </div>
        </div>
      <% end %>

      <% if alert.present? %>
        <div class="mx-4 mt-4 lg:mx-8">
          <div class="rounded-lg bg-red-50 border border-red-200 p-4">
            <div class="flex">
              <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
              </svg>
              <p class="ml-3 text-sm font-medium text-red-800"><%= alert %></p>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Page content -->
      <main class="px-4 py-6 lg:px-8">
        <%= yield %>
      </main>
    </div>
  </div>

  <script>
    function openMobileSidebar() {
      const overlay = document.getElementById('mobile-sidebar-overlay');
      const sidebar = document.getElementById('mobile-sidebar');
      overlay.classList.remove('hidden');
      setTimeout(() => sidebar.classList.remove('-translate-x-full'), 10);
    }

    function closeMobileSidebar() {
      const overlay = document.getElementById('mobile-sidebar-overlay');
      const sidebar = document.getElementById('mobile-sidebar');
      sidebar.classList.add('-translate-x-full');
      setTimeout(() => overlay.classList.add('hidden'), 300);
    }
  </script>
</body>
</html>
