<!DOCTYPE html>
<html class="h-full bg-gray-50">
  <head>
    <title><%= content_for(:title) || "CleanCircle" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full">
    <% if user_signed_in? %>
      <nav class="bg-emerald-700 shadow-lg" data-controller="mobile-menu">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex justify-between h-16">
            <div class="flex items-center">
              <a href="<%= root_path %>" class="text-white text-xl font-bold tracking-tight">
                CleanCircle
              </a>
              <% if current_user.customer? %>
                <div class="hidden md:flex ml-10 space-x-4">
                  <%= link_to "Dashboard", root_path, class: "text-emerald-100 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %>
                  <%= link_to "Pickups", pickups_path, class: "text-emerald-100 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %>
                  <%= link_to "Wallet", wallet_path, class: "text-emerald-100 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %>
                  <%= link_to "Subscription", subscriptions_path, class: "text-emerald-100 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %>
                  <%= link_to "Waste Tracking", waste_tracking_path, class: "text-emerald-100 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %>
                  <%= link_to "Rewards", rewards_path, class: "text-emerald-100 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %>
                </div>
              <% end %>
            </div>
            <!-- Mobile menu button -->
            <button class="md:hidden text-emerald-100 hover:text-white" data-action="click->mobile-menu#toggle">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
            </button>

            <div class="hidden md:flex items-center space-x-4">
              <% if current_user.customer? %>
                <%= link_to notifications_path, class: "relative text-emerald-100 hover:text-white" do %>
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>
                  <% unread_count = current_user.notifications.unread.count %>
                  <% if unread_count > 0 %>
                    <span class="absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full w-4 h-4 flex items-center justify-center"><%= unread_count > 9 ? "9+" : unread_count %></span>
                  <% end %>
                <% end %>
              <% end %>
              <span class="text-emerald-100 text-sm"><%= current_user.name %></span>
              <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "text-emerald-100 hover:text-white text-sm bg-emerald-800 px-3 py-1.5 rounded-md" %>
            </div>
          </div>
        </div>
      </nav>

      <!-- Mobile menu overlay -->
      <div data-mobile-menu-target="overlay" class="hidden md:hidden fixed inset-0 z-40">
        <div class="fixed inset-0 bg-black/50" data-action="click->mobile-menu#close"></div>
        <div data-mobile-menu-target="sidebar" class="fixed inset-y-0 left-0 w-64 bg-emerald-800 transform -translate-x-full transition-transform duration-300 z-50">
          <div class="p-4 space-y-4">
            <div class="flex justify-between items-center mb-4">
              <span class="text-white font-bold text-lg">CleanCircle</span>
              <button data-action="click->mobile-menu#close" class="text-emerald-200 hover:text-white">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              </button>
            </div>
            <% if current_user.customer? %>
              <%= link_to "Dashboard", root_path, class: "block text-emerald-100 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %>
              <%= link_to "Pickups", pickups_path, class: "block text-emerald-100 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %>
              <%= link_to "Wallet", wallet_path, class: "block text-emerald-100 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %>
              <%= link_to "Subscription", subscriptions_path, class: "block text-emerald-100 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %>
              <%= link_to "Waste Tracking", waste_tracking_path, class: "block text-emerald-100 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %>
              <%= link_to "Rewards", rewards_path, class: "block text-emerald-100 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %>
              <%= link_to "Notifications", notifications_path, class: "block text-emerald-100 hover:text-white px-3 py-2 rounded-md text-sm font-medium" %>
            <% end %>
            <div class="border-t border-emerald-600 pt-4">
              <span class="block text-emerald-200 text-sm px-3 mb-2"><%= current_user.name %></span>
              <%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "w-full text-left text-emerald-100 hover:text-white text-sm bg-emerald-900 px-3 py-2 rounded-md" %>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <% if notice.present? %>
      <div class="max-w-7xl mx-auto px-4 mt-4" data-controller="flash">
        <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 px-4 py-3 rounded-lg flex justify-between items-center" role="alert">
          <span><%= notice %></span>
          <button data-action="click->flash#dismiss" class="text-emerald-500 hover:text-emerald-700">&times;</button>
        </div>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="max-w-7xl mx-auto px-4 mt-4" data-controller="flash">
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg flex justify-between items-center" role="alert">
          <span><%= alert %></span>
          <button data-action="click->flash#dismiss" class="text-red-500 hover:text-red-700">&times;</button>
        </div>
      </div>
    <% end %>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <%= yield %>
    </main>

    <% if !user_signed_in? || current_user.customer? %>
      <footer class="bg-gray-800 text-gray-400 py-8 mt-auto">
        <div class="max-w-7xl mx-auto px-4 text-center text-sm">
          <p>&copy; <%= Date.current.year %> CleanCircle. Building a cleaner tomorrow.</p>
        </div>
      </footer>
    <% end %>
  </body>
</html>
