<div class="space-y-6">
  <div class="flex items-center space-x-3">
    <%= link_to admin_households_path, class: "text-gray-400 hover:text-gray-600" do %>
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
    <% end %>
    <h2 class="text-2xl font-bold text-gray-900">Household Details</h2>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Household Info -->
    <div class="rounded-xl bg-white shadow ring-1 ring-gray-200 p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">Household Information</h3>
      <dl class="space-y-3">
        <div>
          <dt class="text-sm font-medium text-gray-500">Address</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @household.address %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">Created</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @household.created_at.strftime("%B %d, %Y") %></dd>
        </div>
      </dl>
    </div>

    <!-- User Info -->
    <div class="rounded-xl bg-white shadow ring-1 ring-gray-200 p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">User</h3>
      <% if @household.user.present? %>
        <dl class="space-y-3">
          <div>
            <dt class="text-sm font-medium text-gray-500">Name</dt>
            <dd class="mt-1 text-sm text-gray-900">
              <%= link_to @household.user.name, admin_user_path(@household.user), class: "text-indigo-600 hover:text-indigo-900" %>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Email</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @household.user.email %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Phone</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @household.user.phone || "N/A" %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Family Size</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @household.user.family_size || "N/A" %></dd>
          </div>
        </dl>
      <% else %>
        <p class="text-sm text-gray-500">No user assigned</p>
      <% end %>
    </div>

    <!-- Route Info -->
    <div class="rounded-xl bg-white shadow ring-1 ring-gray-200 p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">Route</h3>
      <% if @household.route.present? %>
        <dl class="space-y-3">
          <div>
            <dt class="text-sm font-medium text-gray-500">Route Name</dt>
            <dd class="mt-1 text-sm text-gray-900">
              <%= link_to @household.route.name, admin_route_path(@household.route), class: "text-indigo-600 hover:text-indigo-900" %>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Area</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @household.route.area %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Agent</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @household.route.agent&.name || "Unassigned" %></dd>
          </div>
        </dl>
      <% else %>
        <p class="text-sm text-gray-500">No route assigned</p>
      <% end %>
    </div>
  </div>

  <!-- Pickups History -->
  <div class="rounded-xl bg-white shadow ring-1 ring-gray-200 overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-200">
      <h3 class="text-lg font-semibold text-gray-900">Pickup History</h3>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">ID</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Agent</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Scheduled</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Completed</th>
            <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @household.pickups.order(created_at: :desc).each do |pickup| %>
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">#<%= pickup.id %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700"><%= pickup.agent&.name || "N/A" %></td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% status_classes = { "completed" => "bg-green-100 text-green-800", "pending" => "bg-yellow-100 text-yellow-800", "missed" => "bg-red-100 text-red-800", "in_progress" => "bg-blue-100 text-blue-800" } %>
                <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= status_classes[pickup.status] || 'bg-gray-100 text-gray-800' %>">
                  <%= pickup.status&.humanize %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= pickup.created_at&.strftime("%b %d, %Y %I:%M %p") %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= pickup.confirmed_at&.strftime("%b %d, %Y %I:%M %p") || "-" %></td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm">
                <%= link_to "View", admin_pickup_path(pickup), class: "text-indigo-600 hover:text-indigo-900 font-medium" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
