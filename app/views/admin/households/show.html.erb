<div class="space-y-6">
  <!-- Header with back navigation -->
  <div class="flex items-center gap-3">
    <%= link_to admin_households_path, class: "p-2 rounded-lg hover:bg-slate-100 text-slate-400 hover:text-slate-600 transition-colors" do %>
      <span class="material-symbols-outlined">arrow_back</span>
    <% end %>
    <div>
      <h2 class="text-2xl font-bold text-slate-900">Household Details</h2>
      <p class="text-sm text-slate-500"><%= @household.address %></p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Household Info -->
    <div class="rounded-xl bg-white shadow-sm border border-slate-200 p-6">
      <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-[#2e7d32]">home</span>
        <h3 class="text-lg font-bold text-slate-900">Household Information</h3>
      </div>
      <dl class="space-y-3">
        <div>
          <dt class="text-xs font-bold text-slate-400 uppercase tracking-wider">Address</dt>
          <dd class="mt-1 text-sm text-slate-900 font-medium"><%= @household.address %></dd>
        </div>
        <div>
          <dt class="text-xs font-bold text-slate-400 uppercase tracking-wider">Created</dt>
          <dd class="mt-1 text-sm text-slate-900"><%= @household.created_at.strftime("%B %d, %Y") %></dd>
        </div>
      </dl>
    </div>

    <!-- User Info -->
    <div class="rounded-xl bg-white shadow-sm border border-slate-200 p-6">
      <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-[#2e7d32]">person</span>
        <h3 class="text-lg font-bold text-slate-900">User</h3>
      </div>
      <% if @household.user.present? %>
        <dl class="space-y-3">
          <div>
            <dt class="text-xs font-bold text-slate-400 uppercase tracking-wider">Name</dt>
            <dd class="mt-1 text-sm">
              <%= link_to @household.user.name, admin_user_path(@household.user), class: "text-[#2e7d32] hover:underline font-semibold" %>
            </dd>
          </div>
          <div>
            <dt class="text-xs font-bold text-slate-400 uppercase tracking-wider">Email</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @household.user.email %></dd>
          </div>
          <div>
            <dt class="text-xs font-bold text-slate-400 uppercase tracking-wider">Phone</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @household.user.phone || "N/A" %></dd>
          </div>
          <div>
            <dt class="text-xs font-bold text-slate-400 uppercase tracking-wider">Family Size</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @household.user.family_size || "N/A" %></dd>
          </div>
        </dl>
      <% else %>
        <p class="text-sm text-slate-500">No user assigned</p>
      <% end %>
    </div>

    <!-- Route Info -->
    <div class="rounded-xl bg-white shadow-sm border border-slate-200 p-6">
      <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-[#2e7d32]">route</span>
        <h3 class="text-lg font-bold text-slate-900">Route</h3>
      </div>
      <% if @household.route.present? %>
        <dl class="space-y-3">
          <div>
            <dt class="text-xs font-bold text-slate-400 uppercase tracking-wider">Route Name</dt>
            <dd class="mt-1 text-sm">
              <%= link_to @household.route.name, admin_route_path(@household.route), class: "text-[#2e7d32] hover:underline font-semibold" %>
            </dd>
          </div>
          <div>
            <dt class="text-xs font-bold text-slate-400 uppercase tracking-wider">Area</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @household.route.area %></dd>
          </div>
          <div>
            <dt class="text-xs font-bold text-slate-400 uppercase tracking-wider">Agent</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @household.route.agent&.name || "Unassigned" %></dd>
          </div>
        </dl>
      <% else %>
        <p class="text-sm text-slate-500">No route assigned</p>
      <% end %>
    </div>
  </div>

  <!-- Subscription & Wallet Management -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Change Plan Section -->
    <div class="rounded-xl bg-white shadow-sm border border-slate-200 p-6">
      <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-[#2e7d32]">card_membership</span>
        <h3 class="text-lg font-bold text-slate-900">Subscription Plan</h3>
      </div>
      <% if @subscription.present? %>
        <dl class="space-y-3 mb-4">
          <div>
            <dt class="text-xs font-bold text-slate-400 uppercase tracking-wider">Current Plan</dt>
            <dd class="mt-1">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-green-100 text-green-700">
                <%= @subscription.subscription_plan.name %> (<%= @subscription.subscription_plan.bucket_size %>L)
              </span>
            </dd>
          </div>
          <div>
            <dt class="text-xs font-bold text-slate-400 uppercase tracking-wider">Status</dt>
            <dd class="mt-1">
              <% sub_status_classes = { "active" => "bg-green-100 text-green-700", "paused" => "bg-yellow-100 text-yellow-700", "cancelled" => "bg-red-100 text-red-700", "expired" => "bg-slate-100 text-slate-600" } %>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold <%= sub_status_classes[@subscription.status] || 'bg-slate-100 text-slate-600' %>">
                <%= @subscription.status.humanize %>
              </span>
            </dd>
          </div>
          <div>
            <dt class="text-xs font-bold text-slate-400 uppercase tracking-wider">End Date</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @subscription.ends_on.strftime("%B %d, %Y") %></dd>
          </div>
          <div>
            <dt class="text-xs font-bold text-slate-400 uppercase tracking-wider">Days Remaining</dt>
            <dd class="mt-1 text-sm text-slate-900"><%= @subscription.days_remaining %> days</dd>
          </div>
        </dl>
        <div class="border-t border-slate-100 pt-4">
          <p class="text-sm font-bold text-slate-700 mb-2">Change Plan</p>
          <%= form_with url: admin_subscription_path(@subscription), method: :patch, class: "flex items-end space-x-3" do |f| %>
            <div class="flex-1">
              <label for="subscription_plan_id" class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">New Plan</label>
              <select name="subscription[subscription_plan_id]" id="subscription_plan_id" class="block w-full rounded-xl border-slate-200 shadow-sm focus:border-[#2e7d32] focus:ring-[#2e7d32] text-sm">
                <% @subscription_plans.each do |plan| %>
                  <option value="<%= plan.id %>" <%= 'selected' if plan.id == @subscription.subscription_plan_id %>><%= plan.name %> - <%= number_to_currency(plan.price) %> (<%= plan.bucket_size %>L)</option>
                <% end %>
              </select>
            </div>
            <%= f.submit "Change Plan", class: "inline-flex items-center rounded-xl bg-[#2e7d32] px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-[#1b5e20] focus:outline-none focus:ring-2 focus:ring-[#2e7d32] focus:ring-offset-2 cursor-pointer transition-colors" %>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-slate-500">No active subscription</p>
      <% end %>
    </div>

    <!-- Adjust Wallet Section -->
    <div class="rounded-xl bg-white shadow-sm border border-slate-200 p-6">
      <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-[#2e7d32]">account_balance_wallet</span>
        <h3 class="text-lg font-bold text-slate-900">Wallet</h3>
      </div>
      <% if @wallet.present? %>
        <div class="mb-4">
          <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Current Balance</p>
          <p class="text-3xl font-black text-[#2e7d32] mt-1"><%= number_to_currency(@wallet.balance) %></p>
        </div>
        <div class="border-t border-slate-100 pt-4">
          <p class="text-sm font-bold text-slate-700 mb-2">Adjust Wallet</p>
          <%= form_with url: adjust_wallet_admin_household_path(@household), method: :post, class: "space-y-3" do |f| %>
            <div>
              <label for="amount" class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Amount</label>
              <input type="number" name="amount" id="amount" step="0.01" min="0.01" required class="block w-full rounded-xl border-slate-200 shadow-sm focus:border-[#2e7d32] focus:ring-[#2e7d32] text-sm" placeholder="0.00">
            </div>
            <div>
              <label for="transaction_type" class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Type</label>
              <select name="transaction_type" id="transaction_type" class="block w-full rounded-xl border-slate-200 shadow-sm focus:border-[#2e7d32] focus:ring-[#2e7d32] text-sm">
                <option value="credit">Credit (Add funds)</option>
                <option value="debit">Debit (Deduct funds)</option>
              </select>
            </div>
            <div>
              <label for="description" class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Description</label>
              <input type="text" name="description" id="description" class="block w-full rounded-xl border-slate-200 shadow-sm focus:border-[#2e7d32] focus:ring-[#2e7d32] text-sm" placeholder="Admin adjustment">
            </div>
            <%= f.submit "Submit Adjustment", class: "w-full inline-flex justify-center items-center rounded-xl bg-[#2e7d32] px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-[#1b5e20] focus:outline-none focus:ring-2 focus:ring-[#2e7d32] focus:ring-offset-2 cursor-pointer transition-colors" %>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-slate-500">No wallet found for this household</p>
      <% end %>
    </div>
  </div>

  <!-- Pickups History -->
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-100 flex items-center gap-2">
      <span class="material-symbols-outlined text-[#2e7d32]">history</span>
      <h3 class="text-lg font-bold text-slate-900">Pickup History</h3>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead class="bg-slate-50/50 text-[10px] uppercase tracking-wider text-slate-500 font-bold">
          <tr>
            <th class="px-6 py-4">ID</th>
            <th class="px-6 py-4">Agent</th>
            <th class="px-6 py-4">Status</th>
            <th class="px-6 py-4">Scheduled</th>
            <th class="px-6 py-4">Completed</th>
            <th class="px-6 py-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-sm">
          <% @household.pickups.order(created_at: :desc).each do |pickup| %>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="px-6 py-4 font-medium text-slate-900">#<%= pickup.id %></td>
              <td class="px-6 py-4 text-slate-700"><%= pickup.agent&.name || "N/A" %></td>
              <td class="px-6 py-4">
                <% status_config = {
                  "completed" => { dot: "bg-green-600", bg: "bg-green-100", text: "text-green-700" },
                  "pending" => { dot: "bg-yellow-600", bg: "bg-yellow-100", text: "text-yellow-700" },
                  "missed" => { dot: "bg-red-600", bg: "bg-red-100", text: "text-red-700" },
                  "in_progress" => { dot: "bg-blue-600", bg: "bg-blue-100", text: "text-blue-700" }
                } %>
                <% config = status_config[pickup.status] || { dot: "bg-slate-500", bg: "bg-slate-100", text: "text-slate-700" } %>
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold <%= config[:bg] %> <%= config[:text] %>">
                  <span class="w-1.5 h-1.5 rounded-full <%= config[:dot] %>"></span>
                  <%= pickup.status&.humanize %>
                </span>
              </td>
              <td class="px-6 py-4 text-slate-500 text-xs"><%= pickup.created_at&.strftime("%b %d, %Y %I:%M %p") %></td>
              <td class="px-6 py-4 text-slate-500 text-xs"><%= pickup.confirmed_at&.strftime("%b %d, %Y %I:%M %p") || "-" %></td>
              <td class="px-6 py-4 text-right">
                <%= link_to "View", admin_pickup_path(pickup), class: "text-[#2e7d32] hover:text-[#1b5e20] font-bold text-xs" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
