<div class="space-y-6">
  <!-- Page Title and Actions -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div>
      <h3 class="text-3xl font-black text-slate-900 tracking-tight">Subscribers</h3>
      <p class="text-slate-500 text-sm mt-1">Efficiently manage and monitor your sustainability network.</p>
    </div>
    <div class="flex items-center gap-3">
      <button class="flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 rounded-xl text-sm font-semibold hover:bg-slate-50 transition-colors">
        <span class="material-symbols-outlined text-lg">download</span>
        Export CSV
      </button>
    </div>
  </div>

  <!-- Filters -->
  <div class="flex flex-wrap items-center gap-3 pb-2">
    <%= link_to admin_households_path, class: "flex items-center gap-2 px-4 py-1.5 #{params[:plan].blank? ? 'bg-[#2e7d32] text-white' : 'bg-white border border-slate-200 text-slate-600 hover:border-[#2e7d32]/50'} rounded-full text-xs font-bold" do %>
      All Plans
    <% end %>
    <% if defined?(@subscription_plans) && @subscription_plans.present? %>
      <% @subscription_plans&.each do |plan| %>
        <%= link_to admin_households_path(plan: plan.id), class: "flex items-center gap-2 px-4 py-1.5 #{params[:plan].to_s == plan.id.to_s ? 'bg-[#2e7d32] text-white' : 'bg-white border border-slate-200 text-slate-600 hover:border-[#2e7d32]/50'} rounded-full text-xs font-semibold" do %>
          <%= plan.name %>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <!-- Data Table -->
  <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-200">
            <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Subscriber</th>
            <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Current Plan</th>
            <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Wallet Balance</th>
            <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">Last Pickup</th>
            <th class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @households.each do |household| %>
            <tr class="hover:bg-slate-50/50 transition-colors">
              <td class="px-6 py-4">
                <div class="flex flex-col">
                  <% if household.user.present? %>
                    <span class="text-sm font-bold text-slate-900"><%= household.user.name %></span>
                  <% end %>
                  <span class="text-xs text-slate-500"><%= household.address&.truncate(40) %></span>
                </div>
              </td>
              <td class="px-6 py-4">
                <% if household.user&.subscriptions&.last&.subscription_plan %>
                  <% plan = household.user.subscriptions.last&.subscription_plan %>
                  <% plan_colors = {
                    "10" => "bg-amber-100 text-amber-700",
                    "25" => "bg-green-100 text-green-700",
                    "50" => "bg-blue-100 text-blue-700"
                  } %>
                  <% size_key = plan.bucket_size.to_s %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold <%= plan_colors[size_key] || 'bg-slate-100 text-slate-700' %>">
                    <%= plan.name %>
                  </span>
                <% else %>
                  <span class="text-sm text-slate-400 italic">No plan</span>
                <% end %>
              </td>
              <td class="px-6 py-4">
                <% balance = household.user&.wallet&.balance.to_f %>
                <span class="text-sm font-semibold <%= balance < 0 ? 'text-red-500' : 'text-slate-700' %>">
                  <%= number_to_currency(balance) %>
                </span>
              </td>
              <td class="px-6 py-4">
                <% last_pickup = household.pickups.order(created_at: :desc).first %>
                <% if last_pickup %>
                  <span class="text-xs font-medium text-slate-600"><%= last_pickup.created_at.strftime("%b %d, %Y") %></span>
                <% else %>
                  <span class="text-xs text-slate-400 italic">No pickups</span>
                <% end %>
              </td>
              <td class="px-6 py-4 text-right">
                <div class="flex items-center justify-end gap-2">
                  <%= link_to admin_household_path(household), class: "px-3 py-1.5 text-xs font-bold text-[#2e7d32] hover:bg-[#2e7d32]/10 rounded-lg transition-colors" do %>
                    Manage
                  <% end %>
                  <%= link_to admin_household_path(household), class: "p-1.5 text-slate-400 hover:text-slate-600 rounded-lg" do %>
                    <span class="material-symbols-outlined text-xl">more_vert</span>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <!-- Pagination -->
    <% if defined?(@pagy) && @pagy %>
      <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex items-center justify-between">
        <p class="text-xs font-medium text-slate-500">Showing page <%= @pagy.page %> of <%= @pagy.pages %> (<%= @pagy.count %> households)</p>
        <div class="flex items-center gap-1">
          <%== pagy_nav(@pagy) %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Quick Stats Footer -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4">
    <div class="bg-[#2e7d32]/5 border border-[#2e7d32]/20 p-5 rounded-2xl">
      <p class="text-[10px] font-bold text-[#2e7d32] uppercase tracking-wider">Total Active Subscribers</p>
      <h4 class="text-2xl font-black mt-1"><%= number_with_delimiter(@households.count) %></h4>
      <div class="flex items-center gap-1 text-green-600 text-[10px] font-bold mt-2">
        <span class="material-symbols-outlined text-sm">trending_up</span>
        <span>Active this month</span>
      </div>
    </div>
    <div class="bg-white border border-slate-200 p-5 rounded-2xl">
      <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Network Waste Capacity</p>
      <h4 class="text-2xl font-black mt-1"><%= number_with_delimiter(@households.sum { |h| h.user&.subscriptions&.last&.subscription_plan&.bucket_size.to_i }) %>L</h4>
      <div class="w-full bg-slate-100 h-1.5 rounded-full mt-3 overflow-hidden">
        <div class="bg-[#2e7d32] h-full" style="width: 68%"></div>
      </div>
    </div>
    <div class="bg-white border border-slate-200 p-5 rounded-2xl">
      <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Total Ecosystem Wallet</p>
      <h4 class="text-2xl font-black mt-1"><%= number_to_currency(@households.sum { |h| h.user&.wallet&.balance.to_f }) %></h4>
      <p class="text-[10px] text-slate-500 mt-2 font-medium">Balance across all active users</p>
    </div>
  </div>
</div>
