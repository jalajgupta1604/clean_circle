<%# Bulk Plan Update Modal - triggered via Stimulus or Turbo %>
<div id="bulk-update-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm p-4 hidden" data-controller="modal">
  <div class="bg-white w-full max-w-2xl rounded-xl shadow-2xl border border-slate-200 overflow-hidden">
    <%# Modal Header %>
    <div class="px-8 py-6 border-b border-slate-100">
      <div class="flex justify-between items-start">
        <div>
          <h2 class="text-2xl font-bold text-slate-900">Bulk Update Subscription Plan</h2>
          <p class="text-slate-500 mt-1">Select a new plan for the selected households</p>
        </div>
        <button class="text-slate-400 hover:text-slate-600" data-action="click->modal#close" onclick="document.getElementById('bulk-update-modal').classList.add('hidden')">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
    </div>

    <%# Modal Content %>
    <%= form_tag bulk_update_admin_households_path, method: :post, id: "bulk-update-form" do %>
      <div id="bulk-update-household-ids"></div>

      <div class="p-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <% SubscriptionPlan.active.order(:price).each_with_index do |plan, idx| %>
            <label class="relative group cursor-pointer">
              <input type="radio" name="subscription_plan_id" value="<%= plan.id %>" class="peer absolute opacity-0" <%= 'checked' if idx == 0 %>>
              <div class="h-full flex flex-col p-5 rounded-xl border-2 border-slate-100 bg-slate-50/50 peer-checked:border-[#2e7d32] peer-checked:bg-[#2e7d32]/5 transition-all hover:border-slate-300">
                <div class="mb-4">
                  <h3 class="font-bold text-lg text-slate-900"><%= plan.name %></h3>
                  <div class="flex items-baseline gap-1 mt-1">
                    <span class="text-xl font-bold text-[#2e7d32]"><%= number_to_currency(plan.price, unit: "\u20B9") %></span>
                    <span class="text-xs text-slate-500 font-medium">/mo</span>
                  </div>
                </div>
                <div class="mt-auto space-y-2">
                  <p class="text-xs text-slate-500 leading-relaxed"><%= plan.description %></p>
                </div>
              </div>
              <div class="absolute top-3 right-3 opacity-0 peer-checked:opacity-100 text-[#2e7d32] transition-opacity">
                <span class="material-symbols-outlined text-2xl" style="font-variation-settings: 'FILL' 1">check_circle</span>
              </div>
            </label>
          <% end %>
        </div>
      </div>

      <%# Modal Footer %>
      <div class="px-8 py-6 bg-slate-50 border-t border-slate-100 flex flex-col sm:flex-row justify-end gap-3">
        <button type="button" onclick="document.getElementById('bulk-update-modal').classList.add('hidden')" class="px-6 py-2.5 rounded-xl border border-slate-300 text-slate-700 font-bold text-sm hover:bg-slate-100 transition-colors">
          Cancel
        </button>
        <button type="submit" class="px-6 py-2.5 rounded-xl bg-[#2e7d32] hover:bg-[#2e7d32]/90 text-white font-bold text-sm flex items-center justify-center gap-2 transition-all shadow-lg shadow-[#2e7d32]/20">
          <span class="material-symbols-outlined text-lg">check</span>
          <span>Apply to Selection</span>
        </button>
      </div>
    <% end %>
  </div>
</div>

<script>
  function openBulkUpdateModal(selectedIds) {
    var container = document.getElementById('bulk-update-household-ids');
    container.innerHTML = '';
    selectedIds.forEach(function(id) {
      var input = document.createElement('input');
      input.type = 'hidden';
      input.name = 'household_ids[]';
      input.value = id;
      container.appendChild(input);
    });
    document.getElementById('bulk-update-modal').classList.remove('hidden');
  }
</script>
