<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div class="flex items-center space-x-3">
      <%= link_to admin_agents_path, class: "text-gray-400 hover:text-gray-600" do %>
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
      <% end %>
      <h2 class="text-2xl font-bold text-gray-900"><%= @agent.name %></h2>
      <span class="inline-flex items-center rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800">Agent</span>
    </div>
  </div>

  <!-- Agent Info & Stats -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="rounded-xl bg-white shadow ring-1 ring-gray-200 p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">Agent Information</h3>
      <dl class="space-y-3">
        <div>
          <dt class="text-sm font-medium text-gray-500">Email</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @agent.email %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">Phone</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @agent.phone || "N/A" %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">Joined</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @agent.created_at.strftime("%B %d, %Y") %></dd>
        </div>
      </dl>
    </div>

    <!-- Performance Stats -->
    <div class="lg:col-span-2 grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div class="rounded-xl bg-white shadow ring-1 ring-gray-200 p-5">
        <p class="text-sm font-medium text-gray-500">Assigned Routes</p>
        <p class="mt-2 text-3xl font-bold text-indigo-600"><%= @agent.assigned_routes.count %></p>
      </div>
      <div class="rounded-xl bg-white shadow ring-1 ring-gray-200 p-5">
        <p class="text-sm font-medium text-gray-500">Today's Pickups</p>
        <p class="mt-2 text-3xl font-bold text-purple-600"><%= @agent.pickups.where(created_at: Date.today.all_day).count %></p>
      </div>
      <div class="rounded-xl bg-white shadow ring-1 ring-gray-200 p-5">
        <p class="text-sm font-medium text-gray-500">Completed Today</p>
        <p class="mt-2 text-3xl font-bold text-green-600"><%= @agent.pickups.where(created_at: Date.today.all_day, status: :completed).count %></p>
      </div>
      <div class="rounded-xl bg-white shadow ring-1 ring-gray-200 p-5">
        <p class="text-sm font-medium text-gray-500">Total Pickups</p>
        <p class="mt-2 text-3xl font-bold text-gray-900"><%= @agent.pickups.count %></p>
      </div>
    </div>
  </div>

  <!-- Assigned Routes -->
  <div class="rounded-xl bg-white shadow ring-1 ring-gray-200 overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-200">
      <h3 class="text-lg font-semibold text-gray-900">Assigned Routes</h3>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Route Name</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Area</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Households</th>
            <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @agent.assigned_routes.each do |route| %>
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= route.name %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700"><%= route.area %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700"><%= route.households.count %></td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm">
                <%= link_to "View", admin_route_path(route), class: "text-indigo-600 hover:text-indigo-900 font-medium" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
