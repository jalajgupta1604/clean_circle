<div class="space-y-6">
  <!-- Header -->
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-3">
      <%= link_to admin_agents_path, class: "p-2 rounded-lg hover:bg-slate-100 text-slate-400 hover:text-slate-600 transition-colors" do %>
        <span class="material-symbols-outlined">arrow_back</span>
      <% end %>
      <div class="flex items-center gap-3">
        <div class="w-12 h-12 rounded-full bg-[#2e7d32]/10 flex items-center justify-center">
          <span class="text-lg font-bold text-[#2e7d32]"><%= @agent.name&.first&.upcase %></span>
        </div>
        <div>
          <h2 class="text-2xl font-bold text-slate-900"><%= @agent.name %></h2>
          <div class="flex items-center gap-2 mt-1">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-[#2e7d32]/10 text-[#2e7d32]">Agent</span>
            <% if @agent_active %>
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-green-100 text-green-700">
                <span class="w-1.5 h-1.5 rounded-full bg-green-600 animate-pulse"></span>
                Active
              </span>
            <% else %>
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-600">
                <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                Inactive
              </span>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Agent Info & Stats -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="rounded-xl bg-white shadow-sm border border-slate-200 p-6">
      <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-[#2e7d32]">badge</span>
        <h3 class="text-lg font-bold text-slate-900">Agent Information</h3>
      </div>
      <dl class="space-y-3">
        <div>
          <dt class="text-xs font-bold text-slate-400 uppercase tracking-wider">Email</dt>
          <dd class="mt-1 text-sm text-slate-900"><%= @agent.email %></dd>
        </div>
        <div>
          <dt class="text-xs font-bold text-slate-400 uppercase tracking-wider">Phone</dt>
          <dd class="mt-1 text-sm text-slate-900"><%= @agent.phone || "N/A" %></dd>
        </div>
        <div>
          <dt class="text-xs font-bold text-slate-400 uppercase tracking-wider">Joined</dt>
          <dd class="mt-1 text-sm text-slate-900"><%= @agent.created_at.strftime("%B %d, %Y") %></dd>
        </div>
      </dl>
    </div>

    <!-- Performance Stats -->
    <div class="lg:col-span-2 grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div class="rounded-xl bg-white shadow-sm border border-slate-200 p-5 text-center">
        <div class="w-10 h-10 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center mx-auto mb-2">
          <span class="material-symbols-outlined">route</span>
        </div>
        <p class="text-2xl font-bold text-slate-900"><%= @agent.assigned_routes.count %></p>
        <p class="text-xs text-slate-500 font-medium">Assigned Routes</p>
      </div>
      <div class="rounded-xl bg-white shadow-sm border border-slate-200 p-5 text-center">
        <div class="w-10 h-10 rounded-full bg-purple-100 text-purple-600 flex items-center justify-center mx-auto mb-2">
          <span class="material-symbols-outlined">local_shipping</span>
        </div>
        <p class="text-2xl font-bold text-slate-900"><%= @agent.pickups.where(created_at: Date.today.all_day).count %></p>
        <p class="text-xs text-slate-500 font-medium">Today's Pickups</p>
      </div>
      <div class="rounded-xl bg-white shadow-sm border border-slate-200 p-5 text-center">
        <div class="w-10 h-10 rounded-full bg-green-100 text-green-600 flex items-center justify-center mx-auto mb-2">
          <span class="material-symbols-outlined">check_circle</span>
        </div>
        <p class="text-2xl font-bold text-slate-900"><%= @agent.pickups.where(created_at: Date.today.all_day, status: :completed).count %></p>
        <p class="text-xs text-slate-500 font-medium">Completed Today</p>
      </div>
      <div class="rounded-xl bg-white shadow-sm border border-slate-200 p-5 text-center">
        <div class="w-10 h-10 rounded-full bg-slate-100 text-slate-600 flex items-center justify-center mx-auto mb-2">
          <span class="material-symbols-outlined">inventory_2</span>
        </div>
        <p class="text-2xl font-bold text-slate-900"><%= @agent.pickups.count %></p>
        <p class="text-xs text-slate-500 font-medium">Total Pickups</p>
      </div>
    </div>
  </div>

  <!-- Performance Summary (This Month) -->
  <div class="rounded-xl bg-white shadow-sm border border-slate-200 p-6">
    <div class="flex items-center gap-2 mb-4">
      <span class="material-symbols-outlined text-[#2e7d32]">analytics</span>
      <h3 class="text-lg font-bold text-slate-900">Performance Summary (This Month)</h3>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
      <div class="text-center p-4 rounded-xl bg-[#2e7d32]/5 border border-[#2e7d32]/10">
        <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">Completion Rate</p>
        <p class="mt-2 text-3xl font-black text-[#2e7d32]"><%= @month_completion_rate %>%</p>
        <div class="w-full bg-slate-200 rounded-full h-1.5 mt-3">
          <div class="bg-[#2e7d32] h-1.5 rounded-full" style="width: <%= @month_completion_rate %>%"></div>
        </div>
      </div>
      <div class="text-center p-4 rounded-xl bg-green-50 border border-green-100">
        <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">Completed Pickups</p>
        <p class="mt-2 text-3xl font-black text-green-700"><%= @month_completed %></p>
      </div>
      <div class="text-center p-4 rounded-xl bg-red-50 border border-red-100">
        <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">Missed Pickups</p>
        <p class="mt-2 text-3xl font-black text-red-700"><%= @month_missed %></p>
      </div>
      <div class="text-center p-4 rounded-xl bg-slate-50 border border-slate-100">
        <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">Total Pickups</p>
        <p class="mt-2 text-3xl font-black text-slate-900"><%= @month_total_pickups %></p>
      </div>
    </div>
  </div>

  <!-- Assign Route -->
  <div class="rounded-xl bg-white shadow-sm border border-slate-200 p-6">
    <div class="flex items-center gap-2 mb-4">
      <span class="material-symbols-outlined text-[#2e7d32]">edit_road</span>
      <h3 class="text-lg font-bold text-slate-900">Assign Route</h3>
    </div>
    <% if @available_routes.any? %>
      <%= form_with url: assign_route_admin_agent_path(@agent), method: :post, class: "flex items-end space-x-3" do |f| %>
        <div class="flex-1">
          <label for="route_id" class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Select Route</label>
          <select name="route_id" id="route_id" class="block w-full rounded-xl border-slate-200 shadow-sm focus:border-[#2e7d32] focus:ring-[#2e7d32] text-sm">
            <% @available_routes.each do |route| %>
              <option value="<%= route.id %>"><%= route.name %> - <%= route.area %> (<%= route.agent_id.present? ? route.agent&.name : 'Unassigned' %>)</option>
            <% end %>
          </select>
        </div>
        <%= f.submit "Assign Route", class: "inline-flex items-center rounded-xl bg-[#2e7d32] px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-[#1b5e20] focus:outline-none focus:ring-2 focus:ring-[#2e7d32] focus:ring-offset-2 cursor-pointer transition-colors" %>
      <% end %>
    <% else %>
      <p class="text-sm text-slate-500">All routes are already assigned to this agent.</p>
    <% end %>
  </div>

  <!-- Assigned Routes -->
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-100 flex items-center gap-2">
      <span class="material-symbols-outlined text-[#2e7d32]">map</span>
      <h3 class="text-lg font-bold text-slate-900">Assigned Routes</h3>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead>
          <tr class="bg-slate-50 text-slate-500 text-xs font-bold uppercase tracking-wider">
            <th class="px-6 py-4">Route Name</th>
            <th class="px-6 py-4">Area</th>
            <th class="px-6 py-4">Households</th>
            <th class="px-6 py-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @agent.assigned_routes.each do |route| %>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="px-6 py-4 text-sm font-semibold text-slate-900"><%= route.name %></td>
              <td class="px-6 py-4 text-sm text-slate-700"><%= route.area %></td>
              <td class="px-6 py-4 text-sm text-slate-700"><%= route.households.count %></td>
              <td class="px-6 py-4 text-right">
                <%= link_to "View", admin_route_path(route), class: "text-[#2e7d32] hover:text-[#1b5e20] font-bold text-xs" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
