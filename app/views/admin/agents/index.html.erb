<div class="space-y-8">
  <!-- Header -->
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-3xl font-black text-slate-900 tracking-tight">Agent Management</h2>
      <p class="text-slate-500 text-sm mt-1">Monitor agent performance and route assignments.</p>
    </div>
  </div>

  <!-- Summary Cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
      <div class="flex justify-between items-start">
        <div>
          <p class="text-sm text-slate-500 font-medium">Total Agents</p>
          <h3 class="text-3xl font-bold mt-1"><%= @agents.count %></h3>
        </div>
        <div class="p-2 bg-blue-100 text-blue-600 rounded-lg">
          <span class="material-symbols-outlined">group</span>
        </div>
      </div>
      <div class="mt-4 flex items-center gap-1 text-green-600 text-sm font-semibold">
        <span class="material-symbols-outlined text-sm">trending_up</span>
        <span>+4% from last month</span>
      </div>
    </div>
    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
      <div class="flex justify-between items-start">
        <div>
          <p class="text-sm text-slate-500 font-medium">Active Today</p>
          <h3 class="text-3xl font-bold mt-1"><%= @agents.select { |a| a.assigned_routes.any? }.count %></h3>
        </div>
        <div class="p-2 bg-green-100 text-green-600 rounded-lg">
          <span class="material-symbols-outlined">bolt</span>
        </div>
      </div>
      <div class="mt-4 flex items-center gap-1 text-red-600 text-sm font-semibold">
        <span class="material-symbols-outlined text-sm">trending_down</span>
        <span>-2% from yesterday</span>
      </div>
    </div>
    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
      <div class="flex justify-between items-start">
        <div>
          <p class="text-sm text-slate-500 font-medium">Avg. Efficiency</p>
          <h3 class="text-3xl font-bold mt-1">96%</h3>
        </div>
        <div class="p-2 bg-[#2e7d32]/10 text-[#2e7d32] rounded-lg">
          <span class="material-symbols-outlined">leaderboard</span>
        </div>
      </div>
      <div class="mt-4 flex items-center gap-1 text-green-600 text-sm font-semibold">
        <span class="material-symbols-outlined text-sm">trending_up</span>
        <span>+1% overall</span>
      </div>
    </div>
  </div>

  <!-- Agent Performance Table -->
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between">
      <h3 class="font-bold text-lg">Agent Performance</h3>
      <div class="flex items-center gap-2">
        <button class="text-xs font-semibold px-3 py-1 bg-slate-100 rounded-full">All Agents</button>
        <button class="text-xs font-semibold px-3 py-1 text-slate-500">Active</button>
        <button class="text-xs font-semibold px-3 py-1 text-slate-500">Offline</button>
      </div>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead>
          <tr class="bg-slate-50 text-slate-500 text-xs font-bold uppercase tracking-wider">
            <th class="px-6 py-4">Agent Name</th>
            <th class="px-6 py-4">Assigned Route</th>
            <th class="px-6 py-4">Status</th>
            <th class="px-6 py-4">Performance</th>
            <th class="px-6 py-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200">
          <% @agents.each do |agent| %>
            <% total_pickups = agent.pickups.count %>
            <% completed_pickups = agent.pickups.where(status: "completed").count %>
            <% efficiency = total_pickups > 0 ? ((completed_pickups.to_f / total_pickups) * 100).round(0) : 0 %>
            <tr class="hover:bg-slate-50/50 transition-colors">
              <td class="px-6 py-4">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-[#2e7d32]/10 flex items-center justify-center">
                    <span class="text-sm font-bold text-[#2e7d32]"><%= agent.name&.first&.upcase %></span>
                  </div>
                  <div>
                    <p class="font-semibold text-sm text-slate-900"><%= agent.name %></p>
                    <p class="text-xs text-slate-500"><%= agent.email %></p>
                  </div>
                </div>
              </td>
              <td class="px-6 py-4">
                <% if agent.assigned_routes.any? %>
                  <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-slate-400 text-base">route</span>
                    <span class="text-sm"><%= agent.assigned_routes.first.name %></span>
                  </div>
                <% else %>
                  <div class="flex items-center gap-2 text-slate-400">
                    <span class="material-symbols-outlined text-base">route</span>
                    <span class="text-sm italic">Unassigned</span>
                  </div>
                <% end %>
              </td>
              <td class="px-6 py-4">
                <% if agent.assigned_routes.any? %>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-green-100 text-green-700">
                    <span class="w-1.5 h-1.5 rounded-full bg-green-600"></span>
                    On Route
                  </span>
                <% else %>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-700">
                    <span class="w-1.5 h-1.5 rounded-full bg-slate-500"></span>
                    Offline
                  </span>
                <% end %>
              </td>
              <td class="px-6 py-4">
                <div class="flex items-center gap-2">
                  <div class="flex-1 h-1.5 w-24 bg-slate-200 rounded-full overflow-hidden">
                    <div class="h-full bg-[#2e7d32]" style="width: <%= efficiency %>%"></div>
                  </div>
                  <span class="text-sm font-bold"><%= efficiency %>%</span>
                </div>
              </td>
              <td class="px-6 py-4 text-right">
                <div class="flex items-center justify-end gap-2">
                  <%= link_to admin_agent_path(agent), class: "p-2 hover:bg-slate-100 rounded-lg text-slate-500 transition-colors", title: "Assign Route" do %>
                    <span class="material-symbols-outlined text-lg">edit_road</span>
                  <% end %>
                  <%= link_to admin_agent_path(agent), class: "p-2 hover:bg-slate-100 rounded-lg text-slate-500 transition-colors", title: "View Stats" do %>
                    <span class="material-symbols-outlined text-lg">visibility</span>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if defined?(@pagy) && @pagy %>
      <div class="px-6 py-4 border-t border-slate-200 flex items-center justify-between text-sm text-slate-500">
        <p>Showing page <%= @pagy.page %> of <%= @pagy.pages %></p>
        <div class="flex items-center gap-2">
          <%== pagy_nav(@pagy) %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Footer Stats -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
      <h4 class="font-bold mb-4 flex items-center gap-2">
        <span class="material-symbols-outlined text-[#2e7d32]">eco</span>
        Environmental Impact Today
      </h4>
      <div class="space-y-4">
        <div class="flex justify-between items-center text-sm">
          <span class="text-slate-500">Recyclables Collected</span>
          <span class="font-bold"><%= @agents.sum { |a| a.pickups.where(created_at: Date.today.all_day, status: "completed").count } %> pickups</span>
        </div>
        <div class="w-full h-2 bg-slate-100 rounded-full">
          <div class="h-full bg-green-500 rounded-full" style="width: 75%"></div>
        </div>
        <div class="flex justify-between items-center text-sm">
          <span class="text-slate-500">Route Efficiency Score</span>
          <span class="font-bold text-green-600">A+</span>
        </div>
      </div>
    </div>
    <div class="bg-[#2e7d32]/5 p-6 rounded-xl border border-[#2e7d32]/20 shadow-sm">
      <h4 class="font-bold mb-4 flex items-center gap-2">
        <span class="material-symbols-outlined text-[#2e7d32]">tips_and_updates</span>
        Efficiency Tip
      </h4>
      <p class="text-sm text-slate-600 leading-relaxed">
        Based on today's data, re-routing agents on active routes could save approximately <strong class="text-slate-900">15%</strong> in fuel consumption and reduce collection times.
        <strong><%= @agents.select { |a| a.assigned_routes.any? }.count %></strong> agents currently on active routes.
        <strong><%= @agents.select { |a| a.assigned_routes.empty? }.count %></strong> agents are unassigned and available for route allocation.
      </p>
      <%= link_to admin_live_map_path, class: "mt-4 text-sm font-bold text-[#2e7d32] hover:underline flex items-center gap-1" do %>
        Optimize Routes Now
        <span class="material-symbols-outlined text-sm">arrow_forward</span>
      <% end %>
    </div>
  </div>
</div>
