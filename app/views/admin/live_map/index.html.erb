<%# Admin Live Route Optimization %>
<div class="-mx-4 -my-6 lg:-mx-8">
  <div class="flex" style="height: calc(100vh - 4rem);">
    <!-- Left Sidebar Navigation -->
    <aside class="w-64 border-r border-slate-200 bg-white p-4 flex flex-col justify-between shrink-0">
      <div class="flex flex-col gap-1">
        <p class="px-3 py-2 text-xs font-semibold text-slate-400 uppercase tracking-wider">Navigation</p>
        <%= link_to admin_path, class: "flex items-center gap-3 px-3 py-2 rounded-xl text-slate-600 hover:bg-slate-100" do %>
          <span class="material-symbols-outlined">dashboard</span>
          <span class="text-sm font-medium">Overview</span>
        <% end %>
        <%= link_to admin_live_map_path, class: "flex items-center gap-3 px-3 py-2 rounded-xl bg-[#2e7d32]/10 text-[#2e7d32]" do %>
          <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1">location_on</span>
          <span class="text-sm font-bold">Live Tracking</span>
        <% end %>
        <%= link_to admin_routes_path, class: "flex items-center gap-3 px-3 py-2 rounded-xl text-slate-600 hover:bg-slate-100" do %>
          <span class="material-symbols-outlined">route</span>
          <span class="text-sm font-medium">Optimization</span>
        <% end %>
        <%= link_to admin_agents_path, class: "flex items-center gap-3 px-3 py-2 rounded-xl text-slate-600 hover:bg-slate-100" do %>
          <span class="material-symbols-outlined">local_shipping</span>
          <span class="text-sm font-medium">Fleet Management</span>
        <% end %>
        <%= link_to admin_waste_analytics_path, class: "flex items-center gap-3 px-3 py-2 rounded-xl text-slate-600 hover:bg-slate-100" do %>
          <span class="material-symbols-outlined">eco</span>
          <span class="text-sm font-medium">Sustainability</span>
        <% end %>

        <div class="mt-6 pt-6 border-t border-slate-200">
          <p class="px-3 py-2 text-xs font-semibold text-slate-400 uppercase tracking-wider">Active Metrics</p>
          <div class="px-3 py-4 flex flex-col gap-4">
            <div class="bg-[#2e7d32]/5 rounded-xl p-3 border border-[#2e7d32]/10">
              <p class="text-xs text-slate-500">Total Distance Saved</p>
              <div class="flex items-end justify-between mt-1">
                <h4 class="text-xl font-bold"><%= @distance_saved %> <span class="text-xs font-medium">km</span></h4>
                <span class="text-xs font-bold text-[#2e7d32] flex items-center"><span class="material-symbols-outlined text-sm">trending_up</span> 12%</span>
              </div>
            </div>
            <div class="bg-[#2e7d32]/5 rounded-xl p-3 border border-[#2e7d32]/10">
              <p class="text-xs text-slate-500">CO2 Reduction</p>
              <div class="flex items-end justify-between mt-1">
                <h4 class="text-xl font-bold"><%= @co2_reduction %> <span class="text-xs font-medium">kg</span></h4>
                <span class="text-xs font-bold text-[#2e7d32] flex items-center"><span class="material-symbols-outlined text-sm">trending_up</span> 8%</span>
              </div>
            </div>
          </div>
        </div>
      </div>
      <button class="w-full bg-[#2e7d32] hover:bg-[#2e7d32]/90 text-white font-bold py-3 px-4 rounded-xl flex items-center justify-center gap-2 shadow-lg shadow-[#2e7d32]/20 transition-all active:scale-95">
        <span class="material-symbols-outlined text-sm">bolt</span>
        <span class="text-sm">Smart Optimize All</span>
      </button>
    </aside>

    <!-- Main Map Area -->
    <section class="flex-1 relative bg-slate-200 overflow-hidden">
      <div class="absolute inset-0 z-0">
        <div class="w-full h-full bg-gradient-to-br from-[#2e7d32]/5 via-emerald-50 to-teal-50">
          <!-- Map grid visualization -->
          <div class="absolute inset-0 p-8">
            <div class="w-full h-full relative border border-[#2e7d32]/10 rounded-lg bg-white/30">
              <% 5.times do |i| %>
                <div class="absolute w-full border-t border-[#2e7d32]/10" style="top: <%= i * 25 %>%"></div>
                <div class="absolute h-full border-l border-[#2e7d32]/10" style="left: <%= i * 25 %>%"></div>
              <% end %>

              <!-- SVG Route Lines -->
              <svg class="absolute inset-0 w-full h-full pointer-events-none">
                <path d="M100 200 L250 250 L400 220 L550 350" fill="none" opacity="0.6" stroke="#3b82f6" stroke-linecap="round" stroke-linejoin="round" stroke-width="4"></path>
                <path d="M300 400 L450 350 L600 420 L750 380" fill="none" opacity="0.6" stroke="#2e7d32" stroke-linecap="round" stroke-linejoin="round" stroke-width="4"></path>
                <path class="animate-pulse" d="M200 100 L280 180 L350 150 L420 250" fill="none" stroke="#ec5b13" stroke-linecap="round" stroke-linejoin="round" stroke-width="6"></path>
              </svg>

              <!-- Agent Markers on map -->
              <% @active_routes.each_with_index do |route, idx| %>
                <% positions = [[33, 25], [66, 50], [25, 60], [75, 30], [50, 75], [40, 40]] %>
                <% pos = positions[idx % positions.size] %>
                <div class="absolute transform -translate-x-1/2 -translate-y-1/2 z-10 group" style="left: <%= pos[0] %>%; top: <%= pos[1] %>%;">
                  <% is_recalculating = idx == 0 %>
                  <div class="<%= is_recalculating ? 'bg-orange-500 animate-pulse' : 'bg-[#2e7d32]' %> text-white p-2 rounded-full shadow-2xl flex items-center justify-center">
                    <span class="material-symbols-outlined">local_shipping</span>
                  </div>
                  <div class="absolute top-full left-1/2 -translate-x-1/2 mt-2 bg-white px-2 py-1 rounded shadow text-[10px] font-bold whitespace-nowrap">
                    <%= route.name %> (<%= is_recalculating ? "Recalculating..." : "On Schedule" %>)
                  </div>
                </div>
              <% end %>

              <% if @active_routes.empty? %>
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="text-center">
                    <span class="material-symbols-outlined text-[#2e7d32]/30 text-5xl mb-2">location_off</span>
                    <p class="text-sm text-[#2e7d32]/60">No active routes today</p>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Map Controls -->
      <div class="absolute top-6 right-6 flex flex-col gap-2 z-20">
        <div class="bg-white rounded-xl shadow-xl p-1 flex flex-col border border-slate-200">
          <button class="p-2 hover:bg-slate-100 rounded-lg text-slate-600">
            <span class="material-symbols-outlined">add</span>
          </button>
          <div class="h-px bg-slate-100 mx-2"></div>
          <button class="p-2 hover:bg-slate-100 rounded-lg text-slate-600">
            <span class="material-symbols-outlined">remove</span>
          </button>
        </div>
        <button class="bg-white rounded-xl shadow-xl p-3 border border-slate-200 text-slate-600 hover:text-[#2e7d32] transition-colors">
          <span class="material-symbols-outlined">my_location</span>
        </button>
        <button class="bg-white rounded-xl shadow-xl p-3 border border-slate-200 text-slate-600 hover:text-[#2e7d32] transition-colors">
          <span class="material-symbols-outlined">layers</span>
        </button>
      </div>

      <!-- Legend Card -->
      <div class="absolute bottom-6 left-6 z-20">
        <div class="bg-white/95 backdrop-blur shadow-2xl rounded-xl p-4 border border-slate-200 w-64">
          <h3 class="text-sm font-bold mb-3 flex items-center gap-2">
            <span class="material-symbols-outlined text-[#2e7d32] text-lg">info</span>
            Live Stats
          </h3>
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs text-slate-500">Active Routes</span>
              <span class="text-xs font-bold"><%= @active_count %> / <%= @total_routes %></span>
            </div>
            <div class="w-full bg-slate-200 h-1.5 rounded-full overflow-hidden">
              <div class="bg-[#2e7d32] h-full" style="width: <%= @total_routes > 0 ? (@active_count.to_f / @total_routes * 100).round : 0 %>%"></div>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-xs text-slate-500">Route Efficiency</span>
              <span class="text-xs font-bold text-[#2e7d32]"><%= @route_efficiency %>%</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-xs text-slate-500">Traffic Status</span>
              <span class="text-xs font-bold text-orange-500">Moderate</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Right Optimization Log Panel -->
    <aside class="w-80 border-l border-slate-200 bg-white flex flex-col shrink-0">
      <div class="p-6 border-b border-slate-100">
        <h3 class="font-bold flex items-center gap-2">
          <span class="material-symbols-outlined text-orange-500">auto_awesome</span>
          Optimization Log
        </h3>
        <p class="text-xs text-slate-400 mt-1">Real-time AI decisions</p>
      </div>
      <div class="flex-1 overflow-y-auto p-4 space-y-4">
        <% @recent_activity.each do |pickup| %>
          <% case pickup.status %>
          <% when "completed" %>
            <div class="flex gap-3">
              <div class="flex-shrink-0 mt-1">
                <span class="material-symbols-outlined text-slate-400 text-lg">check_circle</span>
              </div>
              <div class="flex flex-col">
                <p class="text-xs font-medium text-slate-500">Pickup completed: <%= pickup.household&.address&.truncate(25) %></p>
                <p class="text-[10px] text-slate-400"><%= pickup.updated_at.strftime("%I:%M %p") %> &bull; Agent: <%= pickup.agent&.name&.split&.first %></p>
              </div>
            </div>
          <% when "in_progress" %>
            <div class="bg-[#2e7d32]/5 border-l-2 border-[#2e7d32] p-3 rounded-r-lg">
              <div class="flex gap-3">
                <div class="flex-shrink-0">
                  <span class="material-symbols-outlined text-[#2e7d32] text-lg">autorenew</span>
                </div>
                <div class="flex flex-col">
                  <p class="text-xs font-bold text-slate-800 leading-tight">In progress: <%= pickup.agent&.name %></p>
                  <p class="text-[10px] font-semibold text-[#2e7d32] mt-1">Route: <%= pickup.route&.name %></p>
                  <p class="text-[10px] text-slate-400 mt-0.5"><%= pickup.updated_at.strftime("%I:%M %p") %> &bull; Active</p>
                </div>
              </div>
            </div>
          <% when "missed" %>
            <div class="flex gap-3">
              <div class="flex-shrink-0 mt-1">
                <span class="material-symbols-outlined text-orange-500 text-lg">warning</span>
              </div>
              <div class="flex flex-col">
                <p class="text-xs font-medium text-slate-700">Missed pickup at <%= pickup.household&.address&.truncate(25) %></p>
                <p class="text-[10px] text-slate-400"><%= pickup.updated_at.strftime("%I:%M %p") %> &bull; System Alert</p>
              </div>
            </div>
          <% else %>
            <div class="flex gap-3 opacity-70">
              <div class="flex-shrink-0 mt-1">
                <span class="material-symbols-outlined text-slate-300 text-lg">schedule</span>
              </div>
              <div class="flex flex-col">
                <p class="text-xs font-medium text-slate-500">Pickup #<%= pickup.id %> pending</p>
                <p class="text-[10px] text-slate-400"><%= pickup.updated_at.strftime("%I:%M %p") %> &bull; Queued</p>
              </div>
            </div>
          <% end %>
        <% end %>

        <% if @recent_activity.empty? %>
          <div class="p-8 text-center">
            <span class="material-symbols-outlined text-slate-300 text-3xl mb-2">inbox</span>
            <p class="text-sm text-slate-500">No recent activity</p>
          </div>
        <% end %>
      </div>
      <div class="p-6 bg-slate-50 border-t border-slate-100">
        <div class="flex flex-col gap-3">
          <div class="flex items-center justify-between text-xs">
            <span class="text-slate-500">Today's Total Impact</span>
            <span class="font-bold text-[#2e7d32]">-<%= @co2_reduction %> kg CO2</span>
          </div>
          <div class="flex items-center justify-between text-xs">
            <span class="text-slate-500">Avg. Delay</span>
            <span class="font-bold">2.4 mins</span>
          </div>
          <%= link_to admin_performance_path, class: "mt-2 w-full text-xs font-bold text-[#2e7d32] hover:underline flex items-center justify-center gap-1" do %>
            View Detailed Report <span class="material-symbols-outlined text-xs">arrow_forward</span>
          <% end %>
        </div>
      </div>
    </aside>
  </div>
</div>
