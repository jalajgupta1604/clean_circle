<div>
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Subscription Plans</h1>
    <%= link_to "New Plan", new_admin_subscription_plan_path, class: "bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700" %>
  </div>
  <div class="bg-white shadow rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Bucket Size</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Price</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Active</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @plans.each do |plan| %>
          <tr class="hover:bg-gray-50">
            <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= plan.name %></td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= plan.bucket_size %>L</td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= format_currency(plan.price) %></td>
            <td class="px-6 py-4 text-sm"><%= plan.active? ? "Yes" : "No" %></td>
            <td class="px-6 py-4 text-sm space-x-2">
              <%= link_to "Edit", edit_admin_subscription_plan_path(plan), class: "text-indigo-600 hover:text-indigo-900" %>
              <%= link_to "View", admin_subscription_plan_path(plan), class: "text-gray-600 hover:text-gray-900" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
