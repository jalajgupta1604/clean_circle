<%= form_with(model: [:admin, plan], class: "bg-white shadow rounded-lg p-6 space-y-4") do |f| %>
  <% if plan.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg">
      <ul class="list-disc list-inside text-sm"><% plan.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
    </div>
  <% end %>
  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :name, class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-4 py-3 border" %>
  </div>
  <div>
    <%= f.label :bucket_size, "Bucket Size (L)", class: "block text-sm font-medium text-gray-700" %>
    <%= f.number_field :bucket_size, min: 1, class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-4 py-3 border" %>
  </div>
  <div>
    <%= f.label :price, "Monthly Price (₹)", class: "block text-sm font-medium text-gray-700" %>
    <%= f.number_field :price, step: 0.01, min: 0, class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-4 py-3 border" %>
  </div>
  <div>
    <%= f.label :description, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_area :description, rows: 3, class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-4 py-3 border" %>
  </div>
  <div class="flex items-center">
    <%= f.check_box :active, class: "h-4 w-4 text-indigo-600 border-gray-300 rounded" %>
    <%= f.label :active, class: "ml-2 block text-sm text-gray-700" %>
  </div>
  <%= f.submit class: "bg-indigo-600 text-white px-6 py-2 rounded-lg hover:bg-indigo-700 cursor-pointer" %>
<% end %>
