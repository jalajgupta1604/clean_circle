<div class="max-w-2xl mx-auto">
  <h1 class="text-2xl font-bold text-gray-900 mb-6"><%= @plan.name %> Plan</h1>
  <div class="bg-white shadow rounded-lg p-6 space-y-4">
    <div><span class="text-sm font-medium text-gray-500">Bucket Size</span><p class="text-gray-900"><%= @plan.bucket_size %>L</p></div>
    <div><span class="text-sm font-medium text-gray-500">Price</span><p class="text-gray-900"><%= format_currency(@plan.price) %>/month</p></div>
    <div><span class="text-sm font-medium text-gray-500">Description</span><p class="text-gray-900"><%= @plan.description %></p></div>
    <div><span class="text-sm font-medium text-gray-500">Active</span><p class="text-gray-900"><%= @plan.active? ? "Yes" : "No" %></p></div>
    <div><span class="text-sm font-medium text-gray-500">Subscribers</span><p class="text-gray-900"><%= @plan.subscriptions.active.count %></p></div>
    <%= link_to "Edit", edit_admin_subscription_plan_path(@plan), class: "inline-block bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700" %>
  </div>
</div>
