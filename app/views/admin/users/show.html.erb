<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div class="flex items-center space-x-3">
      <%= link_to admin_users_path, class: "text-gray-400 hover:text-gray-600" do %>
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
      <% end %>
      <h2 class="text-2xl font-bold text-gray-900"><%= @user.name %></h2>
      <% role_classes = { "admin" => "bg-indigo-100 text-indigo-800", "agent" => "bg-green-100 text-green-800", "user" => "bg-gray-100 text-gray-800" } %>
      <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= role_classes[@user.role] || 'bg-gray-100 text-gray-800' %>">
        <%= @user.role&.capitalize %>
      </span>
    </div>
    <div class="flex space-x-3">
      <%= link_to "Edit", edit_admin_user_path(@user), class: "inline-flex items-center rounded-lg bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm ring-1 ring-gray-300 hover:bg-gray-50 transition-colors" %>
      <%= link_to "Delete", admin_user_path(@user), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this user?" }, class: "inline-flex items-center rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500 transition-colors" %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- User Info -->
    <div class="lg:col-span-2 rounded-xl bg-white shadow ring-1 ring-gray-200 p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">User Information</h3>
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4">
        <div>
          <dt class="text-sm font-medium text-gray-500">Full Name</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @user.name %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">Email</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @user.email %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">Phone</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @user.phone || "N/A" %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">Role</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @user.role&.capitalize %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">Address</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @user.address || "N/A" %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">Family Size</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @user.family_size || "N/A" %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">Created At</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @user.created_at.strftime("%B %d, %Y at %I:%M %p") %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">Updated At</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @user.updated_at.strftime("%B %d, %Y at %I:%M %p") %></dd>
        </div>
      </dl>
    </div>

    <!-- Sidebar Cards -->
    <div class="space-y-6">
      <!-- Wallet -->
      <div class="rounded-xl bg-white shadow ring-1 ring-gray-200 p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-3">Wallet</h3>
        <p class="text-3xl font-bold text-indigo-600"><%= number_to_currency(@user.wallet_balance || 0) %></p>
        <p class="text-sm text-gray-500 mt-1">Current Balance</p>
      </div>

      <!-- Subscription -->
      <div class="rounded-xl bg-white shadow ring-1 ring-gray-200 p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-3">Subscription</h3>
        <% if @user.subscription.present? %>
          <p class="text-sm font-medium text-gray-900"><%= @user.subscription.plan&.name %></p>
          <p class="text-sm text-gray-500 mt-1">Status:
            <span class="font-medium <%= @user.subscription.active? ? 'text-green-600' : 'text-red-600' %>">
              <%= @user.subscription.status&.capitalize %>
            </span>
          </p>
          <p class="text-sm text-gray-500 mt-1">Expires: <%= @user.subscription.expires_at&.strftime("%b %d, %Y") %></p>
          <%= link_to "View Subscription", admin_subscription_path(@user.subscription), class: "mt-3 inline-block text-sm text-indigo-600 hover:text-indigo-800 font-medium" %>
        <% else %>
          <p class="text-sm text-gray-500">No active subscription</p>
        <% end %>
      </div>

      <!-- Household -->
      <div class="rounded-xl bg-white shadow ring-1 ring-gray-200 p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-3">Household</h3>
        <% if @user.household.present? %>
          <p class="text-sm text-gray-900"><%= @user.household.address %></p>
          <p class="text-sm text-gray-500 mt-1">Route: <%= @user.household.route&.name || "Unassigned" %></p>
          <%= link_to "View Household", admin_household_path(@user.household), class: "mt-3 inline-block text-sm text-indigo-600 hover:text-indigo-800 font-medium" %>
        <% else %>
          <p class="text-sm text-gray-500">No household assigned</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
