<div class="space-y-8">
  <!-- Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <h2 class="text-3xl font-black tracking-tight text-slate-900">Waste Analytics</h2>
      <p class="text-slate-500">Track sustainability goals and waste distribution metrics.</p>
    </div>
    <div class="flex items-center gap-3">
      <div class="bg-white border border-slate-200 px-4 py-2 rounded-xl flex items-center gap-2 shadow-sm">
        <span class="material-symbols-outlined text-slate-400 text-lg">calendar_today</span>
        <span class="text-sm font-medium"><%= Date.today.beginning_of_month.strftime("%b %d, %Y") %> - <%= Date.today.end_of_month.strftime("%b %d, %Y") %></span>
        <span class="material-symbols-outlined text-slate-400 text-lg">expand_more</span>
      </div>
      <button class="bg-[#2e7d32] hover:bg-[#2e7d32]/90 text-white px-4 py-2 rounded-xl font-bold text-sm shadow-sm transition-all flex items-center gap-2">
        <span class="material-symbols-outlined text-lg">download</span>
        Export Report
      </button>
    </div>
  </div>

  <!-- Metrics Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
      <div class="flex items-center justify-between mb-2">
        <p class="text-sm font-medium text-slate-500">Total Waste Collected</p>
        <span class="material-symbols-outlined text-[#2e7d32]">delete_sweep</span>
      </div>
      <p class="text-2xl font-black"><%= number_with_delimiter(@total_waste.to_f.round(1)) %> L</p>
      <p class="text-sm text-green-600 mt-2 flex items-center gap-1 font-medium">
        <span class="material-symbols-outlined text-sm">trending_up</span> +12.5% from last month
      </p>
    </div>

    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
      <div class="flex items-center justify-between mb-2">
        <p class="text-sm font-medium text-slate-500">Avg. Recycling Rate</p>
        <span class="material-symbols-outlined text-[#2e7d32]">eco</span>
      </div>
      <p class="text-2xl font-black"><%= @pickup_stats[:completion_rate] %>%</p>
      <p class="text-sm text-green-600 mt-2 flex items-center gap-1 font-medium">
        <span class="material-symbols-outlined text-sm">trending_up</span> Completion rate
      </p>
    </div>

    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
      <div class="flex items-center justify-between mb-2">
        <p class="text-sm font-medium text-slate-500">Carbon Offset Eq.</p>
        <span class="material-symbols-outlined text-[#2e7d32]">co2</span>
      </div>
      <p class="text-2xl font-black"><%= number_with_delimiter(@environmental_impact[:co2_saved]) %> kg CO2e</p>
      <p class="text-sm text-green-600 mt-2 flex items-center gap-1 font-medium">
        <span class="material-symbols-outlined text-sm">trending_up</span> +8.4% from last month
      </p>
    </div>

    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
      <div class="flex items-center justify-between mb-2">
        <p class="text-sm font-medium text-slate-500">Top Performing Area</p>
        <span class="material-symbols-outlined text-[#2e7d32]">location_on</span>
      </div>
      <% top_area = @waste_by_area.max_by { |_, v| v } %>
      <p class="text-2xl font-black"><%= top_area&.first || "N/A" %></p>
      <p class="text-sm text-slate-400 mt-2 font-medium">Sustainability Lead</p>
    </div>
  </div>

  <!-- Charts Section -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Main Volume Chart -->
    <div class="lg:col-span-2 bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
      <div class="flex items-center justify-between mb-6">
        <h3 class="font-bold text-lg">Waste Volume by Category</h3>
        <div class="flex gap-4">
          <div class="flex items-center gap-1.5">
            <span class="w-3 h-3 rounded-full bg-[#2e7d32]"></span>
            <span class="text-xs text-slate-500">Recycling</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="w-3 h-3 rounded-full bg-[#81c784]"></span>
            <span class="text-xs text-slate-500">Compost</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="w-3 h-3 rounded-full bg-slate-800"></span>
            <span class="text-xs text-slate-500">Landfill</span>
          </div>
        </div>
      </div>
      <!-- Stacked bar chart visualization -->
      <div class="h-64 flex items-end gap-2 px-2 relative">
        <% weeks = ["Week 1", "Week 2", "Week 3", "Week 4"] %>
        <% recycling_pct = [40, 50, 55, 45] %>
        <% compost_pct = [30, 35, 25, 20] %>
        <% landfill_pct = [20, 25, 15, 30] %>
        <% weeks.each_with_index do |week, i| %>
          <div class="flex-1 flex flex-col justify-end gap-1 group">
            <div class="w-full bg-slate-800 rounded-t-sm" style="height: <%= landfill_pct[i] %>%"></div>
            <div class="w-full bg-[#81c784]" style="height: <%= compost_pct[i] %>%"></div>
            <div class="w-full bg-[#2e7d32]" style="height: <%= recycling_pct[i] %>%"></div>
            <span class="text-[10px] text-slate-400 mt-2 text-center"><%= week %></span>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Donut Ratio Chart -->
    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex flex-col">
      <h3 class="font-bold text-lg mb-6">Recycling vs. Landfill</h3>
      <div class="flex-1 flex items-center justify-center relative">
        <% recycling_rate = @pickup_stats[:completion_rate].to_i %>
        <% landfill_rate = 100 - recycling_rate %>
        <% stroke_offset = (502.0 * landfill_rate / 100).round %>
        <svg class="w-48 h-48 -rotate-90">
          <circle class="text-slate-100" cx="96" cy="96" fill="transparent" r="80" stroke="currentColor" stroke-width="16"></circle>
          <circle class="text-[#2e7d32]" cx="96" cy="96" fill="transparent" r="80" stroke="currentColor" stroke-dasharray="502" stroke-dashoffset="<%= stroke_offset %>" stroke-width="16"></circle>
        </svg>
        <div class="absolute inset-0 flex flex-col items-center justify-center">
          <span class="text-3xl font-black"><%= recycling_rate %>:<%= landfill_rate %></span>
          <span class="text-xs text-slate-500 uppercase font-bold tracking-wider">Ratio</span>
        </div>
      </div>
      <div class="mt-6 space-y-2">
        <div class="flex items-center justify-between text-sm">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#2e7d32]"></span>
            <span>Recyclable Matter</span>
          </div>
          <span class="font-bold"><%= recycling_rate %>%</span>
        </div>
        <div class="flex items-center justify-between text-sm">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#81c784]"></span>
            <span>Organic/Compost</span>
          </div>
          <span class="font-bold">20%</span>
        </div>
        <div class="flex items-center justify-between text-sm">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-slate-800"></span>
            <span>Non-recyclable</span>
          </div>
          <span class="font-bold"><%= landfill_rate %>%</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Regional & Trends -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Waste Generation by Sector -->
    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
      <h3 class="font-bold text-lg mb-4">Waste Generation by Sector</h3>
      <div class="relative h-64 rounded-lg overflow-hidden bg-slate-100">
        <!-- Map placeholder with sector indicators -->
        <div class="absolute inset-0 bg-gradient-to-br from-[#2e7d32]/5 to-emerald-50 flex items-center justify-center">
          <% @waste_by_area.first(3).each_with_index do |(area, volume), idx| %>
            <% positions = [[25, 33], [66, 25], [50, 66]] %>
            <div class="absolute" style="left: <%= positions[idx][0] %>%; top: <%= positions[idx][1] %>%;">
              <div class="w-<%= [8, 12, 6][idx] %> h-<%= [8, 12, 6][idx] %> bg-[#2e7d32]/<%= [40, 30, 50][idx] %> rounded-full border-2 border-[#2e7d32] flex items-center justify-center">
                <span class="text-[10px] font-bold text-[#2e7d32]"><%= volume.to_i %></span>
              </div>
            </div>
          <% end %>
        </div>
        <div class="absolute bottom-4 left-4 right-4 bg-white/90 p-3 rounded-lg backdrop-blur-sm border border-slate-200">
          <div class="flex justify-between items-center text-xs font-bold mb-2">
            <span>Sector Activity</span>
            <span class="text-[#2e7d32]">Live Data</span>
          </div>
          <div class="h-1.5 w-full bg-slate-200 rounded-full overflow-hidden">
            <div class="h-full bg-[#2e7d32] w-2/3"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Waste Reduction Trends -->
    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm overflow-hidden flex flex-col">
      <h3 class="font-bold text-lg mb-4">Waste Reduction Trends</h3>
      <div class="overflow-x-auto">
        <table class="w-full text-left">
          <thead>
            <tr class="border-b border-slate-100">
              <th class="pb-3 text-xs font-bold text-slate-500 uppercase">Neighborhood</th>
              <th class="pb-3 text-xs font-bold text-slate-500 uppercase">Trend</th>
              <th class="pb-3 text-xs font-bold text-slate-500 uppercase">Reduction %</th>
              <th class="pb-3 text-xs font-bold text-slate-500 uppercase">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @reduction_trend.first(4).each do |entry| %>
              <tr>
                <td class="py-4 text-sm font-medium"><%= entry[:month] %></td>
                <td class="py-4 text-sm">
                  <% if entry[:change_pct] <= 0 %>
                    <span class="material-symbols-outlined text-green-500">trending_down</span>
                  <% else %>
                    <span class="material-symbols-outlined text-[#2e7d32]">trending_up</span>
                  <% end %>
                </td>
                <td class="py-4 text-sm font-bold"><%= entry[:change_pct] > 0 ? "+" : "" %><%= entry[:change_pct] %>%</td>
                <td class="py-4 text-xs">
                  <% if entry[:change_pct] <= -10 %>
                    <span class="px-2 py-1 bg-green-100 text-green-700 rounded-full font-bold">Top Target Met</span>
                  <% elsif entry[:change_pct] < 0 %>
                    <span class="px-2 py-1 bg-green-100 text-green-700 rounded-full font-bold">On Track</span>
                  <% elsif entry[:change_pct] > 0 %>
                    <span class="px-2 py-1 bg-[#2e7d32]/10 text-[#2e7d32] rounded-full font-bold">Needs Review</span>
                  <% else %>
                    <span class="px-2 py-1 bg-slate-100 text-slate-700 rounded-full font-bold">Stable</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
            <% if @reduction_trend.empty? %>
              <tr>
                <td colspan="4" class="py-8 text-center text-sm text-slate-500">No trend data available yet.</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <%= link_to "#", class: "mt-4 text-sm text-[#2e7d32] font-bold hover:underline flex items-center gap-1" do %>
        View Detailed Neighborhood Analysis <span class="material-symbols-outlined text-sm">arrow_forward</span>
      <% end %>
    </div>
  </div>
</div>
