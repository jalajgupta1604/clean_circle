<% content_for(:title, "#{@report_automation.name} - CleanCircle Admin") %>

<div class="max-w-4xl mx-auto">
  <div class="mb-8">
    <%= link_to admin_report_automations_path, class: "flex items-center gap-2 text-[#2e7d32] mb-2" do %>
      <span class="material-symbols-outlined text-sm">arrow_back</span>
      <span class="text-xs font-bold uppercase tracking-wider">Back to Reports</span>
    <% end %>
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-extrabold tracking-tight"><%= @report_automation.name %></h1>
        <p class="text-slate-500 mt-1"><%= @report_automation.report_type.titleize %> &middot; <%= @report_automation.schedule.capitalize %> &middot; <%= @report_automation.format.upcase %></p>
      </div>
      <div class="flex items-center gap-3">
        <%= button_to run_admin_report_automation_path(@report_automation), method: :post, class: "flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#2e7d32] text-white text-sm font-bold hover:bg-[#2e7d32]/90 transition-all" do %>
          <span class="material-symbols-outlined text-sm">play_circle</span> Run Now
        <% end %>
        <%= link_to edit_admin_report_automation_path(@report_automation), class: "flex items-center gap-2 px-5 py-2.5 rounded-xl border border-slate-200 text-sm font-bold hover:bg-slate-50 transition-colors" do %>
          <span class="material-symbols-outlined text-sm">settings</span> Edit
        <% end %>
      </div>
    </div>
  </div>

  <%# Status & Schedule %>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
    <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-sm">
      <p class="text-xs font-semibold text-slate-500 uppercase">Status</p>
      <span class="inline-block mt-1 px-3 py-1 rounded-full text-xs font-bold <%= @report_automation.active? ? 'bg-green-100 text-green-700' : 'bg-slate-100 text-slate-500' %>">
        <%= @report_automation.status.capitalize %>
      </span>
    </div>
    <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-sm">
      <p class="text-xs font-semibold text-slate-500 uppercase">Last Run</p>
      <p class="mt-1 text-sm font-bold"><%= @report_automation.last_run_at ? @report_automation.last_run_at.strftime("%b %d, %Y %H:%M") : "Never" %></p>
    </div>
    <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-sm">
      <p class="text-xs font-semibold text-slate-500 uppercase">Next Run</p>
      <p class="mt-1 text-sm font-bold"><%= @report_automation.next_run_at ? @report_automation.next_run_at.strftime("%b %d, %Y") : "Not scheduled" %></p>
    </div>
    <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-sm">
      <p class="text-xs font-semibold text-slate-500 uppercase">Total Runs</p>
      <p class="mt-1 text-sm font-bold"><%= @report_automation.report_runs.count %></p>
    </div>
  </div>

  <%# Recent Runs %>
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-200">
      <h2 class="text-lg font-bold">Recent Runs</h2>
    </div>
    <% if @recent_runs.any? %>
      <table class="w-full text-left">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-200">
            <th class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase">Status</th>
            <th class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase">Started</th>
            <th class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase">Completed</th>
            <th class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase">File</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @recent_runs.each do |run| %>
            <tr>
              <td class="px-6 py-3">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold
                  <%= run.completed? ? 'bg-green-100 text-green-700' : run.failed? ? 'bg-red-100 text-red-700' : 'bg-yellow-100 text-yellow-700' %>">
                  <%= run.status.capitalize %>
                </span>
              </td>
              <td class="px-6 py-3 text-sm text-slate-600"><%= run.started_at&.strftime("%b %d, %H:%M") || "-" %></td>
              <td class="px-6 py-3 text-sm text-slate-600"><%= run.completed_at&.strftime("%b %d, %H:%M") || "-" %></td>
              <td class="px-6 py-3 text-sm text-slate-500"><%= run.file_path || "-" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="px-6 py-12 text-center text-sm text-slate-400">
        No runs yet. Click "Run Now" to generate a report.
      </div>
    <% end %>
  </div>
</div>
