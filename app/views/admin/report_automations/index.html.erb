<% content_for(:title, "Report Automation Settings - CleanCircle Admin") %>

<div class="max-w-[1200px] mx-auto">
  <%# Page Header %>
  <div class="flex flex-wrap justify-between items-end gap-4 mb-8">
    <div class="flex flex-col gap-2">
      <nav class="flex items-center gap-2 text-sm text-slate-500 mb-2">
        <%= link_to admin_performance_path, class: "hover:text-[#2e7d32]" do %>Operations & Business Reports<% end %>
        <span class="material-symbols-outlined text-xs">chevron_right</span>
        <span class="text-slate-900 font-medium">Automation Settings</span>
      </nav>
      <h1 class="text-slate-900 text-4xl font-black leading-tight tracking-tight">Report Automation Settings</h1>
      <p class="text-slate-500 text-base">Manage scheduled audits, performance logs, and stakeholder deliveries.</p>
    </div>
    <%= link_to new_admin_report_automation_path, class: "flex items-center gap-2 cursor-pointer rounded-xl h-11 px-6 bg-[#2e7d32] text-white text-sm font-bold hover:bg-[#2e7d32]/90 transition-all shadow-lg shadow-[#2e7d32]/20" do %>
      <span class="material-symbols-outlined">add</span>
      <span>Create New Automation</span>
    <% end %>
  </div>

  <%# Tabs %>
  <div class="mb-6 flex gap-4 border-b border-slate-200">
    <%= link_to "All Automations", admin_report_automations_path,
      class: "px-4 py-2 text-sm font-#{params[:status].blank? ? 'bold text-[#2e7d32] border-b-2 border-[#2e7d32]' : 'medium text-slate-500 hover:text-slate-700'}" %>
    <%= link_to "Active", admin_report_automations_path(status: "active"),
      class: "px-4 py-2 text-sm font-#{params[:status] == 'active' ? 'bold text-[#2e7d32] border-b-2 border-[#2e7d32]' : 'medium text-slate-500 hover:text-slate-700'}" %>
    <%= link_to "Paused", admin_report_automations_path(status: "paused"),
      class: "px-4 py-2 text-sm font-#{params[:status] == 'paused' ? 'bold text-[#2e7d32] border-b-2 border-[#2e7d32]' : 'medium text-slate-500 hover:text-slate-700'}" %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <%# Automations Table %>
    <div class="lg:col-span-2 space-y-4">
      <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <div class="overflow-x-auto">
          <table class="w-full text-left">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-200">
                <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Report Details</th>
                <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Schedule</th>
                <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Status</th>
                <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wider text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% @report_automations.each do |automation| %>
                <tr class="hover:bg-slate-50/50 transition-colors">
                  <td class="px-6 py-5">
                    <div class="flex flex-col">
                      <span class="text-sm font-bold text-slate-900"><%= automation.name %></span>
                      <span class="text-xs text-slate-500 mt-1">Recipients: <%= automation.recipients_list.first(2).join(", ") %></span>
                      <div class="flex gap-2 mt-2">
                        <span class="px-2 py-0.5 rounded bg-[#2e7d32]/10 text-[#2e7d32] text-[10px] font-bold uppercase tracking-wider"><%= automation.format.upcase %></span>
                        <span class="px-2 py-0.5 rounded bg-slate-100 text-slate-500 text-[10px] font-bold uppercase tracking-wider"><%= automation.schedule.capitalize %></span>
                      </div>
                    </div>
                  </td>
                  <td class="px-6 py-5">
                    <div class="flex flex-col">
                      <span class="text-sm text-slate-700">Next: <%= automation.next_run_at ? automation.next_run_at.strftime("%b %d, %Y") : "Not scheduled" %></span>
                      <span class="text-xs text-slate-400 italic mt-1"><%= automation.last_run_status %></span>
                    </div>
                  </td>
                  <td class="px-6 py-5">
                    <%= button_to toggle_status_admin_report_automation_path(automation), method: :patch, class: "relative inline-flex items-center cursor-pointer" do %>
                      <div class="w-11 h-6 rounded-full transition-colors <%= automation.active? ? 'bg-[#2e7d32]' : 'bg-slate-200' %>">
                        <div class="absolute top-[2px] bg-white border border-gray-300 rounded-full h-5 w-5 transition-transform <%= automation.active? ? 'translate-x-[22px]' : 'translate-x-[2px]' %>"></div>
                      </div>
                    <% end %>
                  </td>
                  <td class="px-6 py-5 text-right">
                    <div class="flex justify-end gap-3">
                      <%= button_to run_admin_report_automation_path(automation), method: :post, class: "text-slate-400 hover:text-[#2e7d32] transition-colors", title: "Run Manually" do %>
                        <span class="material-symbols-outlined text-xl">play_circle</span>
                      <% end %>
                      <%= link_to edit_admin_report_automation_path(automation), class: "text-slate-400 hover:text-[#2e7d32] transition-colors", title: "Edit Settings" do %>
                        <span class="material-symbols-outlined text-xl">settings</span>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>

              <% if @report_automations.empty? %>
                <tr>
                  <td colspan="4" class="px-6 py-12 text-center text-sm text-slate-400">
                    No report automations configured yet. Create one to get started.
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
    </div>

    <%# Sidebar %>
    <div class="space-y-6">
      <%# Global Email Config %>
      <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h3 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
          <span class="material-symbols-outlined text-[#2e7d32]">mail</span>
          Global Email Config
        </h3>
        <div class="space-y-4">
          <div>
            <label class="block text-xs font-semibold text-slate-500 uppercase mb-1">Sender Name</label>
            <input class="w-full rounded-lg border-slate-200 text-sm focus:border-[#2e7d32] focus:ring-[#2e7d32]" type="text" value="CleanCircle Auto-Reporting" disabled>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-500 uppercase mb-1">Reply-to Address</label>
            <input class="w-full rounded-lg border-slate-200 text-sm focus:border-[#2e7d32] focus:ring-[#2e7d32]" type="email" value="reports@cleancircle.com" disabled>
          </div>
          <div class="pt-2">
            <label class="flex items-center gap-2 cursor-pointer">
              <input checked class="rounded text-[#2e7d32] focus:ring-[#2e7d32] border-slate-300" type="checkbox" disabled>
              <span class="text-sm text-slate-600">Attach branded cover page</span>
            </label>
          </div>
          <button class="w-full mt-2 py-2 text-xs font-bold text-slate-600 bg-slate-100 rounded-lg hover:bg-slate-200 transition-colors">
            Update Configuration
          </button>
        </div>
      </div>

      <%# Report Branding %>
      <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h3 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
          <span class="material-symbols-outlined text-[#2e7d32]">palette</span>
          Report Branding
        </h3>
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-sm text-slate-600">Primary Color</span>
            <div class="w-6 h-6 rounded bg-[#2e7d32] border border-slate-200"></div>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-slate-600">Font Family</span>
            <span class="text-sm font-medium text-slate-900">Public Sans</span>
          </div>
          <div class="pt-2">
            <p class="text-xs text-slate-500 mb-2">Company Logo</p>
            <div class="w-full h-24 rounded-lg bg-slate-50 flex items-center justify-center border-2 border-dashed border-slate-200 overflow-hidden relative">
              <div class="flex flex-col items-center gap-1">
                <span class="material-symbols-outlined text-slate-400">image</span>
                <span class="text-[10px] text-slate-400">Click to change</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <%# Reporting Statistics %>
      <div class="rounded-xl bg-gradient-to-br from-[#2e7d32]/10 to-[#2e7d32]/5 p-6 border border-[#2e7d32]/20">
        <div class="flex items-start gap-4">
          <span class="material-symbols-outlined text-[#2e7d32]">info</span>
          <div>
            <h4 class="text-sm font-bold text-slate-900">Reporting Statistics</h4>
            <p class="text-xs text-slate-600 mt-1 leading-relaxed">
              <%= @stats[:runs_this_month] %> reports generated this month. <%= @stats[:success_rate] %>% delivery success rate.
              Average delivery time: 1.4s.
            </p>
            <p class="text-xs text-slate-500 mt-2"><%= @stats[:active] %> active automations of <%= @stats[:total] %> total.</p>
            <a class="inline-block mt-3 text-xs font-bold text-[#2e7d32] hover:underline" href="#">View Analytics</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
