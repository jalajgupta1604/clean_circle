<div class="space-y-8">
  <!-- Header -->
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-2xl font-bold text-slate-900">Dashboard Overview</h2>
      <p class="text-slate-500 text-sm">Welcome back, <%= current_user&.name || "Admin" %>. Here's what's happening today.</p>
    </div>
  </div>

  <!-- Metric Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
    <div class="bg-white p-5 rounded-xl border border-slate-100 shadow-sm">
      <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Total Households</p>
      <div class="flex items-end justify-between">
        <h3 class="text-2xl font-bold text-slate-900"><%= number_with_delimiter(@total_households) %></h3>
        <span class="text-xs font-bold text-[#2e7d32] flex items-center gap-1">
          <span class="material-symbols-outlined text-sm">trending_up</span> 12%
        </span>
      </div>
    </div>

    <div class="bg-white p-5 rounded-xl border border-slate-100 shadow-sm">
      <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Pickups Today</p>
      <div class="flex items-end justify-between">
        <h3 class="text-2xl font-bold text-slate-900"><%= number_with_delimiter(@today_pickups) %></h3>
        <span class="text-xs font-bold text-[#2e7d32] flex items-center gap-1">
          <span class="material-symbols-outlined text-sm">trending_up</span> 5%
        </span>
      </div>
    </div>

    <div class="bg-white p-5 rounded-xl border border-slate-100 shadow-sm">
      <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Active Agents</p>
      <div class="flex items-end justify-between">
        <h3 class="text-2xl font-bold text-slate-900"><%= number_with_delimiter(@total_agents) %></h3>
        <span class="text-xs font-bold text-slate-400">Stable</span>
      </div>
    </div>

    <div class="bg-white p-5 rounded-xl border border-slate-100 shadow-sm">
      <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Monthly Revenue</p>
      <div class="flex items-end justify-between">
        <h3 class="text-2xl font-bold text-slate-900"><%= number_to_currency(@monthly_revenue) %></h3>
        <span class="text-xs font-bold text-[#2e7d32] flex items-center gap-1">
          <span class="material-symbols-outlined text-sm">trending_up</span> 8%
        </span>
      </div>
    </div>

    <div class="bg-white p-5 rounded-xl border border-slate-100 shadow-sm">
      <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Total Waste</p>
      <div class="flex items-end justify-between">
        <h3 class="text-2xl font-bold text-slate-900"><%= number_with_delimiter(@total_waste_collected.to_f.round(1)) %> L</h3>
        <span class="text-xs font-bold text-[#2e7d32] flex items-center gap-1">
          <span class="material-symbols-outlined text-sm">trending_up</span> 15%
        </span>
      </div>
    </div>
  </div>

  <!-- Analytics Section -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Waste Volume Trends Chart -->
    <div class="lg:col-span-2 bg-white p-6 rounded-xl border border-slate-100 shadow-sm">
      <div class="flex items-center justify-between mb-6">
        <h4 class="text-lg font-bold text-slate-900">Waste Volume Trends</h4>
        <div class="flex gap-2">
          <div class="flex items-center gap-1.5 px-2 py-1 rounded-lg border border-slate-100 text-xs font-medium cursor-pointer hover:bg-slate-50 transition-colors">
            <span class="w-2 h-2 rounded-full bg-[#2e7d32]"></span> Recycling
          </div>
          <div class="flex items-center gap-1.5 px-2 py-1 rounded-lg border border-slate-100 text-xs font-medium cursor-pointer hover:bg-slate-50 transition-colors">
            <span class="w-2 h-2 rounded-full bg-[#81c784]"></span> Compost
          </div>
          <div class="flex items-center gap-1.5 px-2 py-1 rounded-lg border border-slate-100 text-xs font-medium cursor-pointer hover:bg-slate-50 transition-colors">
            <span class="w-2 h-2 rounded-full bg-slate-300"></span> Landfill
          </div>
        </div>
      </div>
      <!-- Visual Chart - stacked bar simulation matching design -->
      <div class="relative h-64 w-full flex items-end gap-4 px-4 pb-2 border-l border-b border-slate-100">
        <% days = %w[Mon Tue Wed Thu Fri Sat Sun] %>
        <% recycling_h = [50, 60, 45, 40, 50, 20, 15] %>
        <% compost_h = [25, 20, 35, 40, 30, 10, 10] %>
        <% landfill_h = [25, 10, 15, 20, 10, 10, 5] %>
        <% days.each_with_index do |day, i| %>
          <div class="flex-1 flex flex-col justify-end gap-1 group relative">
            <div class="w-full bg-slate-300 rounded-t-sm" style="height: <%= landfill_h[i] %>%" title="Landfill"></div>
            <div class="w-full bg-[#81c784]" style="height: <%= compost_h[i] %>%" title="Compost"></div>
            <div class="w-full bg-[#2e7d32] rounded-b-sm" style="height: <%= recycling_h[i] %>%" title="Recycling"></div>
            <span class="absolute -bottom-6 left-1/2 -translate-x-1/2 text-[10px] text-slate-400 font-medium"><%= day %></span>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Live Activity Feed -->
    <div class="bg-white p-6 rounded-xl border border-slate-100 shadow-sm">
      <div class="flex items-center justify-between mb-6">
        <h4 class="text-lg font-bold text-slate-900">Live Activity</h4>
        <span class="text-xs font-semibold text-[#2e7d32] bg-[#2e7d32]/10 px-2 py-0.5 rounded-full animate-pulse">Live</span>
      </div>
      <div class="space-y-6">
        <% @recent_pickups.first(5).each do |pickup| %>
          <div class="flex gap-4">
            <div class="relative">
              <div class="w-10 h-10 rounded-full bg-[#2e7d32]/10 flex items-center justify-center">
                <span class="text-sm font-bold text-[#2e7d32]"><%= pickup.agent&.name&.first&.upcase || "?" %></span>
              </div>
              <% if pickup.status == "completed" %>
                <span class="absolute bottom-0 right-0 w-3 h-3 bg-green-500 border-2 border-white rounded-full"></span>
              <% elsif pickup.status == "in_progress" %>
                <span class="absolute bottom-0 right-0 w-3 h-3 bg-blue-500 border-2 border-white rounded-full"></span>
              <% else %>
                <span class="absolute bottom-0 right-0 w-3 h-3 bg-yellow-500 border-2 border-white rounded-full"></span>
              <% end %>
            </div>
            <div class="flex-1">
              <p class="text-sm font-semibold text-slate-900"><%= pickup.agent&.name || "Unassigned" %></p>
              <p class="text-xs text-slate-500"><%= pickup.status&.humanize %> pickup #<%= pickup.id %> at <%= pickup.household&.address&.truncate(25) %></p>
              <span class="text-[10px] text-slate-400 mt-1 block"><%= time_ago_in_words(pickup.updated_at) %> ago</span>
            </div>
          </div>
        <% end %>
      </div>
      <%= link_to admin_pickups_path, class: "w-full mt-6 py-2 text-xs font-bold text-slate-500 hover:text-[#2e7d32] transition-colors border border-slate-100 rounded-lg block text-center" do %>
        View All Activity
      <% end %>
    </div>
  </div>

  <!-- Recent Agent Actions Table -->
  <section class="bg-white rounded-xl border border-slate-100 shadow-sm overflow-hidden">
    <div class="p-6 flex items-center justify-between border-b border-slate-100">
      <h4 class="text-lg font-bold text-slate-900">Recent Agent Actions</h4>
      <div class="flex gap-2">
        <button class="px-3 py-1.5 text-xs font-semibold bg-slate-50 text-slate-600 rounded-lg border border-slate-100">Filter</button>
        <button class="px-3 py-1.5 text-xs font-semibold bg-slate-50 text-slate-600 rounded-lg border border-slate-100">Export CSV</button>
      </div>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead class="bg-slate-50/50 text-[10px] uppercase tracking-wider text-slate-500 font-bold">
          <tr>
            <th class="px-6 py-4">Transaction ID</th>
            <th class="px-6 py-4">Agent Name</th>
            <th class="px-6 py-4">Household</th>
            <th class="px-6 py-4">Waste Category</th>
            <th class="px-6 py-4">Weight</th>
            <th class="px-6 py-4">Status</th>
            <th class="px-6 py-4">Time</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-sm">
          <% @recent_pickups.each do |pickup| %>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="px-6 py-4 text-slate-500">#TRX-<%= pickup.id %></td>
              <td class="px-6 py-4 font-medium text-slate-900"><%= pickup.agent&.name %></td>
              <td class="px-6 py-4 text-slate-600"><%= pickup.household&.address&.truncate(30) %></td>
              <td class="px-6 py-4">
                <% category = pickup.pickup_type&.humanize || "Regular" %>
                <% cat_colors = {
                  "Regular" => "bg-blue-100 text-blue-600",
                  "On demand" => "bg-orange-100 text-orange-600"
                } %>
                <span class="px-2 py-0.5 rounded-full text-xs font-medium <%= cat_colors[category] || 'bg-slate-100 text-slate-600' %>"><%= category %></span>
              </td>
              <td class="px-6 py-4 text-slate-600"><%= pickup.estimated_volume ? "#{pickup.estimated_volume} L" : "--" %></td>
              <td class="px-6 py-4">
                <% status_config = {
                  "completed" => { dot: "bg-green-500", text: "text-green-600", label: "Success" },
                  "pending" => { dot: "bg-yellow-500", text: "text-yellow-600", label: "Pending" },
                  "missed" => { dot: "bg-red-500", text: "text-red-600", label: "Missed" },
                  "in_progress" => { dot: "bg-blue-500", text: "text-blue-600", label: "In Progress" }
                } %>
                <% config = status_config[pickup.status] || { dot: "bg-gray-500", text: "text-gray-600", label: pickup.status&.humanize } %>
                <span class="flex items-center gap-1.5 text-xs font-bold <%= config[:text] %>">
                  <span class="w-1.5 h-1.5 rounded-full <%= config[:dot] %>"></span> <%= config[:label] %>
                </span>
              </td>
              <td class="px-6 py-4 text-slate-500"><%= pickup.created_at&.strftime("%I:%M %p") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</div>
