<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h2 class="text-2xl font-bold text-gray-900">Pickups</h2>
    <div class="flex items-center gap-3">
      <%= link_to "Schedule Route", new_admin_pickup_path, class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 transition-colors" %>
      <%= link_to "Batch Schedule", schedule_admin_pickups_path, class: "rounded-lg bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm ring-1 ring-gray-300 hover:bg-gray-50 transition-colors" %>
    </div>
  </div>

  <!-- Filters -->
  <div class="rounded-xl bg-white shadow ring-1 ring-gray-200 p-4">
    <%= form_with url: admin_pickups_path, method: :get, class: "flex flex-wrap items-end gap-4" do |f| %>
      <div>
        <%= f.label :date, "Date", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.date_field :date, value: params[:date], class: "block rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm" %>
      </div>
      <div>
        <%= f.label :status, "Status", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :status, [["All", ""], ["Pending", "pending"], ["In Progress", "in_progress"], ["Completed", "completed"], ["Missed", "missed"]], { selected: params[:status] }, class: "block rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm" %>
      </div>
      <div>
        <%= f.label :route_id, "Route", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :route_id, options_from_collection_for_select(@routes || Route.all, :id, :name, params[:route_id]), { prompt: "All Routes" }, class: "block rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm" %>
      </div>
      <div>
        <%= f.submit "Filter", class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer transition-colors" %>
        <%= link_to "Clear", admin_pickups_path, class: "ml-2 rounded-lg bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm ring-1 ring-gray-300 hover:bg-gray-50 transition-colors" %>
      </div>
    <% end %>
  </div>

  <div class="rounded-xl bg-white shadow ring-1 ring-gray-200 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">ID</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Household</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Agent</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Route</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Scheduled</th>
            <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @pickups.each do |pickup| %>
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">#<%= pickup.id %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700"><%= pickup.household&.address&.truncate(25) %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700"><%= pickup.agent&.name || "Unassigned" %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700"><%= pickup.route&.name || "N/A" %></td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% status_classes = { "completed" => "bg-green-100 text-green-800", "pending" => "bg-yellow-100 text-yellow-800", "missed" => "bg-red-100 text-red-800", "in_progress" => "bg-blue-100 text-blue-800" } %>
                <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= status_classes[pickup.status] || 'bg-gray-100 text-gray-800' %>">
                  <%= pickup.status&.humanize %>
                </span>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= pickup.created_at&.strftime("%b %d, %Y %I:%M %p") %></td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm">
                <%= link_to "View", admin_pickup_path(pickup), class: "text-indigo-600 hover:text-indigo-900 font-medium" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if defined?(@pagy) && @pagy %>
      <div class="border-t border-gray-200 px-6 py-4">
        <%== pagy_nav(@pagy) %>
      </div>
    <% end %>
  </div>
</div>
