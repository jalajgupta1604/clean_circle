<%# Landing Page - CleanCircle %>

<%# Hero Section %>
<section class="relative overflow-hidden bg-gradient-to-br from-emerald-600 via-emerald-700 to-emerald-900 text-white">
  <div class="absolute inset-0 opacity-10">
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="hero-pattern" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
          <circle cx="20" cy="20" r="2" fill="currentColor" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hero-pattern)" />
    </svg>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 sm:py-32 lg:py-40">
    <div class="text-center max-w-4xl mx-auto">
      <span class="inline-block px-4 py-1.5 mb-6 text-sm font-medium bg-emerald-500/30 border border-emerald-400/30 rounded-full backdrop-blur-sm">
        Serving 50+ communities across India
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight">
        Smart Waste Management
        <span class="block text-emerald-200 mt-2">for Indian Cities</span>
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-emerald-100 max-w-2xl mx-auto leading-relaxed">
        Reliable doorstep waste collection with transparent pricing, real-time tracking, and rewards for responsible waste management. Join the clean revolution.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <%= link_to new_user_registration_path, class: "w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-emerald-700 bg-white rounded-xl shadow-lg hover:bg-emerald-50 hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" do %>
          Get Started Free
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        <% end %>
        <a href="#pricing" class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-white border-2 border-emerald-400/50 rounded-xl hover:bg-emerald-600/50 backdrop-blur-sm transition-all duration-200">
          View Plans
        </a>
      </div>
    </div>
  </div>

  <div class="absolute bottom-0 left-0 right-0">
    <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0 120L60 105C120 90 240 60 360 52.5C480 45 600 60 720 67.5C840 75 960 75 1080 67.5C1200 60 1320 45 1380 37.5L1440 30V120H0Z" fill="white"/>
    </svg>
  </div>
</section>

<%# Features Section %>
<section class="py-20 sm:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">Why Choose CleanCircle?</h2>
      <p class="mt-4 text-lg text-gray-600">A smarter, fairer, and greener way to manage household waste</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      <%# Fair Pricing %>
      <div class="group relative bg-white border border-gray-100 rounded-2xl p-8 shadow-sm hover:shadow-xl hover:border-emerald-200 transition-all duration-300">
        <div class="w-14 h-14 flex items-center justify-center rounded-xl bg-emerald-100 text-emerald-600 mb-6 group-hover:bg-emerald-600 group-hover:text-white transition-colors duration-300">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-3">Fair Pricing</h3>
        <p class="text-gray-600 leading-relaxed">Pay only for what you throw. Volume-based billing means smaller households save more. No hidden charges.</p>
      </div>

      <%# Waste Tracking %>
      <div class="group relative bg-white border border-gray-100 rounded-2xl p-8 shadow-sm hover:shadow-xl hover:border-emerald-200 transition-all duration-300">
        <div class="w-14 h-14 flex items-center justify-center rounded-xl bg-emerald-100 text-emerald-600 mb-6 group-hover:bg-emerald-600 group-hover:text-white transition-colors duration-300">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-3">Waste Tracking</h3>
        <p class="text-gray-600 leading-relaxed">Monitor your waste generation over time with detailed charts and analytics. Track your environmental impact.</p>
      </div>

      <%# Digital Pickups %>
      <div class="group relative bg-white border border-gray-100 rounded-2xl p-8 shadow-sm hover:shadow-xl hover:border-emerald-200 transition-all duration-300">
        <div class="w-14 h-14 flex items-center justify-center rounded-xl bg-emerald-100 text-emerald-600 mb-6 group-hover:bg-emerald-600 group-hover:text-white transition-colors duration-300">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-3">Digital Pickups</h3>
        <p class="text-gray-600 leading-relaxed">QR code on your door. Agent scans, collects, and logs. Fully digital, fully transparent. No missed pickups.</p>
      </div>

      <%# Rewards %>
      <div class="group relative bg-white border border-gray-100 rounded-2xl p-8 shadow-sm hover:shadow-xl hover:border-emerald-200 transition-all duration-300">
        <div class="w-14 h-14 flex items-center justify-center rounded-xl bg-emerald-100 text-emerald-600 mb-6 group-hover:bg-emerald-600 group-hover:text-white transition-colors duration-300">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-3">Rewards</h3>
        <p class="text-gray-600 leading-relaxed">Earn green points for reducing waste and proper segregation. Redeem for wallet credits and exclusive discounts.</p>
      </div>
    </div>
  </div>
</section>

<%# How It Works %>
<section class="py-20 sm:py-28 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">How It Works</h2>
      <p class="mt-4 text-lg text-gray-600">Get started in three simple steps</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
      <div class="text-center">
        <div class="w-16 h-16 mx-auto flex items-center justify-center rounded-full bg-emerald-600 text-white text-2xl font-bold mb-6">1</div>
        <h3 class="text-xl font-bold text-gray-900 mb-3">Sign Up & Choose a Plan</h3>
        <p class="text-gray-600">Register your household, pick a waste bucket that fits your family size, and recharge your wallet.</p>
      </div>
      <div class="text-center">
        <div class="w-16 h-16 mx-auto flex items-center justify-center rounded-full bg-emerald-600 text-white text-2xl font-bold mb-6">2</div>
        <h3 class="text-xl font-bold text-gray-900 mb-3">Stick Your QR Code</h3>
        <p class="text-gray-600">Place the unique QR code near your door. Our agents scan it during every pickup for seamless tracking.</p>
      </div>
      <div class="text-center">
        <div class="w-16 h-16 mx-auto flex items-center justify-center rounded-full bg-emerald-600 text-white text-2xl font-bold mb-6">3</div>
        <h3 class="text-xl font-bold text-gray-900 mb-3">Track & Save</h3>
        <p class="text-gray-600">Monitor pickups in real-time, view waste analytics, and earn rewards for reducing your footprint.</p>
      </div>
    </div>
  </div>
</section>

